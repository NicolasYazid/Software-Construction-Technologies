<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:tns="http://schemas.datacontract.org/2004/07/GinRummy.Contracts.DataContracts.Friendship" elementFormDefault="qualified" targetNamespace="http://schemas.datacontract.org/2004/07/GinRummy.Contracts.DataContracts.Friendship" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:simpleType name="FriendRequestOutcome">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Sent" />
      <xs:enumeration value="PlayerNotFound" />
      <xs:enumeration value="SelfRequest" />
      <xs:enumeration value="AlreadyFriends" />
      <xs:enumeration value="RequestAlreadySent" />
      <xs:enumeration value="IncomingRequestExists" />
      <xs:enumeration value="AddresseeHasTooManyRequests" />
      <xs:enumeration value="SenderFriendLimitReached" />
      <xs:enumeration value="AddresseeFriendLimitReached" />
      <xs:enumeration value="TooManyRequestsPerMinute" />
      <xs:enumeration value="WaitingTimeNotOver" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="FriendRequestOutcome" nillable="true" type="tns:FriendRequestOutcome" />
  <xs:complexType name="FriendshipEvent">
    <xs:sequence>
      <xs:element minOccurs="0" name="EventType" type="tns:FriendshipEventType" />
      <xs:element minOccurs="0" name="FriendRequestId" type="xs:int" />
      <xs:element minOccurs="0" name="OtherPlayerPublicTag" type="xs:int" />
      <xs:element minOccurs="0" name="OtherPlayerUsername" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="SentAt" type="xs:dateTime" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="FriendshipEvent" nillable="true" type="tns:FriendshipEvent" />
  <xs:simpleType name="FriendshipEventType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="FriendRequestReceived" />
      <xs:enumeration value="FriendRequestAccepted" />
      <xs:enumeration value="FriendRequestDeclined" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="FriendshipEventType" nillable="true" type="tns:FriendshipEventType" />
</xs:schema>