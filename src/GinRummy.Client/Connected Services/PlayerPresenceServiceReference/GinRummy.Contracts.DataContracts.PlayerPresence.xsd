<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:tns="http://schemas.datacontract.org/2004/07/GinRummy.Contracts.DataContracts.PlayerPresence" elementFormDefault="qualified" targetNamespace="http://schemas.datacontract.org/2004/07/GinRummy.Contracts.DataContracts.PlayerPresence" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:complexType name="PlayerPresenceReport">
    <xs:sequence>
      <xs:element minOccurs="0" name="AllOfflineFriends" nillable="true" type="tns:ArrayOfPlayerPresence" />
      <xs:element minOccurs="0" name="AllOfflinePlayers" nillable="true" type="tns:ArrayOfPlayerPresence" />
      <xs:element minOccurs="0" name="AllOnlineFriends" nillable="true" type="tns:ArrayOfPlayerPresence" />
      <xs:element minOccurs="0" name="AllOnlinePlayers" nillable="true" type="tns:ArrayOfPlayerPresence" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="PlayerPresenceReport" nillable="true" type="tns:PlayerPresenceReport" />
  <xs:complexType name="ArrayOfPlayerPresence">
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="PlayerPresence" nillable="true" type="tns:PlayerPresence" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="ArrayOfPlayerPresence" nillable="true" type="tns:ArrayOfPlayerPresence" />
  <xs:complexType name="PlayerPresence">
    <xs:sequence>
      <xs:element minOccurs="0" name="GuestSessionId" nillable="true" type="xs:int" />
      <xs:element minOccurs="0" name="IsFriend" type="xs:boolean" />
      <xs:element minOccurs="0" name="IsGuest" type="xs:boolean" />
      <xs:element minOccurs="0" name="PublicTag" nillable="true" type="xs:int" />
      <xs:element minOccurs="0" name="RankName" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="Score" type="xs:int" />
      <xs:element minOccurs="0" name="Status" type="tns:PresenceStatus" />
      <xs:element minOccurs="0" name="Username" nillable="true" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="PlayerPresence" nillable="true" type="tns:PlayerPresence" />
  <xs:simpleType name="PresenceStatus">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Offline" />
      <xs:enumeration value="Online" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="PresenceStatus" nillable="true" type="tns:PresenceStatus" />
</xs:schema>