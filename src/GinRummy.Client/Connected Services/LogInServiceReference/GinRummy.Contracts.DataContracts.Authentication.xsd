<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:tns="http://schemas.datacontract.org/2004/07/GinRummy.Contracts.DataContracts.Authentication" elementFormDefault="qualified" targetNamespace="http://schemas.datacontract.org/2004/07/GinRummy.Contracts.DataContracts.Authentication" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:complexType name="LogInOutcome">
    <xs:sequence>
      <xs:element minOccurs="0" name="AccessToken" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="AccessTokenExpiresAt" nillable="true" type="xs:dateTime" />
      <xs:element minOccurs="0" name="IsChatFilterEnabled" type="xs:boolean" />
      <xs:element minOccurs="0" name="IsTwoFactorRequired" type="xs:boolean" />
      <xs:element minOccurs="0" name="LocaleCode" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="PlayerAccountId" type="xs:int" />
      <xs:element minOccurs="0" name="PublicTag" type="xs:int" />
      <xs:element minOccurs="0" name="SanctionExpiresAt" nillable="true" type="xs:dateTime" />
      <xs:element minOccurs="0" name="SanctionReasonName" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="Status" type="tns:LogInStatus" />
      <xs:element minOccurs="0" name="Username" nillable="true" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="LogInOutcome" nillable="true" type="tns:LogInOutcome" />
  <xs:simpleType name="LogInStatus">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Accepted" />
      <xs:enumeration value="RequiredField" />
      <xs:enumeration value="DisallowedCharacters" />
      <xs:enumeration value="InvalidCredentials" />
      <xs:enumeration value="EmailNotVerified" />
      <xs:enumeration value="AccountBanned" />
      <xs:enumeration value="ResendLimitReached" />
      <xs:enumeration value="CodeInvalidFormat" />
      <xs:enumeration value="CodeIncorrect" />
      <xs:enumeration value="CodeExpired" />
      <xs:enumeration value="CodeAlreadyUsed" />
      <xs:enumeration value="CodeTooManyAttempts" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="LogInStatus" nillable="true" type="tns:LogInStatus" />
</xs:schema>