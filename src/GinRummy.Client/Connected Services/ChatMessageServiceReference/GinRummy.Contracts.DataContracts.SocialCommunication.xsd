<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:tns="http://schemas.datacontract.org/2004/07/GinRummy.Contracts.DataContracts.SocialCommunication" xmlns:ser="http://schemas.microsoft.com/2003/10/Serialization/" elementFormDefault="qualified" targetNamespace="http://schemas.datacontract.org/2004/07/GinRummy.Contracts.DataContracts.SocialCommunication" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:import namespace="http://schemas.microsoft.com/2003/10/Serialization/" />
  <xs:complexType name="ArrayOfPlayerMessage">
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="PlayerMessage" nillable="true" type="tns:PlayerMessage" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="ArrayOfPlayerMessage" nillable="true" type="tns:ArrayOfPlayerMessage" />
  <xs:complexType name="PlayerMessage">
    <xs:sequence>
      <xs:element minOccurs="0" name="Content" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="Destination" type="tns:MessageDestination" />
      <xs:element minOccurs="0" name="MessageId" type="ser:guid" />
      <xs:element minOccurs="0" name="ProfilePicture" nillable="true" type="xs:string" />
