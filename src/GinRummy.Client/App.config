<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.serviceModel>
    <bindings>
      <netTcpBinding>
        <binding name="LeaderboardService">
          <security>
            <transport sslProtocols="None" />
          </security>
        </binding>
        <binding name="LogInService">
          <security>
            <transport sslProtocols="None" />
          </security>
        </binding>
        <binding name="AccountSettingsService">
          <security>
            <transport sslProtocols="None" />
          </security>
        </binding>
        <!-- The profile carries a picture of up to 2 MB, so its messages are allowed to be larger. -->
        <binding name="PlayerProfileService" maxBufferSize="2228224"
          maxReceivedMessageSize="2228224">
          <readerQuotas maxArrayLength="2097152" />
          <security>
            <transport sslProtocols="None" />
          </security>
        </binding>
        <binding name="PlayerPresenceService" closeTimeout="00:00:15"
          receiveTimeout="1.00:00:00" maxBufferSize="1048576" maxReceivedMessageSize="1048576">
          <reliableSession inactivityTimeout="00:01:00" enabled="true" />
          <security>
            <transport sslProtocols="None" />
          </security>
        </binding>
        <binding name="SignUpService">
          <security>
            <transport sslProtocols="None" />
          </security>
        </binding>
        <binding name="ChatMessageService" closeTimeout="00:00:15" receiveTimeout="1.00:00:00"
          maxBufferSize="1048576" maxReceivedMessageSize="1048576">
          <reliableSession ordered="true" inactivityTimeout="00:01:00"
            enabled="true" />
          <security>
            <transport sslProtocols="None" />
          </security>
        </binding>
        <binding name="DirectDuelService" closeTimeout="00:00:15" receiveTimeout="1.00:00:00">
          <reliableSession inactivityTimeout="00:01:00" enabled="true" />
          <security>
            <transport sslProtocols="None" />
          </security>
        </binding>
        <binding name="GameService" closeTimeout="00:00:15" receiveTimeout="1.00:00:00">
          <reliableSession inactivityTimeout="00:01:00" enabled="true" />
          <security>
            <transport sslProtocols="None" />
          </security>
        </binding>
      </netTcpBinding>
    </bindings>
    <client>
      <endpoint address="net.tcp://localhost:8000/LeaderboardService"
        binding="netTcpBinding" bindingConfiguration="LeaderboardService"
        contract="LeaderboardServiceReference.ILeaderboardService" name="LeaderboardService" />
      <endpoint address="net.tcp://localhost:8000/AccountSettingsService"
        binding="netTcpBinding" bindingConfiguration="AccountSettingsService"
        contract="AccountSettingsServiceReference.IAccountSettingsService"
        name="AccountSettingsService" />
      <endpoint address="net.tcp://localhost:8000/PlayerProfileService"
        binding="netTcpBinding" bindingConfiguration="PlayerProfileService"
        contract="PlayerProfileServiceReference.IPlayerProfileService"
        name="PlayerProfileService" />
      <endpoint address="net.tcp://localhost:8000/SignUpService" binding="netTcpBinding"
        bindingConfiguration="SignUpService" contract="SignUpServiceReference.ISignUpService"
        name="SignUpService" />
      <endpoint address="net.tcp://localhost:8000/ChatMessageService"
        binding="netTcpBinding" bindingConfiguration="ChatMessageService"
        contract="ChatMessageServiceReference.IChatMessageService" name="ChatMessageService" />
      <endpoint address="net.tcp://localhost:8000/PlayerPresenceService"
        binding="netTcpBinding" bindingConfiguration="PlayerPresenceService"
        contract="PlayerPresenceServiceReference.IPlayerPresenceService"
        name="PlayerPresenceService" />
      <endpoint address="net.tcp://localhost:8000/LogInService" binding="netTcpBinding"
        bindingConfiguration="LogInService" contract="LogInServiceReference.ILogInService"
        name="LogInService" />
      <endpoint address="net.tcp://localhost:8000/DirectDuelService"
        binding="netTcpBinding" bindingConfiguration="DirectDuelService"
        contract="DirectDuelServiceReference.IDirectDuelService" name="DirectDuelService" />
      <endpoint address="net.tcp://localhost:8000/GameService" binding="netTcpBinding"
        bindingConfiguration="GameService" contract="GameServiceReference.IGameService"
        name="GameService" />
    </client>
  </system.serviceModel>
</configuration>