<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.serviceModel>
    <bindings>
      <netTcpBinding>
        <binding name="NetTcpBinding_IRankingService">
          <security>
            <transport sslProtocols="None" />
          </security>
        </binding>
      </netTcpBinding>
    </bindings>
    <client>
      <endpoint address="net.tcp://localhost:8000/RankingsService"
        binding="netTcpBinding" bindingConfiguration="NetTcpBinding_IRankingService"
        contract="RankingsServiceReference.IRankingService" name="NetTcpBinding_IRankingService">
        <identity>
          <userPrincipalName value="FOSTER\neptu" />
        </identity>
      </endpoint>
    </client>
  </system.serviceModel>
</configuration>