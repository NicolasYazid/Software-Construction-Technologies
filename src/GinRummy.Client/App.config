<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.serviceModel>
    <bindings>
      <netTcpBinding>
        <binding name="LeaderboardService">
          <security>
            <transport sslProtocols="None" />
          </security>
        </binding>
        <binding name="LogInService">
          <security>
            <transport sslProtocols="None" />
          </security>
        </binding>
        <binding name="PlayerProfileService">
          <security>
            <transport sslProtocols="None" />
          </security>
        </binding>
        <binding name="PlayerPresenceService"
                 closeTimeout="00:00:15"
                 receiveTimeout="1.00:00:00"
                 maxBufferSize="1048576"
                 maxReceivedMessageSize="1048576">
          <reliableSession ordered="true" inactivityTimeout="00:01:00" enabled="true" />
          <security>
            <transport sslProtocols="None" />
          </security>
        </binding>
        <binding name="SignUpService">
          <security>
            <transport sslProtocols="None" />
          </security>
        </binding>
      </netTcpBinding>
    </bindings>
    <client>
      <endpoint address="net.tcp://localhost:8000/LeaderboardService"
        binding="netTcpBinding" bindingConfiguration="LeaderboardService"
        contract="LeaderboardServiceReference.ILeaderboardService" name="LeaderboardService">
        <identity>
          <userPrincipalName value="FOSTER\neptu" />
        </identity>
      </endpoint>
      <endpoint address="net.tcp://localhost:8002/LogInService" binding="netTcpBinding"
        bindingConfiguration="LogInService" contract="LogInServiceReference.ILogInService"
        name="LogInService">
        <identity>
          <userPrincipalName value="FOSTER\neptu" />
        </identity>
      </endpoint>
      <endpoint address="net.tcp://localhost:8008/PlayerProfileService" binding="netTcpBinding"
        bindingConfiguration="PlayerProfileService" contract="PlayerProfileServiceReference.IPlayerProfileService"
        name="PlayerProfileService">
        <identity>
          <userPrincipalName value="FOSTER\neptu" />
        </identity>
      </endpoint>
      <endpoint address="net.tcp://localhost:8004/PlayerPresenceService"
        binding="netTcpBinding" bindingConfiguration="PlayerPresenceService"
        contract="PlayerPresenceServiceReference.IPlayerPresenceService"
        name="PlayerPresenceService">
        <identity>
          <userPrincipalName value="LAPTOP-JTEM4PAQ\yazid" />
        </identity>
      </endpoint>
      <endpoint address="net.tcp://localhost:8006/SignUpService" binding="netTcpBinding"
        bindingConfiguration="SignUpService" contract="SignUpServiceReference.ISignUpService"
        name="SignUpService">
        <identity>
          <userPrincipalName value="FOSTER\neptu" />
        </identity>
      </endpoint>
    </client>
  </system.serviceModel>
</configuration>