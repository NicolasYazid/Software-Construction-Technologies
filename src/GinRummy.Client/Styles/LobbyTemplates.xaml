<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="clr-namespace:GinRummy.Client.Models"
                    xmlns:vm="clr-namespace:GinRummy.Client.ViewModels">

    <!-- These templates live apart from the theme because they bind to the localization provider, created after the theme loads. -->

    <DataTemplate x:Key="TplLobbyPlayer" DataType="{x:Type vm:LobbyPlayerViewModel}">
        <Border Style="{StaticResource StyPlayerRow}">
            <DockPanel LastChildFill="True">
                <Label DockPanel.Dock="Right" Style="{StaticResource StyRankBadge}" Content="{Binding RankName}" />
                <Border Style="{StaticResource StyAvatar}">
                    <Image Style="{StaticResource StyAvatarIcon}" />
                </Border>
                <TextBlock Style="{StaticResource StyPlayerName}" Text="{Binding Username}" />
            </DockPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="TplVersusPlayer" DataType="{x:Type vm:LobbyPlayerViewModel}">
        <StackPanel Orientation="Horizontal">
            <Border Style="{StaticResource StyAvatarSmall}">
                <Image Style="{StaticResource StyAvatarIconSmall}" />
            </Border>
            <TextBlock Style="{StaticResource StyVersusName}" Text="{Binding Username}" />
            <Label Style="{StaticResource StyRankBadgeSmall}" Content="{Binding RankName}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="TplMatchPair" DataType="{x:Type models:MatchPair}">
        <Border Style="{StaticResource StyVersusRow}">
            <StackPanel Orientation="Horizontal">
                <ContentPresenter Content="{Binding FirstPlayer}" ContentTemplate="{StaticResource TplVersusPlayer}" />
                <TextBlock x:Name="lblVersus" Style="{StaticResource StyVersusLabel}"
                           Text="{Binding [LobbyChat_LblVersus], Source={StaticResource PrvLocalization}}" />
                <ContentPresenter Content="{Binding SecondPlayer}" ContentTemplate="{StaticResource TplVersusPlayer}" />
            </StackPanel>
        </Border>
    </DataTemplate>

</ResourceDictionary>
