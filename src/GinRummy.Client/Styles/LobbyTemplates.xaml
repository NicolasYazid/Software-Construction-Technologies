<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="clr-namespace:GinRummy.Client.Models"
                    xmlns:vm="clr-namespace:GinRummy.Client.ViewModels">

    <!-- Templates shared by the lobby of a player (P11) and the one of a guest (P16). They live
         apart from the theme because they bind to the localization provider, which the
         application publishes when it starts, after the theme has been loaded; each lobby
         merges them into its own resources, and by then the provider exists. -->

    <!-- The messages sit further in than the cards that float over them, so an avatar passing
         under a card never shows through the stepped corners of the card. -->
    <DataTemplate DataType="{x:Type models:ChatMessage}">
        <Grid Margin="30,8,30,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource StyAvatar}" VerticalAlignment="Top">
                <Image Style="{StaticResource StyAvatarIcon}" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,2,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource StyChatAuthor}" Text="{Binding AuthorName}" />
                    <TextBlock Style="{StaticResource StyChatTime}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource CnvLocalizedFormat}" ConverterParameter="t">
                                <Binding Path="[Shared_Timestamp]" Source="{StaticResource PrvLocalization}" />
                                <Binding Path="SentAt" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
                <TextBlock x:Name="lblChatContent" Style="{StaticResource StyChatContent}" Text="{Binding Content}" />
                <TextBlock x:Name="lblMessageCensored" Style="{StaticResource StyChatCensored}"
                           Text="{Binding [LobbyChat_MessageCensored], Source={StaticResource PrvLocalization}}" />
            </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsCensored}" Value="True">
                <Setter TargetName="lblChatContent" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="lblMessageCensored" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="TplLobbyPlayer" DataType="{x:Type vm:LobbyPlayerViewModel}">
        <Border Style="{StaticResource StyPlayerRow}">
            <DockPanel LastChildFill="True">
                <Label DockPanel.Dock="Right" Style="{StaticResource StyRankBadge}" Content="{Binding RankName}" />
                <Border Style="{StaticResource StyAvatar}">
                    <Image Style="{StaticResource StyAvatarIcon}" />
                </Border>
                <TextBlock Style="{StaticResource StyPlayerName}" Text="{Binding Username}" />
            </DockPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="TplVersusPlayer" DataType="{x:Type vm:LobbyPlayerViewModel}">
        <StackPanel Orientation="Horizontal">
            <Border Style="{StaticResource StyAvatarSmall}">
                <Image Style="{StaticResource StyAvatarIconSmall}" />
            </Border>
            <TextBlock Style="{StaticResource StyVersusName}" Text="{Binding Username}" />
            <Label Style="{StaticResource StyRankBadgeSmall}" Content="{Binding RankName}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="TplMatchPair" DataType="{x:Type models:MatchPair}">
        <Border Style="{StaticResource StyVersusRow}">
            <StackPanel Orientation="Horizontal">
                <ContentPresenter Content="{Binding FirstPlayer}" ContentTemplate="{StaticResource TplVersusPlayer}" />
                <TextBlock x:Name="lblVersus" Style="{StaticResource StyVersusLabel}"
                           Text="{Binding [LobbyChat_LblVersus], Source={StaticResource PrvLocalization}}" />
                <ContentPresenter Content="{Binding SecondPlayer}" ContentTemplate="{StaticResource TplVersusPlayer}" />
            </StackPanel>
        </Border>
    </DataTemplate>

</ResourceDictionary>
