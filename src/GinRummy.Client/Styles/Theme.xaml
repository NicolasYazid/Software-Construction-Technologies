    <Style x:Key="StyPanelEmpty" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="LineHeight" Value="26" />
        <Setter Property="Foreground" Value="{StaticResource BrsMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="6,16,6,8" />
    </Style>

    <!-- The context menu of a player takes the sunk face of the fields and lights the item
         under the pointer with the colour of what is chosen. The system menu draws a light
         chrome of its own, hence the templates. -->
    <Style x:Key="StyPlayerMenuItem" TargetType="MenuItem">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource BrsBody}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="14,8,22,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal">
                            <ContentPresenter ContentSource="Icon" Width="16" Height="16"
                                              Margin="0,0,12,0" VerticalAlignment="Center" />
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{StaticResource BrsHighlight}" />
                <Setter Property="Foreground" Value="{StaticResource BrsMenuLight}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Only a friend can be removed, and only someone who is not a friend yet can receive a
         request (CU-12, CU-16), so each of those items shows for one kind of player alone. -->
    <Style x:Key="StyPlayerMenuFriendItem" TargetType="MenuItem" BasedOn="{StaticResource StyPlayerMenuItem}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsFriend}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Once the request is sent, the option stays in its place as the mark of a pending
         request: dimmed, with the icon of a sent message, and unable to send a second one
         (CU-12 and its EX-07). -->
    <Style x:Key="StyPlayerMenuStrangerItem" TargetType="MenuItem" BasedOn="{StaticResource StyPlayerMenuItem}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsFriend}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HasPendingRequest}" Value="True">
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="Foreground" Value="{StaticResource BrsMuted}" />
                <Setter Property="Cursor" Value="Arrow" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StyPendingRequestMark" TargetType="Image">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Opacity" Value="0.6" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasPendingRequest}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StyPlayerMenu" TargetType="ContextMenu">
        <Setter Property="ItemContainerStyle" Value="{StaticResource StyPlayerMenuItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{StaticResource BrsFieldFace}" BorderBrush="{StaticResource BrsMenuInk}"
                            BorderThickness="0,0,0,4" Padding="0,6,0,6" MinWidth="230">
                        <StackPanel IsItemsHost="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The bar of the system draws its light chrome over every dark panel, so the lists
         carry a thin one in the colours of the menu. The thumb takes a grey green that stays
         quiet beside the content. PART_Track is the name the framework requires to find the
         track, not a naming choice. -->
    <SolidColorBrush x:Key="BrsScrollThumb" Color="#FF3D433B" />

    <Style x:Key="StyScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{StaticResource BrsScrollThumb}"
                            ctl:PixelShapeCommon.PixelUnit="2" ctl:PixelShapeCommon.CornerSteps="1" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{StaticResource BrsMenuInk}"
                            ctl:PixelShapeCommon.PixelUnit="2" ctl:PixelShapeCommon.CornerSteps="1">
                        <Track x:Name="PART_Track" IsDirectionReversed="True"
                               Orientation="{TemplateBinding Orientation}">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource StyScrollThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="8" />
                <Setter Property="MinHeight" Value="8" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StyPanelTitle" TargetType="TextBlock" BasedOn="{StaticResource StyDialogTitle}">
        <Setter Property="TextAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StyDialogCloseButton" TargetType="Button" BasedOn="{StaticResource StyIconButton}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
    </Style>

    <Style x:Key="StyRequestRow" TargetType="Border">
        <Setter Property="Padding" Value="0,12,0,12" />
        <Setter Property="BorderBrush" Value="{StaticResource BrsLobbyRule}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style x:Key="StyRequestText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource BrsBody}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="14,0,14,0" />
    </Style>

    <Style x:Key="StySanctionCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrsFieldFace}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrsMenuInk}" />
        <Setter Property="BorderThickness" Value="0,0,0,4" />
        <Setter Property="ctl:PixelShapeCommon.CornerSteps" Value="4" />
        <Setter Property="Padding" Value="20,14,20,16" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <Style x:Key="StySanctionBadge" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource BrsDanger}" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style x:Key="StySanctionBadgeServed" TargetType="TextBlock" BasedOn="{StaticResource StySanctionBadge}">
        <Setter Property="Foreground" Value="{StaticResource BrsMuted}" />
    </Style>

    <Style x:Key="StySanctionReason" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource BrsBody}" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <Style x:Key="StySanctionDetail" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource BrsTitle}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style x:Key="StyReportedPlayer" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource BrsBody}" />
    </Style>

    <!-- The reasons of a report are exclusive options: a disc ringed with the colour of the
         muted text, since a sunk edge alone vanished over the dark card, that fills with the
         light of the menu when it is chosen. -->
    <Style x:Key="StyReasonRadio" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource BrsBody}" />
        <Setter Property="Background" Value="{StaticResource BrsFieldFace}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border Width="22" Height="22" Padding="2" VerticalAlignment="Center"
                                Background="{StaticResource BrsCheckBorder}"
                                ctl:PixelShapeCommon.PixelUnit="2" ctl:PixelShapeCommon.CornerSteps="4">
                            <Border Background="{TemplateBinding Background}"
                                    ctl:PixelShapeCommon.PixelUnit="2" ctl:PixelShapeCommon.CornerSteps="3">
                                <Border Width="10" Height="10" Background="{StaticResource BrsMenuLight}"
                                        ctl:PixelShapeCommon.PixelUnit="2" ctl:PixelShapeCommon.CornerSteps="1"
                                        Visibility="{TemplateBinding IsChecked,
                                                     Converter={StaticResource CnvBooleanToVisibility}}" />
                            </Border>
                        </Border>
                        <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource BrsTitle}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource BrsHighlight}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StyFieldArea" TargetType="Border" BasedOn="{StaticResource StyFieldShell}">
        <Setter Property="Height" Value="120" />
        <Setter Property="Padding" Value="16,12,16,12" />
    </Style>

    <!-- The area of the dialogs of the room takes the brown of the fields of the lobby. -->
    <Style x:Key="StyLobbyFieldArea" TargetType="Border" BasedOn="{StaticResource StyFieldArea}">
        <Setter Property="Background" Value="{StaticResource BrsLobbyFieldFace}" />
    </Style>

    <!-- Fields laid straight over the paint of a dialog take the brown of the fields as glass,
         so the room shows through them as it does through the cards around them. -->
    <SolidColorBrush x:Key="BrsLobbyFieldGlass" Color="#B3231B14" />

    <Style x:Key="StyGlassFieldShell" TargetType="Border" BasedOn="{StaticResource StyLobbyFieldShell}">
        <Setter Property="Background" Value="{StaticResource BrsLobbyFieldGlass}" />
    </Style>

    <Style x:Key="StyGlassFieldArea" TargetType="Border" BasedOn="{StaticResource StyLobbyFieldArea}">
        <Setter Property="Background" Value="{StaticResource BrsLobbyFieldGlass}" />
    </Style>

    <Style x:Key="StyFieldAreaInput" TargetType="TextBox" BasedOn="{StaticResource StyFieldInput}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style x:Key="StyFieldAreaPlaceholder" TargetType="TextBlock" BasedOn="{StaticResource StyFieldPlaceholder}">
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!-- ================= Profile screens (P14, P15, P21) ================= -->

    <!-- The change of email opens over the panel and not in a window of its own, because the
         dictionary places its texts in the panel. The veil keeps the panel in sight while it
         is open. -->
    <SolidColorBrush x:Key="BrsOverlay" Color="#D90A0907" />
    <!-- Shade laid over a main screen while one of its modals is open: the screen stays in
         sight behind the modal but reads as out of reach. -->
    <SolidColorBrush x:Key="BrsModalBackdrop" Color="#A60A0907" />

    <Style x:Key="StySettingSection" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource BrsMuted}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="StySettingValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource BrsBody}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="StySettingDivider" TargetType="Border">
        <Setter Property="Height" Value="2" />
        <Setter Property="Background" Value="{StaticResource BrsLobbyRule}" />
        <Setter Property="Margin" Value="0,22,0,22" />
    </Style>

    <!-- The cards of the profiles and of the leaderboard are the glass cards of the lobby, since
         those dialogs open over it and are drawn as one more of its panels. -->
    <Style x:Key="StySettingCard" TargetType="Border" BasedOn="{StaticResource StyLobbyGlassCard}">
        <Setter Property="Padding" Value="18,14,16,16" />
    </Style>

    <Style x:Key="StySettingTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource BrsTitle}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="StySettingHint" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource BrsMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <!-- The switches take the colour of what is chosen when they are on and the one of the
         neutral buttons when they are off. The knob moves by a style of its own that
         reads the state of the switch, so no part of the template needs a name. -->
    <Style x:Key="StyToggleSwitch" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="{StaticResource BrsMenuNeutral}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <ctl:CtlPixelBorder Background="{TemplateBinding Background}" ctl:PixelShapeCommon.CornerSteps="4"
                            BorderBrush="{StaticResource BrsMenuInk}" BorderThickness="0,0,0,3">
                        <Border Width="20" Height="20" Margin="5,0,5,0" Background="{StaticResource BrsMenuLight}"
                                ctl:PixelShapeCommon.CornerSteps="2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked,
                                                               RelativeSource={RelativeSource TemplatedParent}}"
                                                     Value="True">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </ctl:CtlPixelBorder>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource BrsHighlight}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The slider shows the part already chosen in the colour of what is chosen, over a
         sunk track. PART_Track is the name the framework requires to find the track. -->
    <Style x:Key="StySliderFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="8" ctl:PixelShapeCommon.PixelUnit="2" ctl:PixelShapeCommon.CornerSteps="1"
                            Background="{StaticResource BrsHighlight}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StySliderRest" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StySliderThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Width="22" Height="22" Padding="3" Background="{StaticResource BrsMenuInk}"
                            ctl:PixelShapeCommon.PixelUnit="2" ctl:PixelShapeCommon.CornerSteps="4">
                        <Border Background="{StaticResource BrsMenuLight}"
                                ctl:PixelShapeCommon.PixelUnit="2" ctl:PixelShapeCommon.CornerSteps="3" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StyVolumeSlider" TargetType="Slider">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <ctl:CtlPixelBorder Height="8" ctl:PixelShapeCommon.PixelUnit="2" ctl:PixelShapeCommon.CornerSteps="1"
                                Background="{StaticResource BrsLobbyFieldFace}"
                                BorderBrush="{StaticResource BrsMenuInk}" BorderThickness="0,0,0,2" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource StySliderFill}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource StySliderRest}" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource StySliderThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StyCenteredTextButton" TargetType="Button" BasedOn="{StaticResource StyInlineTextButton}">
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StyAvatarProfile" TargetType="Border" BasedOn="{StaticResource StyAvatar}">
        <Setter Property="Width" Value="112" />
        <Setter Property="Height" Value="112" />
        <Setter Property="CornerRadius" Value="56" />
        <Setter Property="BorderThickness" Value="3" />
    </Style>

    <Style x:Key="StyAvatarIconProfile" TargetType="Image" BasedOn="{StaticResource StyAvatarIcon}">
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="52" />
    </Style>

    <Style x:Key="StySocialLinkRow" TargetType="Border" BasedOn="{StaticResource StyGlassFieldShell}">
        <Setter Property="Height" Value="46" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="StySocialPlatform" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource BrsTitle}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,12,0" />
    </Style>

    <Style x:Key="StySocialUrl" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource BrsBody}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="StyRowTextButton" TargetType="Button" BasedOn="{StaticResource StyCardTextButton}">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource BrsBody}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="12,0,0,0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource BrsTitle}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The public profile (P21) states the name and the numbers of the player at the size
         of the titles, as the prototype does, and leaves the rest at the size of the body. -->
    <Style x:Key="StyProfileName" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="48" />
        <Setter Property="Foreground" Value="{StaticResource BrsTitle}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StyProfileTag" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Foreground" Value="{StaticResource BrsMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StyProfileSectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Foreground" Value="{StaticResource BrsTitle}" />
        <Setter Property="Margin" Value="0,22,0,8" />
    </Style>

    <Style x:Key="StyProfileText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Foreground" Value="{StaticResource BrsBody}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="StySocialChip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrsMenuNeutral}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrsMenuInk}" />
        <Setter Property="BorderThickness" Value="0,0,0,3" />
        <Setter Property="ctl:PixelShapeCommon.CornerSteps" Value="3" />
        <Setter Property="Padding" Value="14,8,14,8" />
        <Setter Property="Margin" Value="0,0,10,0" />
    </Style>

    <Style x:Key="StySocialChipText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource BrsMenuLight}" />
    </Style>

    <Style x:Key="StyStatCard" TargetType="Border" BasedOn="{StaticResource StySettingCard}">
        <Setter Property="Padding" Value="22,16,22,18" />
    </Style>

    <Style x:Key="StyStatLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Foreground" Value="{StaticResource BrsMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="StyStatValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="48" />
        <Setter Property="Foreground" Value="{StaticResource BrsTitle}" />
        <Setter Property="Margin" Value="0,10,0,0" />
    </Style>

    <Style x:Key="StyPresenceDotInline" TargetType="Ellipse" BasedOn="{StaticResource StyPresenceDot}">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============= Leaderboard and house rules (P18, P19) ============= -->

    <!-- The places of the podium are glass cards, the same device as the performance of the
         profile. The first one takes the brown glass of the notices of the lobby, so that it
         stands out with a colour the room already has, and carries the crown instead of its
         number. -->
    <Style x:Key="StyPodiumCard" TargetType="Border" BasedOn="{StaticResource StySettingCard}">
        <Setter Property="Padding" Value="18,14,18,16" />
        <Setter Property="Margin" Value="6,0,6,0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Position}" Value="1">
                <Setter Property="Background" Value="{StaticResource BrsChatNoticeFace}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StyPodiumName" TargetType="TextBlock" BasedOn="{StaticResource StyPlayerName}">
        <Setter Property="Foreground" Value="{StaticResource BrsTitle}" />
    </Style>

    <!-- The second and the third place state their number at the size of the crown of the
         first and in its same light, so the three marks of the podium weigh the same. The size
         is twice the grid of the pixel font, which keeps every pixel of the number whole. -->
    <Style x:Key="StyPodiumPosition" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="Foreground" Value="{StaticResource BrsMenuLight}" />
        <Setter Property="Effect" Value="{StaticResource EfxTextRaiseSmall}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Position}" Value="1">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StyPodiumCrown" TargetType="Image">
        <Setter Property="Source" Value="{StaticResource IcoCrown}" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Position}" Value="1">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StyPodiumStat" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource BrsBody}" />
        <Setter Property="Margin" Value="0,0,16,0" />
    </Style>

    <Style x:Key="StyPodiumStatMuted" TargetType="TextBlock" BasedOn="{StaticResource StyPodiumStat}">
        <Setter Property="Foreground" Value="{StaticResource BrsMuted}" />
    </Style>

    <!-- The table is a glass card of the lobby, the same piece that holds the rules of the chat. -->
    <Style x:Key="StyRankingTable" TargetType="Border" BasedOn="{StaticResource StyLobbyGlassCard}" />

    <Style x:Key="StyRankingHead" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource BrsMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StyRankingHeadNumber" TargetType="TextBlock" BasedOn="{StaticResource StyRankingHead}">
        <Setter Property="TextAlignment" Value="Right" />
    </Style>

    <!-- The row of the player takes the colour of what is the own of the player (CU-19 step
         6). The numbers of a row carry no colour of their own and inherit the one the row sets,
         so the highlight reaches them without naming any of them. -->
    <Style x:Key="StyRankingRow" TargetType="Border" BasedOn="{StaticResource StyPlayerRow}">
        <Setter Property="Padding" Value="20,8,20,8" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource BrsBody}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsOwnEntry}" Value="True">
                <Setter Property="Background" Value="{StaticResource BrsHighlightGlass}" />
                <Setter Property="TextElement.Foreground" Value="{StaticResource BrsMenuLight}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StyRankingPosition" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource BrsMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsOwnEntry}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource BrsMenuLight}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StyRankingName" TargetType="TextBlock" BasedOn="{StaticResource StyPlayerName}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsOwnEntry}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource BrsMenuLight}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StyRankingYou" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource BrsMenuLight}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsOwnEntry}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StyRankingCell" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The disc keeps the colour of its rank on the highlighted row too: that colour is never
         the one of the row, so it no longer needs a colour of its own there. -->
    <Style x:Key="StyRankingBadge" TargetType="Label" BasedOn="{StaticResource StyRankBadge}">
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style x:Key="StyRulesCardHead" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource BrsMuted}" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <!-- The warning of fair play takes the red of the warnings of the menu, the same one a
         declined challenge carries in the chat. -->
    <Style x:Key="StyFairPlayBar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrsMenuWarn}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrsMenuInk}" />
        <Setter Property="BorderThickness" Value="0,0,0,4" />
        <Setter Property="ctl:PixelShapeCommon.CornerSteps" Value="4" />
        <Setter Property="Padding" Value="22,12,22,14" />
    </Style>

    <Style x:Key="StyFairPlayText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource BrsMenuLight}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- The rules are a flow document because its list draws the numerals itself: they are
         not strings of the dictionary, and a text that wrote them would have to be
         translated. The viewer shows no toolbar and no selection, only the scroll. -->
    <Style x:Key="StyRulesViewer" TargetType="FlowDocumentScrollViewer">
        <Setter Property="IsToolBarVisible" Value="False" />
        <Setter Property="IsSelectionEnabled" Value="False" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="StyRulesDocument" TargetType="FlowDocument">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource BrsBody}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="TextAlignment" Value="Left" />
        <Setter Property="PagePadding" Value="0,0,18,0" />
    </Style>

    <!-- The numerals take the font and the colour of the list, and the text the ones of its
         paragraph, which is how the prototype sets the number apart from the rule. -->
    <Style x:Key="StyRulesList" TargetType="List">
        <Setter Property="MarkerStyle" Value="Decimal" />
        <Setter Property="MarkerOffset" Value="14" />
        <Setter Property="Padding" Value="44,0,0,0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource BrsMuted}" />
    </Style>

    <Style x:Key="StyRuleText" TargetType="Paragraph">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="LineHeight" Value="26" />
        <Setter Property="Foreground" Value="{StaticResource BrsBody}" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="StyGlossaryTitle" TargetType="Paragraph">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource BrsTitle}" />
        <Setter Property="Margin" Value="0,20,0,12" />
    </Style>

    <!-- Each term sits over its definition: the terms differ too much in length to share a
         column with them. -->
    <Style x:Key="StyGlossaryTerm" TargetType="Paragraph">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Foreground" Value="{StaticResource BrsMuted}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="StyGlossaryDefinition" TargetType="Paragraph" BasedOn="{StaticResource StyRuleText}">
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <!-- ======================== Game table (P20) ======================== -->

    <!-- The table keeps the room of the lobby: the chat and the side panel are its panels, and
         the cards lie on a translucent cloth raised like the panels, so the paint of the room
         shows through it. The faces of the cards take the
         light of the menu so that they stand out on the green, with the ink of the menu for
         the black suits and a darker red for the red ones. -->
    <SolidColorBrush x:Key="BrsCardInkBlack" Color="#FF1A1712" />
    <SolidColorBrush x:Key="BrsCardInkRed" Color="#FFA33A2A" />
    <SolidColorBrush x:Key="BrsTableSurface" Color="#801A1712" />

    <!-- The back of a card is a sprite of the spiral of the backgrounds, still and in the reds
         of the buttons. Every card shrinks the same sprite, so the small ones show the whole
         spiral with smaller blocks instead of a few large ones. -->
    <ImageBrush x:Key="BrsCardBack" ImageSource="{x:Static ctl:CardBackCommon.Sprite}" Stretch="UniformToFill" />

    <Style x:Key="StyCardFace" TargetType="Border">
        <Setter Property="Width" Value="62" />
        <Setter Property="Height" Value="92" />
        <Setter Property="Background" Value="{StaticResource BrsMenuLight}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrsMenuInk}" />
        <Setter Property="BorderThickness" Value="1,1,1,3" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Effect" Value="{StaticResource EfxCardShadow}" />
    </Style>

    <Style x:Key="StyCardFaceLarge" TargetType="Border" BasedOn="{StaticResource StyCardFace}">
        <Setter Property="Width" Value="92" />
        <Setter Property="Height" Value="130" />
    </Style>

    <Style x:Key="StyCardFaceMini" TargetType="Border" BasedOn="{StaticResource StyCardFace}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Margin" Value="0,0,4,0" />
    </Style>

    <Style x:Key="StyCardBack" TargetType="Border">
        <Setter Property="Width" Value="51" />
        <Setter Property="Height" Value="78" />
        <Setter Property="Margin" Value="2,0,2,0" />
        <Setter Property="Background" Value="{StaticResource BrsCardBack}" />
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
        <Setter Property="BorderBrush" Value="{StaticResource BrsMenuInk}" />
        <Setter Property="BorderThickness" Value="1,1,1,3" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Effect" Value="{StaticResource EfxCardShadow}" />
    </Style>

    <Style x:Key="StyCardBackLarge" TargetType="Border" BasedOn="{StaticResource StyCardBack}">
        <Setter Property="Width" Value="92" />
        <Setter Property="Height" Value="130" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <!-- The place of the discard pile stays drawn when the pile is empty, so that the table
         does not change its shape when the card is taken. -->
    <Style x:Key="StyCardSlot" TargetType="Rectangle">
        <Setter Property="Width" Value="92" />
        <Setter Property="Height" Value="130" />
        <Setter Property="Stroke" Value="{StaticResource BrsLobbyRule}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeDashArray" Value="3 2" />
        <Setter Property="RadiusX" Value="4" />
        <Setter Property="RadiusY" Value="4" />
    </Style>

    <!-- The rank takes the colour of its suit, as on a printed card. -->
    <Style x:Key="StyCardRank" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Foreground" Value="{StaticResource BrsCardInkBlack}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="5,3,0,0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Suit}" Value="Diamonds">
                <Setter Property="Foreground" Value="{StaticResource BrsCardInkRed}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Suit}" Value="Hearts">
                <Setter Property="Foreground" Value="{StaticResource BrsCardInkRed}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StyCardRankLarge" TargetType="TextBlock" BasedOn="{StaticResource StyCardRank}">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Margin" Value="8,5,0,0" />
    </Style>

    <Style x:Key="StyCardRankMini" TargetType="TextBlock" BasedOn="{StaticResource StyCardRank}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Margin" Value="4,2,0,0" />
    </Style>

    <!-- The opposite corner repeats the rank upside down, as a printed card does. -->
    <Style x:Key="StyCardRankTurned" TargetType="TextBlock" BasedOn="{StaticResource StyCardRank}">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="0,0,5,5" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <RotateTransform Angle="180" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StyCardRankTurnedLarge" TargetType="TextBlock" BasedOn="{StaticResource StyCardRankTurned}">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Margin" Value="0,0,8,7" />
    </Style>

    <!-- The picture of the suit follows the suit of the card. The sizes are halves and doubles
         of the grid of twenty-four the symbols are drawn on, which keeps their blocks square. -->
    <Style x:Key="StyCardSuit" TargetType="Image">
        <Setter Property="Source" Value="{StaticResource IcoSuitSpades}" />
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="6,25,0,0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Suit}" Value="Clubs">
                <Setter Property="Source" Value="{StaticResource IcoSuitClubs}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Suit}" Value="Diamonds">
                <Setter Property="Source" Value="{StaticResource IcoSuitDiamonds}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Suit}" Value="Hearts">
                <Setter Property="Source" Value="{StaticResource IcoSuitHearts}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StyCardSuitLarge" TargetType="Image" BasedOn="{StaticResource StyCardSuit}">
        <Setter Property="Margin" Value="10,36,0,0" />
    </Style>

    <Style x:Key="StyCardSuitMini" TargetType="Image" BasedOn="{StaticResource StyCardSuit}">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="0,0,5,6" />
    </Style>

    <Style x:Key="StyCardSuitCenter" TargetType="Image" BasedOn="{StaticResource StyCardSuit}">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <Style x:Key="StyCardSuitCenterLarge" TargetType="Image" BasedOn="{StaticResource StyCardSuitCenter}">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
    </Style>

    <!-- A card of the hand rises when it is chosen, as a real card does when it is lifted from
         the fan. -->
    <Style x:Key="StyHandCard" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="1,0,1,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <TranslateTransform Y="-14" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The hand is a single row with no chrome. The room above the cards is the height a
         chosen card rises, so that it never leaves the list. -->
    <Style x:Key="StyHandList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource StyHandCard}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}" Padding="0,16,0,0">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StyTableSurface" TargetType="Rectangle">
        <Setter Property="Fill" Value="{StaticResource BrsTableSurface}" />
        <Setter Property="Stroke" Value="{StaticResource BrsLobbyRule}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeDashArray" Value="4 3" />
        <Setter Property="RadiusX" Value="96" />
        <Setter Property="RadiusY" Value="96" />
        <Setter Property="Effect" Value="{StaticResource EfxPanelShadow}" />
    </Style>

    <Style x:Key="StyTableCaption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource BrsTitle}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Effect" Value="{StaticResource EfxSoftShadow}" />
    </Style>

    <Style x:Key="StyTablePill" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource BrsMuted}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="10,3,10,4" />
        <Setter Property="Margin" Value="12,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Effect" Value="{StaticResource EfxSoftShadow}" />
    </Style>

    <Style x:Key="StyTablePillText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource BrsBody}" />
    </Style>

    <Style x:Key="StyTableNote" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource BrsTitle}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Effect" Value="{StaticResource EfxSoftShadow}" />
    </Style>

    <Style x:Key="StyDeadwoodLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource BrsBody}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Effect" Value="{StaticResource EfxSoftShadow}" />
    </Style>

    <Style x:Key="StyDeadwoodValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="52" />
        <Setter Property="Foreground" Value="{StaticResource BrsTitle}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="16,0,0,0" />
        <!-- The digits of the display family sit low in their line, so they are lifted to
             share the middle line of the label beside them. -->
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform Y="-7" />
            </Setter.Value>
        </Setter>
        <Setter Property="Effect" Value="{StaticResource EfxSoftShadow}" />
    </Style>

    <Style x:Key="StyMatchStatRow" TargetType="DockPanel">
        <Setter Property="LastChildFill" Value="False" />
        <Setter Property="Margin" Value="4,7,4,7" />
    </Style>

    <Style x:Key="StyMatchStatLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource BrsBody}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StyMatchStatValue" TargetType="TextBlock">
        <Setter Property="DockPanel.Dock" Value="Right" />
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource BrsTitle}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StyMatchLogText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource BrsBody}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style x:Key="StyMatchChatAuthor" TargetType="TextBlock" BasedOn="{StaticResource StyChatAuthor}">
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style x:Key="StyMatchChatTime" TargetType="TextBlock" BasedOn="{StaticResource StyChatTime}">
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style x:Key="StyMatchChatContent" TargetType="TextBlock" BasedOn="{StaticResource StyChatContent}">
        <Setter Property="FontSize" Value="18" />
    </Style>

    <!-- Forfeiting counts as a defeat (CU-26), so its button takes the red of the warnings. -->
    <Style x:Key="StyForfeitButton" TargetType="Button" BasedOn="{StaticResource StyLobbySecondaryButton}">
        <Setter Property="Background" Value="{StaticResource BrsMenuWarn}" />
    </Style>

    <!-- The pause, the close of a hand and the result of the match open over the table, which
         stays in sight under the veil, as the prototype draws them. -->
    <Style x:Key="StyTableOverlayCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrsArtworkPanel}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrsMenuInk}" />
        <Setter Property="BorderThickness" Value="0,0,0,4" />
        <Setter Property="ctl:PixelShapeCommon.CornerSteps" Value="5" />
        <Setter Property="Padding" Value="40,28,40,30" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StyHandWinnerPill" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrsMenuWarn}" />
        <Setter Property="ctl:PixelShapeCommon.CornerSteps" Value="3" />
        <Setter Property="Padding" Value="16,4,16,5" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="StyHandWinnerText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource BrsMenuLight}" />
    </Style>

    <Style x:Key="StyHandCountRow" TargetType="DockPanel">
        <Setter Property="LastChildFill" Value="False" />
        <Setter Property="Margin" Value="0,3,0,3" />
    </Style>

    <Style x:Key="StyHandCountLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource BrsBody}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StyHandCountValue" TargetType="TextBlock">
