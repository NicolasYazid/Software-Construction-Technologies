    <!-- The sizes are halves and doubles of the grid of twenty-four, which keeps the blocks of the symbols square. -->
    <Style x:Key="StyCardSuit" TargetType="Image">
        <Setter Property="Source" Value="{StaticResource IcoSuitSpades}" />
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="6,25,0,0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Suit}" Value="Clubs">
                <Setter Property="Source" Value="{StaticResource IcoSuitClubs}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Suit}" Value="Diamonds">
                <Setter Property="Source" Value="{StaticResource IcoSuitDiamonds}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Suit}" Value="Hearts">
                <Setter Property="Source" Value="{StaticResource IcoSuitHearts}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StyCardSuitLarge" TargetType="Image" BasedOn="{StaticResource StyCardSuit}">
        <Setter Property="Margin" Value="10,36,0,0" />
    </Style>

    <Style x:Key="StyCardSuitMini" TargetType="Image" BasedOn="{StaticResource StyCardSuit}">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="0,0,5,6" />
    </Style>

    <Style x:Key="StyCardSuitCenter" TargetType="Image" BasedOn="{StaticResource StyCardSuit}">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <Style x:Key="StyCardSuitCenterLarge" TargetType="Image" BasedOn="{StaticResource StyCardSuitCenter}">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
    </Style>

    <!-- Each card is drawn inside a transparent room of 24 pixels where it can tilt without being cut,
         so a 92 pixel card needs a hand 140 pixels tall. The cards rise above and fall below the hand,
         so it does not clip them. -->
    <Style x:Key="StyCardHand" TargetType="ctl:CardHand">
        <Setter Property="TiltRoom" Value="24" />
        <Setter Property="Height" Value="140" />
        <Setter Property="Margin" Value="0,-8,0,-24" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <!-- The hand of the opponent is seen from across the table, so its fan bends the other way, and it
         cannot be touched, so its cards do not tilt. Its 78 pixel cards with the same room need 126 pixels. -->
    <Style x:Key="StyOpponentHand" TargetType="ctl:CardHand" BasedOn="{StaticResource StyCardHand}">
        <Setter Property="Height" Value="126" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="IsHoverTiltEnabled" Value="False" />
        <Setter Property="IsFanFlipped" Value="True" />
    </Style>

    <!-- A pile keeps exactly the size of its card, because a card that travels from or to it reads that
         size, and a card lands on it in its place instead of rising into it. -->
    <Style x:Key="StyTablePile" TargetType="ctl:CardHand">
        <Setter Property="TiltRoom" Value="0" />
        <Setter Property="EntryDrop" Value="0" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="IsHoverTiltEnabled" Value="False" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Focusable" Value="False" />
    </Style>
    <Style x:Key="StyTableSurface" TargetType="Rectangle">
        <Setter Property="Fill" Value="{StaticResource BrsTableSurface}" />
        <Setter Property="Stroke" Value="{StaticResource BrsLobbyRule}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeDashArray" Value="4 3" />
        <Setter Property="RadiusX" Value="96" />
        <Setter Property="RadiusY" Value="96" />
        <Setter Property="Effect" Value="{StaticResource EfxPanelShadow}" />
    </Style>

    <Style x:Key="StyTableCaption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource BrsTitle}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Effect" Value="{StaticResource EfxSoftShadow}" />
    </Style>

    <Style x:Key="StyTablePill" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource BrsMuted}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="10,3,10,4" />
        <Setter Property="Margin" Value="12,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Effect" Value="{StaticResource EfxSoftShadow}" />
    </Style>

    <Style x:Key="StyTablePillText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource BrsBody}" />
    </Style>

    <Style x:Key="StyTableNote" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource BrsTitle}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Effect" Value="{StaticResource EfxSoftShadow}" />
    </Style>

    <Style x:Key="StyDeadwoodLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource BrsBody}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Effect" Value="{StaticResource EfxSoftShadow}" />
    </Style>

    <Style x:Key="StyDeadwoodValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="52" />
        <Setter Property="Foreground" Value="{StaticResource BrsTitle}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="16,0,0,0" />
        <!-- The digits of the display family sit low in their line, so they are lifted to the middle line of the label beside them. -->
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform Y="-7" />
            </Setter.Value>
        </Setter>
        <Setter Property="Effect" Value="{StaticResource EfxSoftShadow}" />
    </Style>

    <Style x:Key="StyMatchStatRow" TargetType="DockPanel">
        <Setter Property="LastChildFill" Value="False" />
        <Setter Property="Margin" Value="4,7,4,7" />
    </Style>

    <Style x:Key="StyMatchStatLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource BrsBody}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StyMatchStatValue" TargetType="TextBlock">
        <Setter Property="DockPanel.Dock" Value="Right" />
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource BrsTitle}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StyMatchLogText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource BrsBody}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style x:Key="StyMatchChatAuthor" TargetType="TextBlock" BasedOn="{StaticResource StyChatAuthor}">
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style x:Key="StyMatchChatTime" TargetType="TextBlock" BasedOn="{StaticResource StyChatTime}">
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style x:Key="StyMatchChatContent" TargetType="TextBlock" BasedOn="{StaticResource StyChatContent}">
        <Setter Property="FontSize" Value="18" />
    </Style>

    <!-- Forfeiting counts as a defeat (CU-26), so its button takes the red of the warnings. -->
    <Style x:Key="StyForfeitButton" TargetType="Button" BasedOn="{StaticResource StyLobbySecondaryButton}">
        <Setter Property="Background" Value="{StaticResource BrsMenuWarn}" />
    </Style>

    <!-- The pause, the close of a hand and the result open over the table because the prototype draws them that way. -->
    <Style x:Key="StyTableOverlayCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrsArtworkPanel}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrsMenuInk}" />
        <Setter Property="BorderThickness" Value="0,0,0,4" />
        <Setter Property="ctl:PixelShapeCommon.CornerSteps" Value="5" />
        <Setter Property="Padding" Value="40,28,40,30" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StyHandWinnerPill" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrsMenuWarn}" />
        <Setter Property="ctl:PixelShapeCommon.CornerSteps" Value="3" />
        <Setter Property="Padding" Value="16,4,16,5" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="StyHandWinnerText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource BrsMenuLight}" />
    </Style>

    <Style x:Key="StyHandCountRow" TargetType="DockPanel">
        <Setter Property="LastChildFill" Value="False" />
        <Setter Property="Margin" Value="0,3,0,3" />
    </Style>

    <Style x:Key="StyHandCountLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource BrsBody}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StyHandCountValue" TargetType="TextBlock">
        <Setter Property="DockPanel.Dock" Value="Right" />
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource BrsTitle}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StyMeldPanel" TargetType="Border" BasedOn="{StaticResource StySettingCard}">
        <Setter Property="Padding" Value="16,12,16,10" />
        <Setter Property="Margin" Value="0,12,0,0" />
    </Style>

    <Style x:Key="StyMeldPanelTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource BrsTitle}" />
    </Style>

    <Style x:Key="StyMeldLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource BrsMuted}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style x:Key="StyResultTitle" TargetType="TextBlock" BasedOn="{StaticResource StyCardTitle}">
        <Setter Property="FontSize" Value="56" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style x:Key="StyResultReason" TargetType="TextBlock" BasedOn="{StaticResource StyDialogMessage}">
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style x:Key="StyFinalScore" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource BrsTitle}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

</ResourceDictionary>
