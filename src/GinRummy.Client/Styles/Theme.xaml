    <!-- The reasons of a report are exclusive options: a disc ringed with the colour of the
         muted text, since a sunk edge alone vanished over the dark card, that fills with the
         light of the menu when it is chosen. -->
    <Style x:Key="StyReasonRadio" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource BrsBody}" />
        <Setter Property="Background" Value="{StaticResource BrsFieldFace}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,0,12" />
