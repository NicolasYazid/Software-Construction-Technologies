    <!-- The content of the tabs lives in the window because both tabs share the search field between them and their lists.
         Each tab draws its shape a corner wider towards its neighbour so the edge they share is straight.
         The switch is meant for two tabs because the alternation index is what tells the first from the second. -->
    <ControlTemplate x:Key="TplPanelTab" TargetType="TabItem">
        <Grid ClipToBounds="True">
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Margin" Value="0,0,-12,0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex),
                                                   RelativeSource={RelativeSource TemplatedParent}}"
                                         Value="1">
                                <Setter Property="Margin" Value="-12,0,0,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <ctl:PixelSurface Margin="0,6,0,0" FaceBrush="{StaticResource BrsMenuInk}" />
                <ctl:PixelSurface FaceBrush="{TemplateBinding Background}">
                    <ctl:PixelSurface.Style>
                        <Style TargetType="ctl:PixelSurface">
                            <Setter Property="Margin" Value="0,0,0,6" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver,
                                                       RelativeSource={RelativeSource TemplatedParent}}"
                                             Value="True">
                                    <Setter Property="Margin" Value="0,3,0,3" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected,
                                                       RelativeSource={RelativeSource TemplatedParent}}"
                                             Value="True">
                                    <Setter Property="Margin" Value="0,6,0,0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ctl:PixelSurface.Style>
                    <Grid>
                        <ctl:PixelSurface FaceBrush="{StaticResource BrsMenuInk}">
                            <ctl:PixelSurface.Style>
                                <Style TargetType="ctl:PixelSurface">
                                    <Setter Property="Opacity" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver,
                                                               RelativeSource={RelativeSource TemplatedParent}}"
                                                     Value="True">
                                            <Setter Property="Opacity" Value="0.53" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected,
                                                               RelativeSource={RelativeSource TemplatedParent}}"
                                                     Value="True">
                                            <Setter Property="Opacity" Value="0.53" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ctl:PixelSurface.Style>
                        </ctl:PixelSurface>
                        <ContentPresenter ContentSource="Header"
                                          Effect="{StaticResource EfxTextRaiseSmall}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter.Style>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Margin" Value="10,0,22,0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex),
                                                               RelativeSource={RelativeSource TemplatedParent}}"
                                                     Value="1">
                                            <Setter Property="Margin" Value="22,0,10,0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentPresenter.Style>
                        </ContentPresenter>
                    </Grid>
                </ctl:PixelSurface>
            </Grid>
        </Grid>
    </ControlTemplate>

    <Style x:Key="StyPanelTab" TargetType="TabItem">
