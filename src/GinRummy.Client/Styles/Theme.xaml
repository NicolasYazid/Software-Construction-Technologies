        <Setter Property="Foreground" Value="{StaticResource BrsBody}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="StySocialChip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrsMenuNeutral}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrsMenuInk}" />
        <Setter Property="BorderThickness" Value="0,0,0,3" />
        <Setter Property="ctl:PixelShapeCommon.CornerSteps" Value="3" />
        <Setter Property="Padding" Value="12,6,12,6" />
        <Setter Property="Margin" Value="0,0,10,0" />
    </Style>

    <Style x:Key="StySocialChipText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="16" />
