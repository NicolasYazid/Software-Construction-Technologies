                <ControlTemplate TargetType="ToggleButton">
                    <ctl:PixelBorder Background="{TemplateBinding Background}" ctl:PixelShapeCommon.CornerSteps="4"
                            BorderBrush="{StaticResource BrsMenuInk}" BorderThickness="0,0,0,3">
                        <Border Width="20" Height="20" Margin="5,0,5,0" Background="{StaticResource BrsMenuLight}"
                                ctl:PixelShapeCommon.CornerSteps="2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked,
                                                               RelativeSource={RelativeSource TemplatedParent}}"
                                                     Value="True">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </DataTrigger>
                                    </Style.Triggers>
