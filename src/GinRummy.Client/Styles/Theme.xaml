    <!-- ============================================================
         Tokens de diseno del cliente. El prototipo de Figma fue el
         punto de partida; a partir de la version 2 el diseno es una
         decision del equipo y vive aqui, no en el archivo de Figma.
         ============================================================ -->

    <!-- Cairopixel is the only family of the three that covers the accents, the enye and the
         inverted marks that STK-13 asks for, so the other two name it as the next family in
         the list and WPF resolves every missing glyph there. RetroByte in particular carries
         no accented vowel, so the Spanish labels of the bar are drawn by both families at
         once, which is visible: its capitals measure 0.56 of the em against the 0.44 of
         Cairopixel. -->
    <FontFamily x:Key="FntDisplay">pack://application:,,,/Fonts/#RetroByte, pack://application:,,,/Fonts/#Cairopixel</FontFamily>
    <FontFamily x:Key="FntBody">pack://application:,,,/Fonts/#Cairopixel</FontFamily>
    <FontFamily x:Key="FntBrand">pack://application:,,,/Fonts/#HigherPixels, pack://application:,,,/Fonts/#Cairopixel</FontFamily>

