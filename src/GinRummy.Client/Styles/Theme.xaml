<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:GinRummy.Client.Converters"
                    xmlns:ctl="clr-namespace:GinRummy.Client.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Styles/Icons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <conv:EmptyTextToVisibilityConverter x:Key="CnvEmptyTextToVisibility" />
    <conv:UpperCaseConverter x:Key="CnvUpperCase" />
    <BooleanToVisibilityConverter x:Key="CnvBooleanToVisibility" />
    <conv:LocalizedFormatConverter x:Key="CnvLocalizedFormat" />
    <conv:LocalizedFormatConverter x:Key="CnvUpperLocalizedFormat" IsUpperCase="True" />
    <conv:ResourceTextConverter x:Key="CnvResourceText" />
    <conv:ResourceTextConverter x:Key="CnvUpperResourceText" IsUpperCase="True" />
    <conv:CultureNumberConverter x:Key="CnvCultureNumber" />
    <conv:CardRankConverter x:Key="CnvCardRank" />
    <conv:CardNameConverter x:Key="CnvCardName" />
    <conv:MatchLogConverter x:Key="CnvMatchLog" />

    <!-- The Figma prototype was the starting point, but from version 2 on the design is decided here and not in the Figma file. -->

    <!-- Cairopixel is the only family that covers the accents, the enye and the inverted marks, so the others fall back to it. -->
    <FontFamily x:Key="FntDisplay">pack://application:,,,/Fonts/#RetroByte, pack://application:,,,/Fonts/#Cairopixel</FontFamily>
    <FontFamily x:Key="FntBody">pack://application:,,,/Fonts/#Cairopixel</FontFamily>
    <FontFamily x:Key="FntBrand">pack://application:,,,/Fonts/#HigherPixels, pack://application:,,,/Fonts/#Cairopixel</FontFamily>

    <SolidColorBrush x:Key="BrsMenuRoot" Color="#FF103A28" />
    <SolidColorBrush x:Key="BrsMenuArtwork" Color="#FFE9E9E9" />
    <SolidColorBrush x:Key="BrsMenuEdge" Color="#73FFFFFF" />
    <SolidColorBrush x:Key="BrsMenuPrimary" Color="#FF8E8E93" />
    <SolidColorBrush x:Key="BrsOutline" Color="#FF333333" />
    <SolidColorBrush x:Key="BrsLogo" Color="#FF8E8E93" />
    <SolidColorBrush x:Key="BrsLogoMark" Color="#FF3B3B3B" />

    <!-- These are Color and not SolidColorBrush because the control blends them channel by channel on every frame. -->
    <Color x:Key="ClrMenuLiquidDeep">#FF072118</Color>
    <Color x:Key="ClrMenuLiquidMid">#FF1E6746</Color>
    <Color x:Key="ClrMenuLiquidGlow">#FF6AD29A</Color>
    <!-- The names describe the role and not the colour, so changing the palette does not force renaming anything. -->
    <SolidColorBrush x:Key="BrsMenuInk" Color="#0B0D0C" />
    <SolidColorBrush x:Key="BrsMenuPanel" Color="#801A1712" />
    <!-- The side chips carry their own brush because, being much smaller, the background reads through them more at the same alpha. -->
    <SolidColorBrush x:Key="BrsMenuChipPanel" Color="#BF1A1712" />
    <SolidColorBrush x:Key="BrsMenuAccent" Color="#FF8B2C1F" />
    <SolidColorBrush x:Key="BrsMenuAction" Color="#FF3B3F2F" />
    <SolidColorBrush x:Key="BrsMenuEarth" Color="#FF4B3B2A" />
    <SolidColorBrush x:Key="BrsMenuNeutral" Color="#FF2C2E30" />
    <SolidColorBrush x:Key="BrsMenuWarn" Color="#FF6B2E2F" />
    <SolidColorBrush x:Key="BrsMenuSettings" Color="#FF2F4B55" />
    <SolidColorBrush x:Key="BrsHighlight" Color="#FF2F5A43" />
    <!-- The highlight is translucent so the room keeps showing through a highlighted row, as it does through the panels. -->
    <SolidColorBrush x:Key="BrsHighlightGlass" Color="#992F5A43" />
    <SolidColorBrush x:Key="BrsMenuChipFaceOver" Color="#FF442F1C" />
    <SolidColorBrush x:Key="BrsMenuLight" Color="#FFEDE4DC" />
    <SolidColorBrush x:Key="BrsMenuOnDark" Color="#FFFFFFFF" />

    <DropShadowEffect x:Key="EfxPanelShadow" Color="#FF0A130E"
                      BlurRadius="40" ShadowDepth="13" Direction="270" Opacity="0.92" />
    <DropShadowEffect x:Key="EfxTextShadow" Color="#FF0A130E"
                      BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.95" />
    <DropShadowEffect x:Key="EfxSoftShadow" Color="#FF0A130E"
                      BlurRadius="6" ShadowDepth="2" Direction="270" Opacity="0.9" />
    <!-- The cards over the chat cast a darker and shorter shadow so it stays visible over the moving list. -->
    <DropShadowEffect x:Key="EfxFloatShadow" Color="#FF0A130E"
                      BlurRadius="30" ShadowDepth="13" Direction="270" Opacity="0.98" />
    <DropShadowEffect x:Key="EfxCardShadow" Color="#FF0A130E"
                      BlurRadius="10" ShadowDepth="5" Direction="270" Opacity="0.7" />

    <!-- The blur is zero because a blurred shadow reads as a light behind the letter and not as the raised face of the buttons. -->
    <DropShadowEffect x:Key="EfxTextRaise" Color="#0B0D0C"
                      BlurRadius="0" ShadowDepth="3" Direction="270" Opacity="0.7" />
    <DropShadowEffect x:Key="EfxTextRaiseSmall" Color="#0B0D0C"
                      BlurRadius="0" ShadowDepth="2" Direction="270" Opacity="0.7" />

    <!-- The screens of the light prototype keep their token names, but the values point at the menu so the client reads as one product.
         The page and the card share an opaque brown because a translucent card looked grey over a new window and green over the page. -->
    <Color x:Key="ClrBrownBackground">#FF1C1814</Color>
    <SolidColorBrush x:Key="BrsPageBackground" Color="{StaticResource ClrBrownBackground}" />
    <SolidColorBrush x:Key="BrsSurface" Color="{StaticResource ClrBrownBackground}" />
    <SolidColorBrush x:Key="BrsArtworkPanel" Color="#FF0C2B1E" />
    <SolidColorBrush x:Key="BrsArtworkLogo" Color="#FF1E6746" />

    <Color x:Key="ClrArtworkDeep">#FF06180F</Color>
    <Color x:Key="ClrArtworkMid">#FF1E6746</Color>
    <Color x:Key="ClrArtworkGlow">#FF6AD29A</Color>
    <SolidColorBrush x:Key="BrsTitle" Color="#FFEDE4DC" />
    <SolidColorBrush x:Key="BrsBody" Color="#FFD8CCC0" />
    <SolidColorBrush x:Key="BrsMuted" Color="#FFA68F7C" />
    <SolidColorBrush x:Key="BrsFieldBorder" Color="#FF0B0D0C" />
    <SolidColorBrush x:Key="BrsFieldFace" Color="#FF362B22" />
    <SolidColorBrush x:Key="BrsPrimary" Color="#FF8B2C1F" />
    <SolidColorBrush x:Key="BrsCheckBorder" Color="#FFA68F7C" />
    <SolidColorBrush x:Key="BrsDanger" Color="#FFE08A6A" />

    <SolidColorBrush x:Key="BrsPlainTitle" Color="#FFEDE4DC" />
    <SolidColorBrush x:Key="BrsPlainMuted" Color="#FFA68F7C" />
    <SolidColorBrush x:Key="BrsPlainBorder" Color="#FF0B0D0C" />
    <SolidColorBrush x:Key="BrsPlainPrimary" Color="#FF3B3F2F" />

    <!-- The weight stays normal because the pixel families have no bold face, and the bold WPF synthesises blurs their square edges. -->
    <Style x:Key="StyLogoWordmark" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntBrand}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="128" />
        <Setter Property="Foreground" Value="{StaticResource BrsLogo}" />
    </Style>

    <Style x:Key="StyTagline" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource BrsBody}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- The face and the highlight react through their own styles so that no template part needs a name outside the prefix vocabulary. -->
    <ControlTemplate x:Key="TplMenuButton" TargetType="Button">
        <Grid>
            <ctl:PixelSurface Margin="0,6,0,0"
                                 FaceBrush="{StaticResource BrsMenuInk}" />
            <ctl:PixelSurface FaceBrush="{TemplateBinding Background}">
                <ctl:PixelSurface.Style>
                    <Style TargetType="ctl:PixelSurface">
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <Style.Triggers>
                            <!-- The pointer sinks the face one block and the press two, so hovering answers and the press reads deeper.
                                 Both distances are whole blocks to keep the face on the grid while it moves.
                                 The trigger of the press is declared after this one so it wins while both apply. -->
                            <DataTrigger Binding="{Binding IsMouseOver,
                                                   RelativeSource={RelativeSource TemplatedParent}}"
                                         Value="True">
                                <Setter Property="Margin" Value="0,3,0,3" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPressed,
                                                   RelativeSource={RelativeSource TemplatedParent}}"
                                         Value="True">
                                <Setter Property="Margin" Value="0,6,0,0" />
                            </DataTrigger>
                            <!-- A disabled button stays sunk so it reads as unavailable through the movement of the press.
                                 It is declared last so it wins over the pointer triggers. -->
                            <DataTrigger Binding="{Binding IsEnabled,
                                                   RelativeSource={RelativeSource TemplatedParent}}"
                                         Value="False">
                                <Setter Property="Margin" Value="0,6,0,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ctl:PixelSurface.Style>
                <Grid>
                    <!-- The highlight takes the stepped shape of the face so no square corners show when it darkens.
                         It sits beside the content because, wrapped around it, its zero opacity hid the content too.
                         The side padding comes from the content because padding on the surface left an undarkened strip on each side. -->
                    <ctl:PixelSurface FaceBrush="{StaticResource BrsMenuInk}">
                        <ctl:PixelSurface.Style>
                            <Style TargetType="ctl:PixelSurface">
                                <Setter Property="Opacity" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver,
                                                           RelativeSource={RelativeSource TemplatedParent}}"
                                                 Value="True">
                                        <Setter Property="Opacity" Value="0.53" />
                                    </DataTrigger>
                                    <!-- It keeps the pointer darkening too, because a disabled control never receives the pointer. -->
                                    <DataTrigger Binding="{Binding IsEnabled,
                                                           RelativeSource={RelativeSource TemplatedParent}}"
                                                 Value="False">
                                        <Setter Property="Opacity" Value="0.53" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ctl:PixelSurface.Style>
                    </ctl:PixelSurface>
                    <ContentPresenter Margin="14,0,14,0"
                                      Effect="{StaticResource EfxTextRaise}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </ctl:PixelSurface>
        </Grid>
    </ControlTemplate>

    <!-- Each row of buttons shares one size so it reads as a single block.
         Growing this size means widening the window, because the longest label already takes 311 of the 334 units beside the chips. -->
    <Style x:Key="StyMenuButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="Foreground" Value="{StaticResource BrsMenuLight}" />
        <Setter Property="Background" Value="{StaticResource BrsMenuAction}" />
        <Setter Property="Height" Value="72" />
        <Setter Property="MinWidth" Value="230" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template" Value="{StaticResource TplMenuButton}" />
    </Style>

    <Style x:Key="StyMenuSmallButton" TargetType="Button" BasedOn="{StaticResource StyMenuButton}">
        <Setter Property="FontSize" Value="27" />
        <Setter Property="Height" Value="58" />
        <Setter Property="MinWidth" Value="200" />
    </Style>

    <Style x:Key="StyMenuSmallAltButton" TargetType="Button" BasedOn="{StaticResource StyMenuSmallButton}">
        <Setter Property="Foreground" Value="{StaticResource BrsMenuLight}" />
        <Setter Property="Background" Value="{StaticResource BrsMenuWarn}" />
    </Style>

    <Style x:Key="StyMenuPrimaryButton" TargetType="Button" BasedOn="{StaticResource StyMenuButton}">
        <Setter Property="Foreground" Value="{StaticResource BrsMenuLight}" />
        <Setter Property="Background" Value="{StaticResource BrsMenuAccent}" />
    </Style>

    <!-- The panels take a corner of more blocks because a panel this size with the corner of a button reads as square.
         They are raised over a base of the same shape because they carry no border to give them depth. -->
    <Style x:Key="StyMenuBar" TargetType="ctl:PixelSurface">
        <Setter Property="FaceBrush" Value="{StaticResource BrsMenuPanel}" />
        <Setter Property="BaseBrush" Value="{StaticResource BrsMenuInk}" />
        <Setter Property="BaseDepth" Value="4" />
        <Setter Property="CornerSteps" Value="6" />
        <Setter Property="Padding" Value="14,14,14,14" />
        <Setter Property="Effect" Value="{StaticResource EfxPanelShadow}" />
    </Style>

    <Style x:Key="StyMenuChip" TargetType="ctl:PixelSurface">
        <Setter Property="FaceBrush" Value="{StaticResource BrsMenuChipPanel}" />
        <Setter Property="BaseBrush" Value="{StaticResource BrsMenuInk}" />
        <Setter Property="BaseDepth" Value="3" />
        <Setter Property="CornerSteps" Value="5" />
        <Setter Property="Padding" Value="14,12,14,14" />
        <Setter Property="Effect" Value="{StaticResource EfxPanelShadow}" />
    </Style>

    <!-- The settings chip holds a real button, so it takes the raised face of the buttons and not the flat inset of the selector. -->
    <Style x:Key="StyMenuChipButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="{StaticResource BrsMenuSettings}" />
        <Setter Property="Height" Value="50" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template" Value="{StaticResource TplMenuButton}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The selector takes the display family because it sits in the same panel as the buttons of the bar.
         Its options answer like buttons and the chosen one stays held down, so the list reads as a set of keys. -->
    <Style x:Key="StyMenuLanguageItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource BrsMenuLight}" />
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid Background="Transparent">
                        <Border Background="{StaticResource BrsMenuInk}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Opacity" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected,
                                                               RelativeSource={RelativeSource TemplatedParent}}"
                                                     Value="True">
                                            <Setter Property="Opacity" Value="0.53" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsHighlighted,
                                                               RelativeSource={RelativeSource TemplatedParent}}"
                                                     Value="True">
                                            <Setter Property="Opacity" Value="0.53" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <ContentPresenter Effect="{StaticResource EfxTextRaiseSmall}" VerticalAlignment="Center">
                            <ContentPresenter.Style>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Margin" Value="12,8,12,8" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected,
                                                               RelativeSource={RelativeSource TemplatedParent}}"
                                                     Value="True">
                                            <Setter Property="Margin" Value="12,11,12,5" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsHighlighted,
                                                               RelativeSource={RelativeSource TemplatedParent}}"
                                                     Value="True">
                                            <Setter Property="Margin" Value="12,11,12,5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentPresenter.Style>
                        </ContentPresenter>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The selector carries its own template because the ComboBox of the system draws a light background and ignores Background.
         While the list is open the face grows one base deeper, so the button and the list read as a single piece.
         PART_Popup is the name the framework requires. -->
    <Style x:Key="StyMenuLanguageBox" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource BrsMenuLight}" />
        <Setter Property="Background" Value="{StaticResource BrsFieldFace}" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource StyMenuLanguageItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid ClipToBounds="True">
                        <ctl:PixelSurface Margin="0,6,0,0" FaceBrush="{StaticResource BrsMenuInk}" />
                        <ctl:PixelSurface FaceBrush="{TemplateBinding Background}">
                            <ctl:PixelSurface.Style>
                                <Style TargetType="ctl:PixelSurface">
                                    <Setter Property="Margin" Value="0,0,0,6" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver,
                                                               RelativeSource={RelativeSource TemplatedParent}}"
                                                     Value="True">
                                            <Setter Property="Margin" Value="0,3,0,3" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDropDownOpen,
                                                               RelativeSource={RelativeSource TemplatedParent}}"
                                                     Value="True">
                                            <Setter Property="Margin" Value="0,6,0,-6" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ctl:PixelSurface.Style>
                            <Grid>
                                <ctl:PixelSurface FaceBrush="{StaticResource BrsMenuInk}">
                                    <ctl:PixelSurface.Style>
                                        <Style TargetType="ctl:PixelSurface">
                                            <Setter Property="Opacity" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver,
                                                                       RelativeSource={RelativeSource TemplatedParent}}"
                                                             Value="True">
                                                    <Setter Property="Opacity" Value="0.53" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDropDownOpen,
                                                                       RelativeSource={RelativeSource TemplatedParent}}"
                                                             Value="True">
                                                    <Setter Property="Opacity" Value="0.53" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ctl:PixelSurface.Style>
                                </ctl:PixelSurface>
                                <!-- The margins leave room for the widest name, the Spanish one, beside the icon and the arrow.
                                     While the face hangs past the edge, the row avoids the cut part to stay centred on what shows. -->
                                <DockPanel LastChildFill="True">
                                    <DockPanel.Style>
                                        <Style TargetType="DockPanel">
                                            <Setter Property="Margin" Value="10,0,10,0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDropDownOpen,
                                                                       RelativeSource={RelativeSource TemplatedParent}}"
                                                             Value="True">
                                                    <Setter Property="Margin" Value="10,0,10,6" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DockPanel.Style>
                                    <Image DockPanel.Dock="Left" Width="17" Height="17" Margin="0,0,6,0"
                                           VerticalAlignment="Center" Source="{TemplateBinding Tag}">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tag,
                                                                           RelativeSource={RelativeSource TemplatedParent}}"
                                                                 Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <Path DockPanel.Dock="Right" Data="M0,0 L8,0 L4,5 Z"
                                          Fill="{StaticResource BrsMenuLight}"
                                          Effect="{StaticResource EfxTextRaiseSmall}"
                                          VerticalAlignment="Center" />
                                    <ContentPresenter Margin="0,0,6,0"
                                                      Effect="{StaticResource EfxTextRaiseSmall}"
                                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                                </DockPanel>
                            </Grid>
                        </ctl:PixelSurface>
                        <!-- The toggle is an invisible layer so the whole selector opens the list. -->
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False">
                            <Grid ClipToBounds="True"
                                  Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ctl:PixelBorder Margin="0,-6,0,0" Padding="0,6,0,0"
                                                    Background="{StaticResource BrsFieldFace}"
                                                    BorderBrush="{StaticResource BrsMenuInk}" BorderThickness="0,0,0,6"
                                                    ctl:PixelShapeCommon.CornerSteps="4">
                                    <StackPanel IsItemsHost="True" />
                                </ctl:PixelBorder>
                            </Grid>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StyMenuChipCaption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="Foreground" Value="{StaticResource BrsMenuLight}" />
        <Setter Property="Effect" Value="{StaticResource EfxTextRaiseSmall}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StyPanelCaption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource BrsMuted}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- The title takes the display family of the buttons so the heading of a modal reads as part of the menu. -->
    <Style x:Key="StyCardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="44" />
        <Setter Property="Margin" Value="0,10,0,0" />
        <Setter Property="Foreground" Value="{StaticResource BrsTitle}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="StyCardSubtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="LineHeight" Value="30" />
        <Setter Property="Foreground" Value="{StaticResource BrsBody}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="StyFieldLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource BrsMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- The field is sunk instead of outlined, the same device the chips of the menu use.
         The height stays at fifty because the screens place what follows by fixed margins.
         The stepped corners are lent to it as a clip so the field keeps its plain border. -->
    <Style x:Key="StyFieldShell" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrsFieldFace}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrsFieldBorder}" />
        <Setter Property="BorderThickness" Value="0,0,0,4" />
        <Setter Property="ctl:PixelShapeCommon.CornerSteps" Value="4" />
        <Setter Property="Height" Value="50" />
        <Setter Property="Padding" Value="16,0,16,0" />
    </Style>

    <Style x:Key="StyFieldInput" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource BrsBody}" />
        <Setter Property="CaretBrush" Value="{StaticResource BrsBody}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- The mask is stated because the default circle, U+25CF, is in none of the fonts of the project, while U+2022 is in both. -->
    <Style x:Key="StyFieldPassword" TargetType="PasswordBox">
        <Setter Property="PasswordChar" Value="&#x2022;" />
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource BrsBody}" />
        <Setter Property="CaretBrush" Value="{StaticResource BrsBody}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- The hint starts a few pixels in because the caret of an empty field crossed the first letter of a hint flush with the field. -->
    <Style x:Key="StyFieldPlaceholder" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
