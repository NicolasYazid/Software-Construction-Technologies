        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource BrsBody}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The height is free because a fixed one clipped the descenders of the link as soon as the text grew. -->
    <Style x:Key="StyInlineTextButton" TargetType="Button" BasedOn="{StaticResource StyCardTextButton}">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!-- The box carries its own template because the one of the system keeps a light chrome that disappeared over the dark card.
         The tick is drawn in blocks of the grid so it stays as square as the rest of the pixel shapes. -->
    <Style x:Key="StyKeepSignedIn" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource BrsMuted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource BrsFieldFace}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="22" Height="26" VerticalAlignment="Center">
                            <ctl:PixelSurface Margin="0,4,0,0" PixelUnit="2" CornerSteps="2"
                                                 FaceBrush="{StaticResource BrsMenuInk}" />
                            <ctl:PixelSurface PixelUnit="2" CornerSteps="2" FaceBrush="{TemplateBinding Background}">
                                <ctl:PixelSurface.Style>
                                    <Style TargetType="ctl:PixelSurface">
                                        <Setter Property="Margin" Value="0,0,0,4" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver,
                                                                   RelativeSource={RelativeSource TemplatedParent}}"
                                                         Value="True">
                                                <Setter Property="Margin" Value="0,2,0,2" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPressed,
                                                                   RelativeSource={RelativeSource TemplatedParent}}"
                                                         Value="True">
                                                <Setter Property="Margin" Value="0,4,0,0" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsChecked,
                                                                   RelativeSource={RelativeSource TemplatedParent}}"
                                                         Value="True">
                                                <Setter Property="Margin" Value="0,4,0,0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ctl:PixelSurface.Style>
                                <Grid>
                                    <ctl:PixelSurface PixelUnit="2" CornerSteps="2"
                                                         FaceBrush="{StaticResource BrsMenuInk}">
                                        <ctl:PixelSurface.Style>
                                            <Style TargetType="ctl:PixelSurface">
                                                <Setter Property="Opacity" Value="0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver,
                                                                           RelativeSource={RelativeSource TemplatedParent}}"
                                                                 Value="True">
                                                        <Setter Property="Opacity" Value="0.53" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsChecked,
                                                                           RelativeSource={RelativeSource TemplatedParent}}"
                                                                 Value="True">
                                                        <Setter Property="Opacity" Value="0.53" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ctl:PixelSurface.Style>
                                    </ctl:PixelSurface>
                                    <Path Width="14" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Fill="{StaticResource BrsMenuLight}"
                                          Effect="{StaticResource EfxTextRaiseSmall}"
                                          SnapsToDevicePixels="True"
                                          Data="M10,0 H14 V2 H10 Z M8,2 H12 V4 H8 Z M0,4 H4 V6 H0 Z M6,4 H10 V6 H6 Z
                                                M2,6 H8 V8 H2 Z M4,8 H6 V10 H4 Z"
                                          Visibility="{TemplateBinding IsChecked,
                                                       Converter={StaticResource CnvBooleanToVisibility}}" />
                                </Grid>
                            </ctl:PixelSurface>
                        </Grid>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource BrsBody}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource BrsMenuInk}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource BrsMenuInk}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The rule takes the colour of its text because the ink of the sunk edges was invisible against the dark card. -->
    <Style x:Key="StyDividerLine" TargetType="Border">
