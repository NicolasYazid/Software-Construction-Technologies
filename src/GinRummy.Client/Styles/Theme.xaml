        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <!-- The tabs of a panel show only their headers: the content they switch lives in the
         window, because both tabs share the search field that sits between them and their
         lists. They behave as a switch built from the buttons of the menu: every tab is a face
         raised over its ink base, and the selected one stays sunk and darkened as a button
         held down, so exactly one of them reads as pressed at any time. The pointer answers
         with half the sink and the same darkening, as it does on the buttons.
         The two tabs touch and read as a single control: each one draws its shape a corner
         wider than itself towards its neighbour and clips it at its own edge, so only the outer
         corners keep their steps and the edge they share is straight. The alternation index of
         the tab control tells the first tab from the second, which is why the switch is meant
         for two tabs. The header is pushed back by half that width, so it stays centred on the
         part of the tab that shows. -->
    <ControlTemplate x:Key="TplPanelTab" TargetType="TabItem">
        <Grid ClipToBounds="True">
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Margin" Value="0,0,-12,0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex),
                                                   RelativeSource={RelativeSource TemplatedParent}}"
                                         Value="1">
                                <Setter Property="Margin" Value="-12,0,0,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <ctl:CtlPixelSurface Margin="0,6,0,0" FaceBrush="{StaticResource BrsMenuInk}" />
                <ctl:CtlPixelSurface FaceBrush="{TemplateBinding Background}">
                    <ctl:CtlPixelSurface.Style>
                        <Style TargetType="ctl:CtlPixelSurface">
                            <Setter Property="Margin" Value="0,0,0,6" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver,
                                                       RelativeSource={RelativeSource TemplatedParent}}"
                                             Value="True">
                                    <Setter Property="Margin" Value="0,3,0,3" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected,
                                                       RelativeSource={RelativeSource TemplatedParent}}"
                                             Value="True">
                                    <Setter Property="Margin" Value="0,6,0,0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ctl:CtlPixelSurface.Style>
                    <Grid>
                        <ctl:CtlPixelSurface FaceBrush="{StaticResource BrsMenuInk}">
                            <ctl:CtlPixelSurface.Style>
                                <Style TargetType="ctl:CtlPixelSurface">
                                    <Setter Property="Opacity" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver,
                                                               RelativeSource={RelativeSource TemplatedParent}}"
                                                     Value="True">
                                            <Setter Property="Opacity" Value="0.53" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected,
                                                               RelativeSource={RelativeSource TemplatedParent}}"
                                                     Value="True">
                                            <Setter Property="Opacity" Value="0.53" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ctl:CtlPixelSurface.Style>
                        </ctl:CtlPixelSurface>
                        <ContentPresenter ContentSource="Header"
                                          Effect="{StaticResource EfxTextRaiseSmall}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter.Style>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Margin" Value="10,0,22,0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex),
                                                               RelativeSource={RelativeSource TemplatedParent}}"
                                                     Value="1">
                                            <Setter Property="Margin" Value="22,0,10,0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentPresenter.Style>
                        </ContentPresenter>
                    </Grid>
                </ctl:CtlPixelSurface>
            </Grid>
        </Grid>
    </ControlTemplate>

    <Style x:Key="StyPanelTab" TargetType="TabItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
