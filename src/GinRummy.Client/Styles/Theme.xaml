    <Style x:Key="StyDialogCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrsSurface}" />
        <Setter Property="ctl:PixelShapeCommon.CornerSteps" Value="5" />
        <Setter Property="Padding" Value="40,32,40,32" />
    </Style>

    <!-- The title of a dialog is smaller because several of them name a whole action and broke into three lines at the card size. -->
    <Style x:Key="StyDialogTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="Foreground" Value="{StaticResource BrsTitle}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="StyDialogMessage" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="LineHeight" Value="28" />
        <Setter Property="Foreground" Value="{StaticResource BrsBody}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Errors and warnings of consequence take the colour of the errors of the forms because the prototype paints them red. -->
    <Style x:Key="StyDialogWarning" TargetType="TextBlock" BasedOn="{StaticResource StyDialogMessage}">
        <Setter Property="Foreground" Value="{StaticResource BrsDanger}" />
    </Style>

    <!-- The emphasis is carried by colour because the prototype sets these values in bold and the pixel families have a single weight. -->
    <Style x:Key="StyDialogEmphasis" TargetType="TextBlock" BasedOn="{StaticResource StyDialogMessage}">
        <Setter Property="Foreground" Value="{StaticResource BrsTitle}" />
    </Style>

    <Style x:Key="StyDialogPrimaryButton" TargetType="Button" BasedOn="{StaticResource StyCardPrimaryButton}">
        <Setter Property="MinWidth" Value="170" />
    </Style>

    <Style x:Key="StyDialogSecondaryButton" TargetType="Button" BasedOn="{StaticResource StyCardOutlineButton}">
        <Setter Property="MinWidth" Value="170" />
        <Setter Property="Height" Value="50" />
    </Style>

    <!-- The dark green rings the presence dot so the dot stays apart from the avatar it sits on. -->
    <SolidColorBrush x:Key="BrsLobbyRail" Color="#FF041710" />
    <SolidColorBrush x:Key="BrsLobbyPanel" Color="#FF101C15" />
    <SolidColorBrush x:Key="BrsLobbyRule" Color="#33EDE4DC" />
    <SolidColorBrush x:Key="BrsLobbyRowOver" Color="#1FEDE4DC" />
    <SolidColorBrush x:Key="BrsPresenceOnline" Color="#FF6AD29A" />
    <!-- The fields sit one shade below the switch so the raised tabs and the sunk fields read as two depths of the same brown. -->
    <SolidColorBrush x:Key="BrsLobbyFieldFace" Color="#FF231B14" />
    <SolidColorBrush x:Key="BrsLobbySwitchFace" Color="#FF2A2018" />

    <Style x:Key="StyLobbyPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrsLobbyPanel}" />
        <Setter Property="ctl:PixelShapeCommon.CornerSteps" Value="5" />
    </Style>

    <!-- The panels are drawn by PixelBorder because a plain border painted the base inside the clip and broke the lower steps. -->
    <Style x:Key="StyLobbyGlassPanel" TargetType="Border" BasedOn="{StaticResource StyLobbyPanel}">
        <Setter Property="Background" Value="{StaticResource BrsMenuPanel}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrsMenuInk}" />
        <Setter Property="BorderThickness" Value="0,0,0,4" />
        <Setter Property="Effect" Value="{StaticResource EfxPanelShadow}" />
    </Style>

    <!-- The rail floats with the same gap as the other panels so its shadow has room to fall on the paint. -->
    <Style x:Key="StyLobbyGlassRail" TargetType="Border" BasedOn="{StaticResource StyLobbyGlassPanel}">
        <Setter Property="Margin" Value="12,12,0,12" />
    </Style>

    <!-- The cards inside a panel cast no shadow because a second shadow would darken the messages below them. -->
    <Style x:Key="StyLobbyGlassCard" TargetType="Border" BasedOn="{StaticResource StyLobbyGlassPanel}">
        <Setter Property="ctl:PixelShapeCommon.CornerSteps" Value="4" />
        <Setter Property="Effect" Value="{x:Null}" />
    </Style>

    <!-- These dialogs carry no shadow of their own because the host already casts the one of the panels around them. -->
    <Style x:Key="StyLobbyDialogCard" TargetType="Border" BasedOn="{StaticResource StyLobbyPanel}">
        <Setter Property="Background" Value="{StaticResource BrsSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrsMenuInk}" />
        <Setter Property="BorderThickness" Value="0,0,0,4" />
        <Setter Property="Padding" Value="40,32,40,32" />
    </Style>

    <!-- The paint sits in a canvas, which never reports the size of its children, so the paint cannot stretch the dialog. -->
    <Style x:Key="StyLobbyDialog" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Padding" Value="40,32,40,32" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <ctl:PixelBorder Style="{StaticResource StyLobbyDialogCard}" Padding="0">
                        <Grid>
                            <Canvas>
                                <ctl:PaintedBackground BlockResolution="200" PatternScale="1.45"
                                                        Width="{Binding ActualWidth,
                                                                RelativeSource={RelativeSource AncestorType=Canvas}}"
                                                        Height="{Binding ActualHeight,
                                                                 RelativeSource={RelativeSource AncestorType=Canvas}}"
                                                        DeepColour="{StaticResource ClrMenuLiquidDeep}"
                                                        MidColour="{StaticResource ClrMenuLiquidMid}"
                                                        GlowColour="{StaticResource ClrMenuLiquidGlow}" />
                            </Canvas>
                            <Border Background="{StaticResource BrsMenuPanel}" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Grid>
                    </ctl:PixelBorder>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StyLobbyWordmark" TargetType="TextBlock" BasedOn="{StaticResource StyLogoWordmark}">
        <Setter Property="FontSize" Value="40" />
        <Setter Property="Foreground" Value="{StaticResource BrsMenuLight}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StyLobbyTagline" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource BrsMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="14,6,0,0" />
    </Style>

    <!-- The two plain options of the header are text because the prototype draws them that way. -->
    <Style x:Key="StyLobbyNavButton" TargetType="Button" BasedOn="{StaticResource StyCardTextButton}">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource BrsBody}" />
        <Setter Property="Height" Value="50" />
        <Setter Property="Margin" Value="0,0,22,0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource BrsTitle}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StyLobbyActionButton" TargetType="Button" BasedOn="{StaticResource StyCardPrimaryButton}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="MinWidth" Value="180" />
    </Style>

    <Style x:Key="StyLobbySecondaryButton" TargetType="Button" BasedOn="{StaticResource StyCardOutlineButton}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Height" Value="50" />
        <Setter Property="MinWidth" Value="160" />
    </Style>

    <Style x:Key="StyRailButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="64" />
        <Setter Property="Height" Value="64" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" ctl:PixelShapeCommon.CornerSteps="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrsMenuChipFaceOver}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StyRailIcon" TargetType="Image">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
    </Style>

    <!-- This is the avatar the prototype draws for a player without a picture (CU-28 EX-04). -->
    <Style x:Key="StyAvatar" TargetType="Border">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Background" Value="{StaticResource BrsFieldFace}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrsMuted}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style x:Key="StyAvatarLarge" TargetType="Border" BasedOn="{StaticResource StyAvatar}">
        <Setter Property="Width" Value="64" />
        <Setter Property="Height" Value="64" />
        <Setter Property="CornerRadius" Value="32" />
    </Style>

    <Style x:Key="StyAvatarSmall" TargetType="Border" BasedOn="{StaticResource StyAvatar}">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>

    <Style x:Key="StyAvatarIcon" TargetType="Image">
        <Setter Property="Source" Value="{StaticResource IcoUserLight}" />
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
    </Style>

    <Style x:Key="StyAvatarIconLarge" TargetType="Image" BasedOn="{StaticResource StyAvatarIcon}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
    </Style>

    <Style x:Key="StyAvatarIconSmall" TargetType="Image" BasedOn="{StaticResource StyAvatarIcon}">
        <Setter Property="Width" Value="13" />
        <Setter Property="Height" Value="13" />
    </Style>

    <Style x:Key="StyPresenceDot" TargetType="Ellipse">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Fill" Value="{StaticResource BrsPresenceOnline}" />
        <Setter Property="Stroke" Value="{StaticResource BrsLobbyRail}" />
        <Setter Property="StrokeThickness" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <!-- Every rank letter has its own colour so a rank is told apart at a glance.
         The brick and the umber are lighter than their names because a darker letter would sink into the dark face. -->
    <SolidColorBrush x:Key="BrsRankS" Color="#FFE0B04A" />
    <SolidColorBrush x:Key="BrsRankA" Color="#FF7FC29B" />
    <SolidColorBrush x:Key="BrsRankB" Color="#FF6FA3B8" />
    <SolidColorBrush x:Key="BrsRankC" Color="#FFC98A4B" />
    <SolidColorBrush x:Key="BrsRankD" Color="#FF9C9A8E" />
    <SolidColorBrush x:Key="BrsRankE" Color="#FFD46E55" />
    <SolidColorBrush x:Key="BrsRankF" Color="#FFA8866A" />
    <SolidColorBrush x:Key="BrsRankFace" Color="#FF1F1711" />

    <!-- The letter is drawn at 16 pixels because the pixel font uses a grid of sixteen, so no row of the letter blurs.
         Every side of the badge is a whole number of blocks so no step falls between two pixels.
         A letter outside the catalogue of ranks keeps the neutral frame. -->
    <ControlTemplate x:Key="TplRankBadge" TargetType="Label">
        <Grid>
            <Border Height="{TemplateBinding Width}" VerticalAlignment="Bottom"
                    Background="{TemplateBinding Background}"
                    ctl:PixelShapeCommon.CornerSteps="4"
                    ctl:PixelShapeCommon.PixelUnit="{TemplateBinding ctl:PixelShapeCommon.PixelUnit}">
                <Border Background="{StaticResource BrsMenuInk}" Opacity="0.5" />
            </Border>
            <Border Height="{TemplateBinding Width}" VerticalAlignment="Top"
                    Background="{TemplateBinding Background}" Padding="{TemplateBinding BorderThickness}"
                    ctl:PixelShapeCommon.CornerSteps="4"
                    ctl:PixelShapeCommon.PixelUnit="{TemplateBinding ctl:PixelShapeCommon.PixelUnit}">
                <Border Background="{StaticResource BrsRankFace}"
                        ctl:PixelShapeCommon.CornerSteps="2"
                        ctl:PixelShapeCommon.PixelUnit="{TemplateBinding ctl:PixelShapeCommon.PixelUnit}">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                   Foreground="{TemplateBinding Background}" Opacity="0.4"
                                   VerticalAlignment="Top" Margin="{TemplateBinding Padding}" />
                        <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                   Foreground="{TemplateBinding Background}" VerticalAlignment="Top" />
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </ControlTemplate>

    <Style x:Key="StyRankBadge" TargetType="Label">
        <Setter Property="Template" Value="{StaticResource TplRankBadge}" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="33" />
        <Setter Property="BorderThickness" Value="3" />
