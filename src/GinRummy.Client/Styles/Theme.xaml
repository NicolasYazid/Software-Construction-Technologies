    <!-- The rule sits above each item and the first one is hidden, because the last item changes with the kind of player.
         The menu carries its own templates because the menu of the system draws a light chrome. -->
    <Style x:Key="StyPlayerMenuItem" TargetType="MenuItem">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Foreground" Value="{StaticResource BrsBody}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="16,10,26,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                            BorderBrush="{StaticResource BrsLobbyRule}" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal">
                            <ContentPresenter ContentSource="Icon" Width="16" Height="16"
                                              Margin="0,0,12,0" VerticalAlignment="Center" />
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{StaticResource BrsHighlightGlass}" />
                <Setter Property="Foreground" Value="{StaticResource BrsMenuLight}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Challenging is the action the menu exists for, so it takes the face of the titles.
         A guest plays only through the search for a match, so it cannot be challenged (CU-23). -->
    <Style x:Key="StyPlayerMenuChallengeItem" TargetType="MenuItem" BasedOn="{StaticResource StyPlayerMenuItem}">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsGuest}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Reporting is the only action of the menu of a message, so its item takes the face of the titles. -->
    <Style x:Key="StyMessageMenuItem" TargetType="MenuItem" BasedOn="{StaticResource StyPlayerMenuItem}">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
    </Style>

    <!-- Only a friend can be removed and only someone who is not a friend can receive a request (CU-12, CU-16). -->
    <Style x:Key="StyPlayerMenuFriendItem" TargetType="MenuItem" BasedOn="{StaticResource StyPlayerMenuItem}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsFriend}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Once the request is sent, the option stays as the mark of a pending request so a second one cannot be sent (CU-12 EX-07).
         A guest cannot have friends, so it receives no request (CU-12 FA-03). -->
    <Style x:Key="StyPlayerMenuStrangerItem" TargetType="MenuItem" BasedOn="{StaticResource StyPlayerMenuItem}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsFriend}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsGuest}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HasPendingRequest}" Value="True">
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="Foreground" Value="{StaticResource BrsMuted}" />
                <Setter Property="Cursor" Value="Arrow" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StyPendingRequestMark" TargetType="Image">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Opacity" Value="0.6" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasPendingRequest}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- This shadow is shorter because the one of the panels is too wide for a small menu.
         The margin gives it room because the popup cuts anything drawn beyond its bounds. -->
    <DropShadowEffect x:Key="EfxPlayerMenuShadow" Color="#FF0A130E"
                      BlurRadius="20" ShadowDepth="8" Direction="270" Opacity="0.9" />

    <Style x:Key="StyPlayerMenu" TargetType="ContextMenu">
        <Setter Property="ItemContainerStyle" Value="{StaticResource StyPlayerMenuItem}" />
        <Setter Property="HasDropShadow" Value="False" />
        <!-- The offsets undo the margin left for the shadow so the menu still opens at the pointer. -->
        <Setter Property="HorizontalOffset" Value="-20" />
        <Setter Property="VerticalOffset" Value="-12" />
        <Setter Property="Template">
            <Setter.Value>
                <!-- The inner border carries no padding so a lit first or last item fills the face up to its stepped corners.
                     The margin of -1 lines it up with the base PixelBorder draws, so both outlines share the same blocks. -->
                <ControlTemplate TargetType="ContextMenu">
                    <ctl:PixelBorder Style="{StaticResource StyLobbyGlassCard}" MinWidth="260" Margin="20,12,20,28"
                                     Effect="{StaticResource EfxPlayerMenuShadow}">
                        <Border Background="Transparent" Margin="0,0,0,-1"
                                ctl:PixelShapeCommon.CornerSteps="4">
                            <Grid ClipToBounds="True">
                                <StackPanel IsItemsHost="True" Margin="0,-1,0,0" />
                            </Grid>
                        </Border>
                    </ctl:PixelBorder>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The lists carry their own bar because the bar of the system draws a light chrome over the dark panels.
         PART_Track is the name the framework requires. -->
    <SolidColorBrush x:Key="BrsScrollThumb" Color="#FF3D433B" />

    <Style x:Key="StyScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{StaticResource BrsScrollThumb}"
                            ctl:PixelShapeCommon.PixelUnit="2" ctl:PixelShapeCommon.CornerSteps="1" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{StaticResource BrsMenuInk}"
                            ctl:PixelShapeCommon.PixelUnit="2" ctl:PixelShapeCommon.CornerSteps="1">
                        <Track x:Name="PART_Track" IsDirectionReversed="True"
                               Orientation="{TemplateBinding Orientation}">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource StyScrollThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="8" />
                <Setter Property="MinHeight" Value="8" />
            </Trigger>
        </Style.Triggers>
    </Style>

