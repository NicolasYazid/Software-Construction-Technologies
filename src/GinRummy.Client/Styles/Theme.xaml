                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border Width="22" Height="22" Padding="2" VerticalAlignment="Center"
                                Background="{StaticResource BrsCheckBorder}"
                                ctl:PixelShapeCommon.PixelUnit="2" ctl:PixelShapeCommon.CornerSteps="4">
                            <Border Background="{TemplateBinding Background}"
                                    ctl:PixelShapeCommon.PixelUnit="2" ctl:PixelShapeCommon.CornerSteps="3">
                                <Border Width="10" Height="10" Background="{StaticResource BrsMenuLight}"
                                        ctl:PixelShapeCommon.PixelUnit="2" ctl:PixelShapeCommon.CornerSteps="1"
                                        Visibility="{TemplateBinding IsChecked,
