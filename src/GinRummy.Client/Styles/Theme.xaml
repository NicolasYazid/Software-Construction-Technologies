<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:GinRummy.Client.Converters"
                    xmlns:ctl="clr-namespace:GinRummy.Client.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Styles/Icons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <conv:EmptyTextToVisibilityConverter x:Key="CnvEmptyTextToVisibility" />
    <conv:UpperCaseConverter x:Key="CnvUpperCase" />
    <BooleanToVisibilityConverter x:Key="CnvBooleanToVisibility" />
    <conv:LocalizedFormatConverter x:Key="CnvLocalizedFormat" />
    <conv:CultureNumberConverter x:Key="CnvCultureNumber" />
    <conv:CardRankConverter x:Key="CnvCardRank" />
    <conv:CardNameConverter x:Key="CnvCardName" />
    <conv:MatchLogConverter x:Key="CnvMatchLog" />

    <!-- ============================================================
         Design tokens of the client. The Figma prototype was the
         starting point; from version 2 on, the design is a decision
         of the team and lives here, not in the Figma file.
         ============================================================ -->

    <!-- Cairopixel is the only family of the three that covers the accents, the enye and the
         inverted marks that STK-13 asks for, so the other two name it as the next family in
         the list and WPF resolves every missing glyph there. RetroByte in particular carries
         no accented vowel, so the Spanish labels of the bar are drawn by both families at
         once, which is visible: its capitals measure 0.56 of the em against the 0.44 of
         Cairopixel. -->
    <FontFamily x:Key="FntDisplay">pack://application:,,,/Fonts/#RetroByte, pack://application:,,,/Fonts/#Cairopixel</FontFamily>
    <FontFamily x:Key="FntBody">pack://application:,,,/Fonts/#Cairopixel</FontFamily>
    <FontFamily x:Key="FntBrand">pack://application:,,,/Fonts/#HigherPixels, pack://application:,,,/Fonts/#Cairopixel</FontFamily>

    <SolidColorBrush x:Key="BrsMenuRoot" Color="#FF103A28" />
    <SolidColorBrush x:Key="BrsMenuArtwork" Color="#FFE9E9E9" />
    <SolidColorBrush x:Key="BrsMenuEdge" Color="#73FFFFFF" />
    <SolidColorBrush x:Key="BrsMenuPrimary" Color="#FF8E8E93" />
    <SolidColorBrush x:Key="BrsOutline" Color="#FF333333" />
    <SolidColorBrush x:Key="BrsLogo" Color="#FF8E8E93" />
    <SolidColorBrush x:Key="BrsLogoMark" Color="#FF3B3B3B" />

    <!-- Background of the main menu (P01). These are Color and not SolidColorBrush because
         the control blends them channel by channel on every frame. -->
    <Color x:Key="ClrMenuLiquidDeep">#FF072118</Color>
    <Color x:Key="ClrMenuLiquidMid">#FF1E6746</Color>
    <Color x:Key="ClrMenuLiquidGlow">#FF6AD29A</Color>
    <!-- Palette of the menu. The names describe the role and not the colour, so that
         changing the palette does not force renaming anything. -->
    <SolidColorBrush x:Key="BrsMenuInk" Color="#0B0D0C" />
    <SolidColorBrush x:Key="BrsMenuPanel" Color="#801A1712" />
    <!-- The side chips carry their own brush and not the one of the bar: they are much
         smaller, so at the same alpha the background reads through them more strongly and
         they lose body. -->
    <SolidColorBrush x:Key="BrsMenuChipPanel" Color="#BF1A1712" />
    <SolidColorBrush x:Key="BrsMenuAccent" Color="#FF8B2C1F" />
    <SolidColorBrush x:Key="BrsMenuAction" Color="#FF3B3F2F" />
    <SolidColorBrush x:Key="BrsMenuEarth" Color="#FF4B3B2A" />
    <SolidColorBrush x:Key="BrsMenuNeutral" Color="#FF2C2E30" />
    <SolidColorBrush x:Key="BrsMenuWarn" Color="#FF6B2E2F" />
    <SolidColorBrush x:Key="BrsMenuSettings" Color="#FF2F4B55" />
    <!-- Colour of what is chosen or is the player's own: the row of the player, an option
         under the pointer, a switch that is on. A deep green of the room, quiet beside the
         browns and light enough under the light text. -->
    <SolidColorBrush x:Key="BrsHighlight" Color="#FF2F5A43" />
    <!-- The same green as glass, for a highlight that spans a whole row over the paint, so the
         room keeps showing through it like it does through the panels. -->
    <SolidColorBrush x:Key="BrsHighlightGlass" Color="#992F5A43" />
    <SolidColorBrush x:Key="BrsMenuChipFaceOver" Color="#FF442F1C" />
    <SolidColorBrush x:Key="BrsMenuLight" Color="#FFEDE4DC" />
    <SolidColorBrush x:Key="BrsMenuOnDark" Color="#FFFFFFFF" />

    <!-- Shadows shared by the elements of the menu. -->
    <DropShadowEffect x:Key="EfxPanelShadow" Color="#FF0A130E"
                      BlurRadius="40" ShadowDepth="13" Direction="270" Opacity="0.92" />
    <DropShadowEffect x:Key="EfxTextShadow" Color="#FF0A130E"
                      BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.95" />
    <DropShadowEffect x:Key="EfxSoftShadow" Color="#FF0A130E"
                      BlurRadius="6" ShadowDepth="2" Direction="270" Opacity="0.9" />
    <!-- The cards that float over the messages of the chat cast the shadow of the panels a
         little darker and with a shorter blur, so it stays visible over the moving list. -->
    <DropShadowEffect x:Key="EfxFloatShadow" Color="#FF0A130E"
                      BlurRadius="30" ShadowDepth="13" Direction="270" Opacity="0.98" />
    <DropShadowEffect x:Key="EfxCardShadow" Color="#FF0A130E"
                      BlurRadius="10" ShadowDepth="5" Direction="270" Opacity="0.7" />

    <!-- Raised text. The blur is zero on purpose: a blurred shadow reads as a light source
         behind the letter, while an offset copy with a hard edge reads as the same extruded
         face the buttons of the menu already have. The colour is the one of their base, so
         the letter appears carved from the same block. -->
    <DropShadowEffect x:Key="EfxTextRaise" Color="#0B0D0C"
                      BlurRadius="0" ShadowDepth="3" Direction="270" Opacity="0.7" />
    <DropShadowEffect x:Key="EfxTextRaiseSmall" Color="#0B0D0C"
                      BlurRadius="0" ShadowDepth="2" Direction="270" Opacity="0.7" />

    <!-- The rest of the screens were born from the light prototype and keep their own token
         names, but the values now point at the palette of the menu so that the whole client
         reads as one product. Every one of those screens takes its colour from a token, so
         moving the values here is what carries the design across without touching them.
         The page and the card share one opaque, muted brown, so every screen with a brown
         background shows the same brown. A translucent card read as grey over the white of a
         new window and as green over the page. -->
    <Color x:Key="ClrBrownBackground">#FF1C1814</Color>
    <SolidColorBrush x:Key="BrsPageBackground" Color="{StaticResource ClrBrownBackground}" />
    <SolidColorBrush x:Key="BrsSurface" Color="{StaticResource ClrBrownBackground}" />
    <SolidColorBrush x:Key="BrsArtworkPanel" Color="#FF0C2B1E" />
    <SolidColorBrush x:Key="BrsArtworkLogo" Color="#FF1E6746" />

    <!-- The three greens the side panel is painted with. They turn around the solid colour the
         panel used to be: the first is that green darkened, the second is the one the liquid of
         the menu already carries, and the third is its light. -->
    <Color x:Key="ClrArtworkDeep">#FF06180F</Color>
    <Color x:Key="ClrArtworkMid">#FF1E6746</Color>
    <Color x:Key="ClrArtworkGlow">#FF6AD29A</Color>
    <SolidColorBrush x:Key="BrsTitle" Color="#FFEDE4DC" />
    <SolidColorBrush x:Key="BrsBody" Color="#FFD8CCC0" />
    <SolidColorBrush x:Key="BrsMuted" Color="#FFA68F7C" />
    <SolidColorBrush x:Key="BrsFieldBorder" Color="#FF0B0D0C" />
    <SolidColorBrush x:Key="BrsFieldFace" Color="#FF362B22" />
    <SolidColorBrush x:Key="BrsPrimary" Color="#FF8B2C1F" />
    <SolidColorBrush x:Key="BrsCheckBorder" Color="#FFA68F7C" />
    <SolidColorBrush x:Key="BrsDanger" Color="#FFE08A6A" />

    <!-- Second generation of screens of the prototype: P04, P06, P07 and P08 -->
    <SolidColorBrush x:Key="BrsPlainTitle" Color="#FFEDE4DC" />
    <SolidColorBrush x:Key="BrsPlainMuted" Color="#FFA68F7C" />
    <SolidColorBrush x:Key="BrsPlainBorder" Color="#FF0B0D0C" />
    <SolidColorBrush x:Key="BrsPlainPrimary" Color="#FF3B3F2F" />

    <!-- ======================= Main menu (P01) ======================== -->

    <!-- The wordmark is the only place that uses FntBrand, and the weight stays normal
         on every pixel family: none of them ships a bold face, and the weight WPF
         synthesises thickens the strokes by a fraction of a pixel, which blurs the
         square edges the typeface is chosen for. -->
    <Style x:Key="StyLogoWordmark" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntBrand}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="128" />
        <Setter Property="Foreground" Value="{StaticResource BrsLogo}" />
    </Style>

    <Style x:Key="StyTagline" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource BrsBody}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Button of the menu: a face raised over its own shadow, stepped corners and a sink
         when it is pressed. Each variant sets the colour. The face and the highlight react
         through styles of their own that read the state of the button, instead of template
         triggers aimed at them by name, so that no part of the template needs a name outside
         the prefix vocabulary of the standard. -->
    <ControlTemplate x:Key="TplMenuButton" TargetType="Button">
        <Grid>
            <ctl:CtlPixelSurface Margin="0,6,0,0"
                                 FaceBrush="{StaticResource BrsMenuInk}" />
            <ctl:CtlPixelSurface FaceBrush="{TemplateBinding Background}">
                <ctl:CtlPixelSurface.Style>
                    <Style TargetType="ctl:CtlPixelSurface">
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <Style.Triggers>
                            <!-- The pointer sinks the face one of the two blocks it travels when
                                 pressed, so hovering already answers with movement and the press
                                 still reads as a deeper, separate step. Both distances are whole
                                 blocks, which is what keeps the edge of the face on the grid
                                 while it moves. The trigger of the press is declared after this
                                 one and therefore wins while both apply. -->
                            <DataTrigger Binding="{Binding IsMouseOver,
                                                   RelativeSource={RelativeSource TemplatedParent}}"
                                         Value="True">
                                <Setter Property="Margin" Value="0,3,0,3" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPressed,
                                                   RelativeSource={RelativeSource TemplatedParent}}"
                                         Value="True">
                                <Setter Property="Margin" Value="0,6,0,0" />
                            </DataTrigger>
                            <!-- A button that cannot be used stays sunk as if it were held down,
                                 so it reads as unavailable through the same movement the player
                                 already knows from the press. Declared last, it wins over the
                                 pointer triggers. -->
                            <DataTrigger Binding="{Binding IsEnabled,
                                                   RelativeSource={RelativeSource TemplatedParent}}"
                                         Value="False">
                                <Setter Property="Margin" Value="0,6,0,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ctl:CtlPixelSurface.Style>
                <Grid>
                    <!-- The highlight covers the whole face and takes its same stepped shape, so
                         that no square corners appear over the steps when it darkens. It sits
                         beside the content and not around it: being a layer with zero opacity
                         while there is no pointer, wrapping the content made it invisible too.
                         The side padding comes from the content and not from the surface,
                         because with padding on the surface the layer stayed inside it and
                         left a strip on each side without darkening. -->
                    <ctl:CtlPixelSurface FaceBrush="{StaticResource BrsMenuInk}">
                        <ctl:CtlPixelSurface.Style>
                            <Style TargetType="ctl:CtlPixelSurface">
                                <Setter Property="Opacity" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver,
                                                           RelativeSource={RelativeSource TemplatedParent}}"
                                                 Value="True">
                                        <Setter Property="Opacity" Value="0.53" />
                                    </DataTrigger>
                                    <!-- The unavailable button keeps the darkening of the pointer
                                         as well as the sink of the press, since a disabled
                                         control never receives the pointer to show it. -->
                                    <DataTrigger Binding="{Binding IsEnabled,
                                                           RelativeSource={RelativeSource TemplatedParent}}"
                                                 Value="False">
                                        <Setter Property="Opacity" Value="0.53" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ctl:CtlPixelSurface.Style>
                    </ctl:CtlPixelSurface>
                    <ContentPresenter Margin="14,0,14,0"
                                      Effect="{StaticResource EfxTextRaise}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </ctl:CtlPixelSurface>
        </Grid>
    </ControlTemplate>

    <!-- Every button of the upper row carries this size and every button of the lower row
         carries the one of StyMenuSmallButton, so each row reads as a single block. The
         emphasis of the primary button is its colour and no longer its size.
         RetroByte draws its capitals at 0.56 of the em, so it reads smaller than the number
         of the size suggests. The width of the bar is bounded by the longest label of the
         row, because the three columns share one size group: at this size that label
         measures 311 of the 334 that fit beside the two chips, which is why growing this
         number means widening the window first. -->
    <Style x:Key="StyMenuButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="Foreground" Value="{StaticResource BrsMenuLight}" />
        <Setter Property="Background" Value="{StaticResource BrsMenuAction}" />
        <Setter Property="Height" Value="72" />
        <Setter Property="MinWidth" Value="230" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template" Value="{StaticResource TplMenuButton}" />
    </Style>

    <Style x:Key="StyMenuSmallButton" TargetType="Button" BasedOn="{StaticResource StyMenuButton}">
        <Setter Property="FontSize" Value="27" />
        <Setter Property="Height" Value="58" />
        <Setter Property="MinWidth" Value="200" />
    </Style>

    <Style x:Key="StyMenuSmallAltButton" TargetType="Button" BasedOn="{StaticResource StyMenuSmallButton}">
        <Setter Property="Foreground" Value="{StaticResource BrsMenuLight}" />
        <Setter Property="Background" Value="{StaticResource BrsMenuWarn}" />
    </Style>

    <!-- The primary button keeps the size of its row and stands out by colour alone. -->
    <Style x:Key="StyMenuPrimaryButton" TargetType="Button" BasedOn="{StaticResource StyMenuButton}">
        <Setter Property="Foreground" Value="{StaticResource BrsMenuLight}" />
        <Setter Property="Background" Value="{StaticResource BrsMenuAccent}" />
    </Style>

    <!-- The panels take the same stepped surface as the buttons, with a corner of more blocks
         because they are larger themselves: a panel of this size with the corner of a button
         reads as square. They are raised over a base of the same shape, which is what gives
         them their depth now that they carry no border, and they keep the translucent colour,
         so the paint of the background still shows through them. -->
    <Style x:Key="StyMenuBar" TargetType="ctl:CtlPixelSurface">
        <Setter Property="FaceBrush" Value="{StaticResource BrsMenuPanel}" />
        <Setter Property="BaseBrush" Value="{StaticResource BrsMenuInk}" />
        <Setter Property="BaseDepth" Value="4" />
        <Setter Property="CornerSteps" Value="6" />
        <Setter Property="Padding" Value="14,14,14,14" />
        <Setter Property="Effect" Value="{StaticResource EfxPanelShadow}" />
    </Style>

    <Style x:Key="StyMenuChip" TargetType="ctl:CtlPixelSurface">
        <Setter Property="FaceBrush" Value="{StaticResource BrsMenuChipPanel}" />
        <Setter Property="BaseBrush" Value="{StaticResource BrsMenuInk}" />
        <Setter Property="BaseDepth" Value="3" />
        <Setter Property="CornerSteps" Value="5" />
        <Setter Property="Padding" Value="14,12,14,14" />
        <Setter Property="Effect" Value="{StaticResource EfxPanelShadow}" />
    </Style>

    <!-- The settings chip holds a real button, so it takes the raised face of the buttons of
         the bar and not the flat inset of the language selector beside it. -->
    <Style x:Key="StyMenuChipButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="{StaticResource BrsMenuSettings}" />
        <Setter Property="Height" Value="50" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template" Value="{StaticResource TplMenuButton}" />
        <Style.Triggers>
            <!-- The hand promises a click; an unavailable button gives the plain arrow back. -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The selector and its list take the display family, the one the buttons of the bar
         carry, because they sit in the same panel and read as part of the same control. An
         option of the list answers like a button pressed: the pointer darkens it with the ink
         of the menu and drops its name one block, and the option already chosen stays that way,
         so the list reads as a set of keys of which one is held down. -->
    <Style x:Key="StyMenuLanguageItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource BrsMenuLight}" />
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid Background="Transparent">
                        <Border Background="{StaticResource BrsMenuInk}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Opacity" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected,
                                                               RelativeSource={RelativeSource TemplatedParent}}"
                                                     Value="True">
                                            <Setter Property="Opacity" Value="0.53" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsHighlighted,
                                                               RelativeSource={RelativeSource TemplatedParent}}"
                                                     Value="True">
                                            <Setter Property="Opacity" Value="0.53" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <ContentPresenter Effect="{StaticResource EfxTextRaiseSmall}" VerticalAlignment="Center">
                            <ContentPresenter.Style>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Margin" Value="12,8,12,8" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected,
                                                               RelativeSource={RelativeSource TemplatedParent}}"
                                                     Value="True">
                                            <Setter Property="Margin" Value="12,11,12,5" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsHighlighted,
                                                               RelativeSource={RelativeSource TemplatedParent}}"
                                                     Value="True">
                                            <Setter Property="Margin" Value="12,11,12,5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentPresenter.Style>
                        </ContentPresenter>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The ComboBox of the system draws its own light background and ignores Background,
         so the selector carries a template of its own. It is a button of the menu in the brown
         of the fields: a face raised two blocks over its ink base, which the pointer sinks one
         block and darkens. While the list is open the face stays sunk and darkened, as a button
         held down, and grows one base deeper than the selector so that its lower corners are
         cut square by the edge; the list opens right below that edge, square at its top and
         stepped at its bottom, so the button and the list read as a single piece. The icon is
         taken from Tag, which the selectors of the language fill with the globe and the one of
         the platform leaves empty. PART_Popup is the name the framework requires, not a naming
         choice. -->
    <Style x:Key="StyMenuLanguageBox" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource BrsMenuLight}" />
        <Setter Property="Background" Value="{StaticResource BrsFieldFace}" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource StyMenuLanguageItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid ClipToBounds="True">
                        <ctl:CtlPixelSurface Margin="0,6,0,0" FaceBrush="{StaticResource BrsMenuInk}" />
                        <ctl:CtlPixelSurface FaceBrush="{TemplateBinding Background}">
                            <ctl:CtlPixelSurface.Style>
                                <Style TargetType="ctl:CtlPixelSurface">
                                    <Setter Property="Margin" Value="0,0,0,6" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver,
                                                               RelativeSource={RelativeSource TemplatedParent}}"
                                                     Value="True">
                                            <Setter Property="Margin" Value="0,3,0,3" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDropDownOpen,
                                                               RelativeSource={RelativeSource TemplatedParent}}"
                                                     Value="True">
                                            <Setter Property="Margin" Value="0,6,0,-6" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ctl:CtlPixelSurface.Style>
                            <Grid>
                                <ctl:CtlPixelSurface FaceBrush="{StaticResource BrsMenuInk}">
                                    <ctl:CtlPixelSurface.Style>
                                        <Style TargetType="ctl:CtlPixelSurface">
                                            <Setter Property="Opacity" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver,
                                                                       RelativeSource={RelativeSource TemplatedParent}}"
                                                             Value="True">
                                                    <Setter Property="Opacity" Value="0.53" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDropDownOpen,
                                                                       RelativeSource={RelativeSource TemplatedParent}}"
                                                             Value="True">
                                                    <Setter Property="Opacity" Value="0.53" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ctl:CtlPixelSurface.Style>
                                </ctl:CtlPixelSurface>
                                <!-- The selector shows the name of the language written in its
                                     own language, so the widest state is ESPANOL with its tilde,
                                     and the margins leave room for it beside the icon and the
                                     arrow. While the face hangs past the edge, the row keeps out
                                     of the part that is cut, so it stays in the middle of what
                                     shows; the darkening covers the whole face, cut part too. -->
                                <DockPanel LastChildFill="True">
                                    <DockPanel.Style>
                                        <Style TargetType="DockPanel">
                                            <Setter Property="Margin" Value="10,0,10,0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDropDownOpen,
                                                                       RelativeSource={RelativeSource TemplatedParent}}"
                                                             Value="True">
                                                    <Setter Property="Margin" Value="10,0,10,6" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DockPanel.Style>
                                    <Image DockPanel.Dock="Left" Width="17" Height="17" Margin="0,0,6,0"
                                           VerticalAlignment="Center" Source="{TemplateBinding Tag}">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tag,
                                                                           RelativeSource={RelativeSource TemplatedParent}}"
                                                                 Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <Path DockPanel.Dock="Right" Data="M0,0 L8,0 L4,5 Z"
                                          Fill="{StaticResource BrsMenuLight}"
                                          Effect="{StaticResource EfxTextRaiseSmall}"
                                          VerticalAlignment="Center" />
                                    <ContentPresenter Margin="0,0,6,0"
                                                      Effect="{StaticResource EfxTextRaiseSmall}"
                                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                                </DockPanel>
                            </Grid>
                        </ctl:CtlPixelSurface>
                        <!-- The toggle is an invisible layer over the whole selector that opens
                             and closes the list; the drawing beneath reads the state of the
                             selector itself. -->
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False">
                            <Grid ClipToBounds="True"
                                  Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ctl:CtlPixelBorder Margin="0,-6,0,0" Padding="0,6,0,0"
                                                    Background="{StaticResource BrsFieldFace}"
                                                    BorderBrush="{StaticResource BrsMenuInk}" BorderThickness="0,0,0,6"
                                                    ctl:PixelShapeCommon.CornerSteps="4">
                                    <StackPanel IsItemsHost="True" />
                                </ctl:CtlPixelBorder>
                            </Grid>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StyMenuChipCaption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="Foreground" Value="{StaticResource BrsMenuLight}" />
        <Setter Property="Effect" Value="{StaticResource EfxTextRaiseSmall}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StyPanelCaption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource BrsMuted}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- ============== Screens with a card (P02, P03, P05) ============== -->

    <!-- The title of these screens takes the display family, the one the buttons carry, so
         that the heading of a modal reads as part of the same voice as the menu. -->
    <Style x:Key="StyCardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="44" />
        <Setter Property="Margin" Value="0,10,0,0" />
        <Setter Property="Foreground" Value="{StaticResource BrsTitle}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="StyCardSubtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="LineHeight" Value="30" />
        <Setter Property="Foreground" Value="{StaticResource BrsBody}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="StyFieldLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource BrsMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- The field is sunk instead of outlined: the border lives only at the bottom and takes
         the colour of the base of the buttons, which is the same device the chips of the menu
         use. The height stays at fifty because the screens place what follows by fixed
         margins, and changing it would move every row beneath. The stepped corners of the
         buttons are lent to it as a clip, so the field keeps its plain border. -->
    <Style x:Key="StyFieldShell" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrsFieldFace}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrsFieldBorder}" />
        <Setter Property="BorderThickness" Value="0,0,0,4" />
        <Setter Property="ctl:PixelShapeCommon.CornerSteps" Value="4" />
        <Setter Property="Height" Value="50" />
        <Setter Property="Padding" Value="16,0,16,0" />
    </Style>

    <Style x:Key="StyFieldInput" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource BrsBody}" />
        <Setter Property="CaretBrush" Value="{StaticResource BrsBody}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- The mask of the field is stated here because the circle the control draws by default,
         U+25CF, belongs to none of the families of the project, and a character the font does
         not carry is asked of whichever one the system decides to lend. U+2022 is in both. -->
    <Style x:Key="StyFieldPassword" TargetType="PasswordBox">
        <Setter Property="PasswordChar" Value="&#x2022;" />
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource BrsBody}" />
        <Setter Property="CaretBrush" Value="{StaticResource BrsBody}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- The box of the system leaves two pixels before the text, and the caret of an empty
         field stands there over the first column of the letter, so a hint flush with the field
         had its first letter crossed by the caret. The hint starts a few pixels later, past the
         caret and one pixel of air. -->
    <Style x:Key="StyFieldPlaceholder" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource BrsMuted}" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="4,0,0,0" />
    </Style>

    <Style x:Key="StyIconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="19" />
        <Setter Property="Height" Value="19" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.65" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The buttons of these screens borrow the template of the menu, so the raised face, the
         darkening on hover and the sink on press are the same gesture everywhere. What each
         style states is only its colour, its height and the size of its text. -->
    <Style x:Key="StyCardPrimaryButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource BrsMenuLight}" />
        <Setter Property="Background" Value="{StaticResource BrsPrimary}" />
        <Setter Property="Height" Value="50" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template" Value="{StaticResource TplMenuButton}" />
    </Style>

    <Style x:Key="StyCardOutlineButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource BrsMenuLight}" />
        <Setter Property="Background" Value="{StaticResource BrsMenuAction}" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template" Value="{StaticResource TplMenuButton}" />
    </Style>

    <Style x:Key="StyCardTextButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource BrsMuted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource BrsBody}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The height is free so that the line is not cut: a fixed one clipped the descenders of
         the link as soon as the text grew. -->
    <Style x:Key="StyInlineTextButton" TargetType="Button" BasedOn="{StaticResource StyCardTextButton}">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!-- The box carries its own template because the one the system draws keeps its light
         chrome whatever the background is, and over the dark card it disappeared. The box is a
         small button of the menu on a block of two pixels: a face in the brown of the fields
         around it, raised two blocks over its ink base. The pointer sinks it one block and
         darkens it, the press sinks it whole, and once checked it stays sunk as a button held
         down, the same gesture as the tabs, with its face turned to the ink of its base. The
         tick is drawn in blocks of the same grid instead of a stroke, seven blocks across and
         five down, so it sits in the middle of the face with two blocks of room at each side and
         three above and below, and it is raised over the face like the letters of the buttons. -->
    <Style x:Key="StyKeepSignedIn" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource BrsMuted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource BrsFieldFace}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="22" Height="26" VerticalAlignment="Center">
                            <ctl:CtlPixelSurface Margin="0,4,0,0" PixelUnit="2" CornerSteps="2"
                                                 FaceBrush="{StaticResource BrsMenuInk}" />
                            <ctl:CtlPixelSurface PixelUnit="2" CornerSteps="2" FaceBrush="{TemplateBinding Background}">
                                <ctl:CtlPixelSurface.Style>
                                    <Style TargetType="ctl:CtlPixelSurface">
                                        <Setter Property="Margin" Value="0,0,0,4" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver,
                                                                   RelativeSource={RelativeSource TemplatedParent}}"
                                                         Value="True">
                                                <Setter Property="Margin" Value="0,2,0,2" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPressed,
                                                                   RelativeSource={RelativeSource TemplatedParent}}"
                                                         Value="True">
                                                <Setter Property="Margin" Value="0,4,0,0" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsChecked,
                                                                   RelativeSource={RelativeSource TemplatedParent}}"
                                                         Value="True">
                                                <Setter Property="Margin" Value="0,4,0,0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ctl:CtlPixelSurface.Style>
                                <Grid>
                                    <ctl:CtlPixelSurface PixelUnit="2" CornerSteps="2"
                                                         FaceBrush="{StaticResource BrsMenuInk}">
                                        <ctl:CtlPixelSurface.Style>
                                            <Style TargetType="ctl:CtlPixelSurface">
                                                <Setter Property="Opacity" Value="0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver,
                                                                           RelativeSource={RelativeSource TemplatedParent}}"
                                                                 Value="True">
                                                        <Setter Property="Opacity" Value="0.53" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsChecked,
                                                                           RelativeSource={RelativeSource TemplatedParent}}"
                                                                 Value="True">
                                                        <Setter Property="Opacity" Value="0.53" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ctl:CtlPixelSurface.Style>
                                    </ctl:CtlPixelSurface>
                                    <Path Width="14" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Fill="{StaticResource BrsMenuLight}"
                                          Effect="{StaticResource EfxTextRaiseSmall}"
                                          SnapsToDevicePixels="True"
                                          Data="M10,0 H14 V2 H10 Z M8,2 H12 V4 H8 Z M0,4 H4 V6 H0 Z M6,4 H10 V6 H6 Z
                                                M2,6 H8 V8 H2 Z M4,8 H6 V10 H4 Z"
                                          Visibility="{TemplateBinding IsChecked,
                                                       Converter={StaticResource CnvBooleanToVisibility}}" />
                                </Grid>
                            </ctl:CtlPixelSurface>
                        </Grid>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource BrsBody}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource BrsMenuInk}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource BrsMenuInk}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The rule takes the colour of the text it accompanies, not that of the sunk edges:
         against the dark card the ink of the edges was invisible. -->
    <Style x:Key="StyDividerLine" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrsMuted}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StyDividerLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource BrsMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="12,0,12,0" />
    </Style>

    <Style x:Key="StyCardError" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource BrsDanger}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style x:Key="StyCardNotice" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource BrsMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style x:Key="StyTimerLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource BrsMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ========== Screens without a card (P04, P06, P07, P08) ========== -->

    <Style x:Key="StyPlainTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="44" />
        <Setter Property="Margin" Value="0,10,0,0" />
        <Setter Property="Foreground" Value="{StaticResource BrsPlainTitle}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="StyPlainBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource BrsPlainTitle}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="StyPlainLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource BrsPlainMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="StyPlainFieldShell" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrsFieldFace}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrsPlainBorder}" />
        <Setter Property="BorderThickness" Value="0,0,0,4" />
        <Setter Property="ctl:PixelShapeCommon.CornerSteps" Value="4" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Padding" Value="15,0,15,0" />
    </Style>

    <Style x:Key="StyPlainInput" TargetType="TextBox" BasedOn="{StaticResource StyFieldInput}">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource BrsPlainTitle}" />
    </Style>

    <Style x:Key="StyPlainPassword" TargetType="PasswordBox" BasedOn="{StaticResource StyFieldPassword}">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource BrsPlainTitle}" />
    </Style>

    <Style x:Key="StyPlainPlaceholder" TargetType="TextBlock" BasedOn="{StaticResource StyFieldPlaceholder}">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource BrsPlainMuted}" />
    </Style>

    <Style x:Key="StyPlainPrimaryButton" TargetType="Button" BasedOn="{StaticResource StyCardPrimaryButton}">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Height" Value="52" />
        <Setter Property="Background" Value="{StaticResource BrsPlainPrimary}" />
    </Style>

    <Style x:Key="StyPlainTextButton" TargetType="Button" BasedOn="{StaticResource StyCardTextButton}">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource BrsPlainMuted}" />
    </Style>

    <Style x:Key="StyPlainError" TargetType="TextBlock" BasedOn="{StaticResource StyCardError}">
        <Setter Property="FontSize" Value="22" />
    </Style>

    <Style x:Key="StyPlainNotice" TargetType="TextBlock" BasedOn="{StaticResource StyCardNotice}">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource BrsPlainMuted}" />
    </Style>

    <!-- ========== Dialogs and notices (P09, P10, P22, P23, P24, P25) ========== -->

    <!-- The dialogs sit on the page and raise their card over it, one step lighter, the same
         way the screens with a card do. -->
    <Style x:Key="StyDialogCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrsSurface}" />
        <Setter Property="ctl:PixelShapeCommon.CornerSteps" Value="5" />
        <Setter Property="Padding" Value="40,32,40,32" />
    </Style>

    <!-- The title of a dialog is smaller than the one of a card screen because several of
         them name a whole action, and at the size of a card title they broke into three
         lines. -->
    <Style x:Key="StyDialogTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="Foreground" Value="{StaticResource BrsTitle}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="StyDialogMessage" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="LineHeight" Value="28" />
        <Setter Property="Foreground" Value="{StaticResource BrsBody}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Errors and warnings of consequence take the colour of the errors of the forms, as
         the prototype paints them red and leaves plain questions in grey. -->
    <Style x:Key="StyDialogWarning" TargetType="TextBlock" BasedOn="{StaticResource StyDialogMessage}">
        <Setter Property="Foreground" Value="{StaticResource BrsDanger}" />
    </Style>

    <!-- The prototype sets the reason and the remaining time in bold. The pixel families have
         a single weight, so the emphasis is carried by the light colour of the titles. -->
    <Style x:Key="StyDialogEmphasis" TargetType="TextBlock" BasedOn="{StaticResource StyDialogMessage}">
        <Setter Property="Foreground" Value="{StaticResource BrsTitle}" />
    </Style>

    <Style x:Key="StyDialogPrimaryButton" TargetType="Button" BasedOn="{StaticResource StyCardPrimaryButton}">
        <Setter Property="MinWidth" Value="170" />
    </Style>

    <Style x:Key="StyDialogSecondaryButton" TargetType="Button" BasedOn="{StaticResource StyCardOutlineButton}">
        <Setter Property="MinWidth" Value="170" />
        <Setter Property="Height" Value="50" />
    </Style>

    <!-- ============ Lobby and its panels (P11, P12, P13, P16, P17) ============ -->

    <!-- The lobbies stand on the moving paint of the menu. The dark green rings the presence
         dot, so the dot stays apart from the avatar it sits on. -->
    <SolidColorBrush x:Key="BrsLobbyRail" Color="#FF041710" />
    <SolidColorBrush x:Key="BrsLobbyPanel" Color="#FF101C15" />
    <SolidColorBrush x:Key="BrsLobbyRule" Color="#33EDE4DC" />
    <SolidColorBrush x:Key="BrsLobbyRowOver" Color="#1FEDE4DC" />
    <SolidColorBrush x:Key="BrsPresenceOnline" Color="#FF6AD29A" />
    <!-- The fields of the lobbies sit one shade below the face of the switch above them, so the
         raised tabs and the sunk fields read as two different depths of the same brown. -->
    <SolidColorBrush x:Key="BrsLobbyFieldFace" Color="#FF231B14" />
    <SolidColorBrush x:Key="BrsLobbySwitchFace" Color="#FF2A2018" />

    <Style x:Key="StyLobbyPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrsLobbyPanel}" />
        <Setter Property="ctl:PixelShapeCommon.CornerSteps" Value="5" />
    </Style>

    <!-- The panels of the lobbies are the panels of the menu: the same translucent face that
         lets the paint behind show through, the ink base beneath and the same deep shadow. The
         panels and the cards built on them are drawn by CtlPixelBorder, which keeps the base
         under the stepped face; a plain border would paint the base inside the clip and break
         the steps of the lower corners. -->
    <Style x:Key="StyLobbyGlassPanel" TargetType="Border" BasedOn="{StaticResource StyLobbyPanel}">
        <Setter Property="Background" Value="{StaticResource BrsMenuPanel}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrsMenuInk}" />
        <Setter Property="BorderThickness" Value="0,0,0,4" />
        <Setter Property="Effect" Value="{StaticResource EfxPanelShadow}" />
    </Style>

    <!-- The rail is one more panel of the room: it floats with the same gap as the header and
         the side panels, so its shadow has room to fall on the paint like theirs. -->
    <Style x:Key="StyLobbyGlassRail" TargetType="Border" BasedOn="{StaticResource StyLobbyGlassPanel}">
        <Setter Property="Margin" Value="12,12,0,12" />
    </Style>

    <!-- The cards that live inside a panel keep its translucent face and its ink base, but
         cast no shadow: a second shadow inside the panel would darken the messages below it. -->
    <Style x:Key="StyLobbyGlassCard" TargetType="Border" BasedOn="{StaticResource StyLobbyGlassPanel}">
        <Setter Property="ctl:PixelShapeCommon.CornerSteps" Value="4" />
        <Setter Property="Effect" Value="{x:Null}" />
    </Style>

    <!-- The dialogs that open over a lobby, the leaderboard and the profiles, are built like a
         panel of the room, with its stepped corners and its ink base. The face is the brown of
         the dialogs, which the leaderboard and the profiles cover with the paint of the room
         and a small dialog opened inside them keeps as it is. The host already casts the deep
         shadow of the panels around the dialog. -->
    <Style x:Key="StyLobbyDialogCard" TargetType="Border" BasedOn="{StaticResource StyLobbyPanel}">
        <Setter Property="Background" Value="{StaticResource BrsSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrsMenuInk}" />
        <Setter Property="BorderThickness" Value="0,0,0,4" />
        <Setter Property="Padding" Value="40,32,40,32" />
    </Style>

    <!-- The leaderboard and the profiles carry the room inside them: the moving paint of the
         lobby, the glass of its panels over the paint, and their content on the glass, so the
         cards inside them sit on the same two layers as the cards of the lobby. The paint
         sits in a canvas, which never reports the size of its children, so the paint follows
         the size of the dialog instead of stretching it to the size of its bitmap. The Padding
         of the dialog is the margin of its content. -->
    <Style x:Key="StyLobbyDialog" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Padding" Value="40,32,40,32" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <ctl:CtlPixelBorder Style="{StaticResource StyLobbyDialogCard}" Padding="0">
                        <Grid>
                            <Canvas>
                                <ctl:CtlPaintBackground BlockResolution="200" PatternScale="1.45"
                                                        Width="{Binding ActualWidth,
                                                                RelativeSource={RelativeSource AncestorType=Canvas}}"
                                                        Height="{Binding ActualHeight,
                                                                 RelativeSource={RelativeSource AncestorType=Canvas}}"
                                                        DeepColour="{StaticResource ClrMenuLiquidDeep}"
                                                        MidColour="{StaticResource ClrMenuLiquidMid}"
                                                        GlowColour="{StaticResource ClrMenuLiquidGlow}" />
                            </Canvas>
                            <Border Background="{StaticResource BrsMenuPanel}" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Grid>
                    </ctl:CtlPixelBorder>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StyLobbyWordmark" TargetType="TextBlock" BasedOn="{StaticResource StyLogoWordmark}">
        <Setter Property="FontSize" Value="40" />
        <Setter Property="Foreground" Value="{StaticResource BrsMenuLight}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StyLobbyTagline" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource BrsMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="14,6,0,0" />
    </Style>

    <!-- The two plain options of the header are text, as in the prototype, and light up on
         hover like the links of the cards do. -->
    <Style x:Key="StyLobbyNavButton" TargetType="Button" BasedOn="{StaticResource StyCardTextButton}">
        <Setter Property="FontFamily" Value="{StaticResource FntDisplay}" />
        <Setter Property="FontSize" Value="18" />
