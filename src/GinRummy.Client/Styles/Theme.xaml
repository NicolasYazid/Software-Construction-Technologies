    <!-- The context menu of a player takes the sunk face of the fields and lights the item
         under the pointer with the colour of the chips of the menu. The system menu draws a
         light chrome of its own, hence the templates. -->
    <Style x:Key="StyPlayerMenuItem" TargetType="MenuItem">
        <Setter Property="FontFamily" Value="{StaticResource FntBody}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource BrsBody}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="14,8,22,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal">
                            <ContentPresenter ContentSource="Icon" Width="16" Height="16"
                                              Margin="0,0,12,0" VerticalAlignment="Center" />
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{StaticResource BrsMenuChipFace}" />
                <Setter Property="Foreground" Value="{StaticResource BrsMenuLight}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Only a friend can be removed, and only someone who is not a friend yet can receive a
         request (CU-12, CU-16), so each of those items shows for one kind of player alone. -->
    <Style x:Key="StyPlayerMenuFriendItem" TargetType="MenuItem" BasedOn="{StaticResource StyPlayerMenuItem}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsFriend}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Once the request is sent, the option stays in its place as the mark of a pending
         request: dimmed, with the icon of a sent message, and unable to send a second one
         (CU-12 and its EX-07). -->
    <Style x:Key="StyPlayerMenuStrangerItem" TargetType="MenuItem" BasedOn="{StaticResource StyPlayerMenuItem}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsFriend}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HasPendingRequest}" Value="True">
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="Foreground" Value="{StaticResource BrsMuted}" />
                <Setter Property="Cursor" Value="Arrow" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StyPendingRequestMark" TargetType="Image">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Opacity" Value="0.6" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasPendingRequest}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

