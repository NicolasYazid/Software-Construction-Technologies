<UserControl x:Class="GinRummy.Client.Controls.CtlBrandMark"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Lo que se centra es el conjunto y no la diana. Centrar la diana obliga a repartir por
         igual el ancho de las dos palabras, y como una es mucho mas larga que la otra el
         logotipo entero se recuesta contra un lado de la ventana; centrado como bloque los
         margenes quedan iguales, que es como se lee alineado. -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock x:Name="lblBrandFirst" Style="{StaticResource StyLogoWordmark}" VerticalAlignment="Center" />
        <Image x:Name="imgBrandMark" Source="{StaticResource IcoBullseye}" VerticalAlignment="Center" />
        <TextBlock x:Name="lblBrandSecond" Style="{StaticResource StyLogoWordmark}" VerticalAlignment="Center" />
    </StackPanel>
</UserControl>
