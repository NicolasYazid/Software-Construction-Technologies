<UserControl x:Class="GinRummy.Client.Controls.CtlBrandMark"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The whole set is centred and not the target. Centring the target forces the width of
         the two words to be shared equally, and since one is much longer than the other the
         whole wordmark leans against one side of the window; centred as a block, the margins
         come out equal, which is how it reads as aligned. -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock x:Name="lblBrandFirst" Style="{StaticResource StyLogoWordmark}" VerticalAlignment="Center" />
        <Image x:Name="imgBrandMark" Source="{StaticResource IcoBullseye}" VerticalAlignment="Center" />
        <TextBlock x:Name="lblBrandSecond" Style="{StaticResource StyLogoWordmark}" VerticalAlignment="Center" />
    </StackPanel>
</UserControl>
