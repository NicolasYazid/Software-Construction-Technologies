<views:GuiModalBase x:Class="GinRummy.Client.Views.GuiNotifications"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:GinRummy.Client.Controls"
        xmlns:views="clr-namespace:GinRummy.Client.Views"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        HasCloseButton="False">
    <!-- The width matches the sanctions screen because both are tabs of one panel and switching must not move anything. -->
    <Grid Width="780" Background="{StaticResource BrsPageBackground}">
        <Border Style="{StaticResource StyDialogCard}" Padding="0">
            <StackPanel>

                <DockPanel Margin="32,22,22,18">
                    <Button DockPanel.Dock="Right" Style="{StaticResource StyDialogCloseButton}" Click="OnCloseClick">
                        <Image Source="{StaticResource IcoClose}" Width="24" Height="24" />
                    </Button>
                    <TextBlock x:Name="lblTitle" Style="{StaticResource StyPanelTitle}"
                               Text="{Binding [Notifications_LblTitle], Source={StaticResource PrvLocalization},
                                      Converter={StaticResource CnvUpperCase}}" />
                </DockPanel>

                <TabControl Style="{StaticResource StyPanelTabs}" SelectionChanged="OnTabSelectionChanged">
                    <TabItem x:Name="tabFriendRequests" IsSelected="True"
                             Header="{Binding [Notifications_TabFriendRequests], Source={StaticResource PrvLocalization},
                                      Converter={StaticResource CnvUpperCase}}" />
                    <TabItem x:Name="tabSanctions"
                             Header="{Binding [Notifications_TabSanctions], Source={StaticResource PrvLocalization},
                                      Converter={StaticResource CnvUpperCase}}" />
                </TabControl>

                <ctl:PixelBorder x:Name="pnlResponseNotice" Style="{StaticResource StyLobbyStatusCard}" Margin="32,12,32,0"
                        Visibility="{Binding HasNotice, Converter={StaticResource CnvBooleanToVisibility}}">
                    <DockPanel LastChildFill="True">
                        <Button x:Name="btnDismissResponseNotice" DockPanel.Dock="Right" Style="{StaticResource StyNoticeButton}"
                                VerticalAlignment="Center"
                                Content="{Binding [Shared_BtnClose], Source={StaticResource PrvLocalization},
                                          Converter={StaticResource CnvUpperCase}}"
                                Command="{Binding DismissNoticeCommand}" />
                        <TextBlock x:Name="lblResponseNotice" Style="{StaticResource StyStatusTitle}" VerticalAlignment="Center">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource CnvResourceText}">
                                    <Binding Path="NoticeKey" />
                                    <Binding Path="CurrentCulture" Source="{StaticResource PrvLocalization}" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DockPanel>
                </ctl:PixelBorder>

                <ScrollViewer Height="420" VerticalScrollBarVisibility="Auto" Margin="32,12,22,24">
                    <StackPanel Margin="0,0,10,0">
                        <ItemsControl x:Name="lstFriendRequests" ItemsSource="{Binding FriendRequests}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StyRequestRow}">
                                        <DockPanel LastChildFill="True">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button x:Name="btnAccept" Style="{StaticResource StyNoticePrimaryButton}"
                                                        Content="{Binding [Shared_BtnAccept], Source={StaticResource PrvLocalization},
                                                                  Converter={StaticResource CnvUpperCase}}"
                                                        Command="{Binding DataContext.AcceptRequestCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button x:Name="btnDecline" Style="{StaticResource StyNoticeButton}"
                                                        Content="{Binding [Shared_BtnDecline], Source={StaticResource PrvLocalization},
                                                                  Converter={StaticResource CnvUpperCase}}"
                                                        Command="{Binding DataContext.DeclineRequestCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                            <Border Style="{StaticResource StyAvatar}">
                                                <Image Style="{StaticResource StyAvatarIcon}" />
                                            </Border>
                                            <TextBlock x:Name="lblFriendRequest" Style="{StaticResource StyRequestText}">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource CnvLocalizedFormat}">
                                                        <Binding Path="[Notifications_LblFriendRequest]"
                                                                 Source="{StaticResource PrvLocalization}" />
                                                        <Binding Path="RequesterUsername" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="lblNoPendingRequests" Style="{StaticResource StyPanelEmpty}"
                                   Visibility="{Binding HasNoPendingRequests, Converter={StaticResource CnvBooleanToVisibility}}"
                                   Text="{Binding [Notifications_NoPendingRequests], Source={StaticResource PrvLocalization}}" />
                    </StackPanel>
                </ScrollViewer>

            </StackPanel>
        </Border>
    </Grid>
</views:GuiModalBase>
