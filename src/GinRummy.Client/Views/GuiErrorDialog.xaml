<views:GuiModalBase x:Class="GinRummy.Client.Views.GuiErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GinRummy.Client.Views"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        ShowsCloseButton="False">
    <Grid Width="540" Background="{StaticResource BrsPageBackground}">
        <Border Style="{StaticResource StyDialogCard}">
            <StackPanel>

                <Image Source="{StaticResource IcoAlert}" Width="48" Height="48" HorizontalAlignment="Center" />

                <TextBlock x:Name="lblTitle" Style="{StaticResource StyDialogTitle}" Margin="0,24,0,0" />
                <TextBlock x:Name="lblMessage" Style="{StaticResource StyDialogWarning}" Margin="0,16,0,0" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                    <Button x:Name="btnRetry" Style="{StaticResource StyDialogPrimaryButton}"
                            Margin="0,0,16,0" Visibility="Collapsed"
                            Content="{Binding [ErrorDialog_BtnRetry], Source={StaticResource Loc},
                                      Converter={StaticResource CnvUpperCase}}"
                            Click="OnActionClick" />
                    <Button x:Name="btnReturnToMatch" Style="{StaticResource StyDialogPrimaryButton}"
                            Margin="0,0,16,0" Visibility="Collapsed"
                            Content="{Binding [ErrorDialog_BtnReturnToMatch], Source={StaticResource Loc},
                                      Converter={StaticResource CnvUpperCase}}"
                            Click="OnActionClick" />
                    <Button x:Name="btnClose" Style="{StaticResource StyDialogSecondaryButton}"
                            Content="{Binding [Shared_BtnClose], Source={StaticResource Loc},
                                      Converter={StaticResource CnvUpperCase}}"
                            Click="OnCloseClick" />
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</views:GuiModalBase>
