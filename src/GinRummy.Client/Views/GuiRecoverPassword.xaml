<views:GuiWindowBase x:Class="GinRummy.Client.Views.GuiRecoverPassword"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GinRummy.Client.Views"
        Title="{Binding [RecoverPassword_LblTitle], Source={StaticResource Loc}}"
        Height="480" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BrsBackground}"
        FontFamily="{StaticResource FntPrimary}">
    <Grid>
        <Border Style="{StaticResource StyCard}" Width="400">
            <StackPanel>

                <TextBlock x:Name="lblTitle" Style="{StaticResource StyHeading}"
                           Text="{Binding [RecoverPassword_LblTitle], Source={StaticResource Loc}}" />
                <TextBlock x:Name="lblInstructions" Style="{StaticResource StySubtitle}"
                           Text="{Binding [RecoverPassword_LblInstructions], Source={StaticResource Loc}}" />

                <TextBlock x:Name="lblEmail" Style="{StaticResource StyLabel}"
                           Text="{Binding [RecoverPassword_LblEmail], Source={StaticResource Loc}}" />
                <Grid>
                    <TextBox x:Name="txtEmail" Style="{StaticResource StyTextBox}" />
                    <TextBlock Style="{StaticResource StyPlaceholder}"
                               Text="{Binding [RecoverPassword_TxtEmailPlaceholder], Source={StaticResource Loc}}"
                               Visibility="{Binding Text, ElementName=txtEmail, Converter={StaticResource CnvEmptyTextToVisibility}}" />
                </Grid>

                <TextBlock x:Name="lblCodeSentIfExists" Style="{StaticResource StyNotice}"
                           Text="{Binding [RecoverPassword_CodeSentIfExists], Source={StaticResource Loc}}" />

                <Button x:Name="btnSendCode" Style="{StaticResource StyPrimaryButton}"
                        Margin="0,20,0,0"
                        Content="{Binding [RecoverPassword_BtnSendCode], Source={StaticResource Loc}}"
                        Click="OnSendCodeClick" />

                <Button x:Name="btnCancel" Style="{StaticResource StyLinkButton}"
                        Margin="0,14,0,0"
                        Content="{Binding [Shared_BtnCancel], Source={StaticResource Loc}}"
                        Click="OnCancelClick" />

            </StackPanel>
        </Border>
    </Grid>
</views:GuiWindowBase>
