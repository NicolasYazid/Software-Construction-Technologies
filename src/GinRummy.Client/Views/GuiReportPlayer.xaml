<views:GuiModalBase x:Class="GinRummy.Client.Views.GuiReportPlayer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GinRummy.Client.Views"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        HasCloseButton="False">
    <Grid Width="540" Background="{StaticResource BrsPageBackground}">
        <Border Style="{StaticResource StyDialogCard}">
            <StackPanel>

                <TextBlock x:Name="lblTitle" Style="{StaticResource StyPanelTitle}"
                           Text="{Binding [ReportPlayer_LblTitle], Source={StaticResource Loc},
                                  Converter={StaticResource CnvUpperCase}}" />
                <TextBlock x:Name="lblUsername" Style="{StaticResource StyReportedPlayer}" Margin="0,16,0,18" />

                <!-- The reasons are the closed catalogue of the report categories (BD-09). -->
                <RadioButton x:Name="radReasonOffensiveLanguage" Style="{StaticResource StyReasonRadio}"
                             Content="{Binding [Reason_OffensiveLanguage], Source={StaticResource Loc}}"
                             Checked="OnReasonChecked" />
                <RadioButton x:Name="radReasonHarassmentOrThreats" Style="{StaticResource StyReasonRadio}"
                             Content="{Binding [Reason_HarassmentOrThreats], Source={StaticResource Loc}}"
                             Checked="OnReasonChecked" />
                <RadioButton x:Name="radReasonCheatingOrExploits" Style="{StaticResource StyReasonRadio}"
                             Content="{Binding [Reason_CheatingOrExploits], Source={StaticResource Loc}}"
                             Checked="OnReasonChecked" />
                <RadioButton x:Name="radReasonSpam" Style="{StaticResource StyReasonRadio}"
                             Content="{Binding [Reason_Spam], Source={StaticResource Loc}}"
                             Checked="OnReasonChecked" />

                <TextBlock x:Name="lblDescription" Style="{StaticResource StyFieldLabel}" Margin="0,12,0,8"
                           Text="{Binding [ReportPlayer_LblDescription], Source={StaticResource Loc}}" />
                <!-- BD-06 limits the description to five hundred characters. -->
                <Border Style="{StaticResource StyFieldArea}">
                    <Grid>
                        <TextBox x:Name="txtDescription" Style="{StaticResource StyFieldAreaInput}" MaxLength="500" />
                        <TextBlock Style="{StaticResource StyFieldAreaPlaceholder}"
                                   Text="{Binding [ReportPlayer_TxtDescriptionPlaceholder], Source={StaticResource Loc}}"
                                   Visibility="{Binding Text, ElementName=txtDescription,
                                                Converter={StaticResource CnvEmptyTextToVisibility}}" />
                    </Grid>
                </Border>

                <TextBlock x:Name="lblNoCategorySelected" Style="{StaticResource StyCardError}" Margin="0,12,0,0"
                           Text="{Binding [ReportPlayer_NoCategorySelected], Source={StaticResource Loc}}" />

                <UniformGrid Columns="2" Margin="0,26,0,0">
                    <Button x:Name="btnCancel" Style="{StaticResource StyDialogSecondaryButton}" Margin="0,0,8,0"
                            Content="{Binding [Shared_BtnCancel], Source={StaticResource Loc},
                                      Converter={StaticResource CnvUpperCase}}"
                            Click="OnCancelClick" />
                    <Button x:Name="btnSubmit" Style="{StaticResource StyDialogPrimaryButton}" Margin="8,0,0,0"
                            Content="{Binding [ReportPlayer_BtnSubmit], Source={StaticResource Loc},
                                      Converter={StaticResource CnvUpperCase}}"
                            Click="OnSubmitClick" />
                </UniformGrid>

            </StackPanel>
        </Border>
    </Grid>
</views:GuiModalBase>
