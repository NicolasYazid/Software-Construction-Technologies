<views:GuiWindowBase x:Class="GinRummy.Client.Views.GuiAccountCreated"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GinRummy.Client.Views"
        Title="{Binding [AccountCreated_LblTitle], Source={StaticResource Loc}}"
        Height="320" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BrsBackground}"
        FontFamily="{StaticResource FntPrimary}">
    <Grid>
        <Border Style="{StaticResource StyCard}" Width="380">
            <StackPanel>
                <TextBlock x:Name="lblTitle" Style="{StaticResource StyHeading}"
                           Text="{Binding [AccountCreated_LblTitle], Source={StaticResource Loc}}" />
                <TextBlock x:Name="lblMessage" Style="{StaticResource StySubtitle}"
                           Text="{Binding [AccountCreated_LblMessage], Source={StaticResource Loc}}" />
                <Button x:Name="btnLogIn" Style="{StaticResource StyPrimaryButton}"
                        Margin="0,26,0,0"
                        Content="{Binding [Shared_BtnLogIn], Source={StaticResource Loc}}"
                        Click="OnLogInClick" />
            </StackPanel>
        </Border>
    </Grid>
</views:GuiWindowBase>
