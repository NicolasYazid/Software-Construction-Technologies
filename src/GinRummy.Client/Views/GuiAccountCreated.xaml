<views:GuiWindowBase x:Class="GinRummy.Client.Views.GuiAccountCreated"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GinRummy.Client.Views"
        xmlns:ctl="clr-namespace:GinRummy.Client.Controls"
        Title="{Binding [AccountCreated_LblTitle], Source={StaticResource Loc}}"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Grid Width="938" Height="632" Background="{StaticResource BrsSurface}">

        <!-- The same painted panel as the one beside the log in, stretched to the height of
             the screen through the canvas that never reports the size of the paint. -->
        <Grid HorizontalAlignment="Right" Width="469" ClipToBounds="True">
            <Canvas>
                <ctl:CtlPaintBackground Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}"
                                        Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}"
                                        DeepColour="{StaticResource ClrArtworkDeep}"
                                        MidColour="{StaticResource ClrArtworkMid}"
                                        GlowColour="{StaticResource ClrArtworkGlow}" />
            </Canvas>
            <ctl:CtlBrandMark MarkFontSize="46" MarkForeground="{StaticResource BrsMenuLight}"
                              Effect="{StaticResource EfxTextShadow}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <TextBlock x:Name="lblTitle" Style="{StaticResource StyPlainTitle}"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   Width="380" Margin="40,230,0,0"
                   Text="{Binding [AccountCreated_LblTitle], Source={StaticResource Loc}}" />

        <TextBlock x:Name="lblMessage" Style="{StaticResource StyPlainBody}"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   Width="403" Margin="40,285,0,0"
                   Text="{Binding [AccountCreated_LblMessage], Source={StaticResource Loc}}" />

        <Button x:Name="btnLogIn" Style="{StaticResource StyPlainPrimaryButton}"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Width="380" Margin="40,350,0,0"
                Content="{Binding [Shared_BtnLogIn], Source={StaticResource Loc}, Converter={StaticResource CnvUpperCase}}"
                Click="OnLogInClick" />

    </Grid>
</views:GuiWindowBase>
