<views:GuiWindowBase x:Class="GinRummy.Client.Views.GuiVerifyEmail"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GinRummy.Client.Views"
        Title="{Binding [VerifyEmail_LblTitleSignUp], Source={StaticResource Loc}}"
        Height="700" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BrsBackground}"
        FontFamily="{StaticResource FntPrimary}">
    <Grid>
        <Border Style="{StaticResource StyCard}" Width="400">
            <StackPanel>

                <TextBlock x:Name="lblTitle" Style="{StaticResource StyHeading}" />
                <TextBlock x:Name="lblInstructions" Style="{StaticResource StySubtitle}" />

                <TextBlock x:Name="lblCode" Style="{StaticResource StyLabel}"
                           Text="{Binding [VerifyEmail_LblCode], Source={StaticResource Loc}}" />
                <Grid>
                    <TextBox x:Name="txtCode" Style="{StaticResource StyTextBox}" MaxLength="6" />
                    <TextBlock Style="{StaticResource StyPlaceholder}"
                               Text="{Binding [VerifyEmail_TxtCodePlaceholder], Source={StaticResource Loc}}"
                               Visibility="{Binding Text, ElementName=txtCode, Converter={StaticResource CnvEmptyTextToVisibility}}" />
                </Grid>

                <TextBlock x:Name="lblCodeExpiresIn" Style="{StaticResource StyHint}" Margin="0,12,0,0" />
                <TextBlock x:Name="lblAttemptsLeft" Style="{StaticResource StyHint}" Margin="0,4,0,0" />
                <TextBlock x:Name="lblResendAvailableIn" Style="{StaticResource StyHint}" Margin="0,4,0,0" />

                <TextBlock x:Name="lblErrorMessage" Style="{StaticResource StyError}" />
                <TextBlock x:Name="lblAlreadyVerified" Style="{StaticResource StyNotice}"
                           Text="{Binding [VerifyEmail_AlreadyVerified], Source={StaticResource Loc}}" />
                <TextBlock x:Name="lblCodeNotSent" Style="{StaticResource StyNotice}"
                           Text="{Binding [VerifyEmail_CodeNotSent], Source={StaticResource Loc}}" />

                <Button x:Name="btnVerify" Style="{StaticResource StyPrimaryButton}"
                        Margin="0,20,0,0"
                        Content="{Binding [VerifyEmail_BtnVerify], Source={StaticResource Loc}}"
                        Click="OnVerifyClick" />

                <Button x:Name="btnResendCode" Style="{StaticResource StySecondaryButton}"
                        Margin="0,12,0,0"
                        Content="{Binding [Shared_BtnResendCode], Source={StaticResource Loc}}"
                        Click="OnResendCodeClick" />

                <Button x:Name="btnVerifyLater" Style="{StaticResource StyLinkButton}"
                        Margin="0,14,0,0"
                        Content="{Binding [VerifyEmail_BtnVerifyLater], Source={StaticResource Loc}}"
                        Click="OnVerifyLaterClick" />

            </StackPanel>
        </Border>
    </Grid>
</views:GuiWindowBase>
