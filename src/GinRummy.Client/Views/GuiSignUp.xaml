<views:GuiWindowBase x:Class="GinRummy.Client.Views.GuiSignUp"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GinRummy.Client.Views"
        xmlns:ctl="clr-namespace:GinRummy.Client.Controls"
        Title="{Binding [SignUp_LblTitle], Source={StaticResource Loc}}"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <!-- The height is not stated: the window declares SizeToContent, so letting the grid grow
         with the card is what keeps the last button inside it whatever the size of the text. -->
    <Grid Width="938" Background="{StaticResource BrsPageBackground}">

        <!-- The panel stretches to the height of the card instead of being measured on its own.
             The paint sits inside a canvas, which never reports the size of its children: the
             surface of the paint reports the size of its own bitmap, and left free that measure
             was what stretched the window far past the content. -->
        <Grid HorizontalAlignment="Right" Width="465" ClipToBounds="True">
            <Canvas>
                <ctl:CtlPaintBackground Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}"
                                        Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}"
                                        DeepColour="{StaticResource ClrArtworkDeep}"
                                        MidColour="{StaticResource ClrArtworkMid}"
                                        GlowColour="{StaticResource ClrArtworkGlow}" />
            </Canvas>
            <ctl:CtlBrandMark MarkFontSize="46" MarkForeground="{StaticResource BrsMenuLight}"
                              Effect="{StaticResource EfxTextShadow}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <Border Background="{StaticResource BrsSurface}" CornerRadius="4"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Width="471" Margin="2,0,0,0"
                Padding="34,60,34,30">
            <StackPanel>

                <TextBlock x:Name="lblTitle" Style="{StaticResource StyCardTitle}"
                           Text="{Binding [SignUp_LblTitle], Source={StaticResource Loc}, Converter={StaticResource CnvUpperCase}}" />
                <TextBlock x:Name="lblSubtitle" Style="{StaticResource StyCardSubtitle}" Margin="0,16,0,0"
                           Text="{Binding [SignUp_LblSubtitle], Source={StaticResource Loc}}" />

                <TextBlock x:Name="lblEmail" Style="{StaticResource StyFieldLabel}" Margin="0,20,0,8"
                           Text="{Binding [SignUp_LblEmail], Source={StaticResource Loc}, Converter={StaticResource CnvUpperCase}}" />
                <Border Style="{StaticResource StyFieldShell}" Width="402" HorizontalAlignment="Left">
                    <DockPanel LastChildFill="True">
                        <Image Source="{StaticResource IcoMail}" Width="19" Height="19"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Grid>
                            <TextBox x:Name="txtEmail" Style="{StaticResource StyFieldInput}" />
                            <TextBlock Style="{StaticResource StyFieldPlaceholder}"
                                       Text="{Binding [SignUp_TxtEmailPlaceholder], Source={StaticResource Loc}}"
                                       Visibility="{Binding Text, ElementName=txtEmail,
                                                    Converter={StaticResource CnvEmptyTextToVisibility}}" />
                        </Grid>
                    </DockPanel>
                </Border>

                <TextBlock x:Name="lblUsername" Style="{StaticResource StyFieldLabel}" Margin="0,20,0,8"
                           Text="{Binding [SignUp_LblUsername], Source={StaticResource Loc}, Converter={StaticResource CnvUpperCase}}" />
                <Border Style="{StaticResource StyFieldShell}" Width="402" HorizontalAlignment="Left">
                    <DockPanel LastChildFill="True">
                        <Image Source="{StaticResource IcoUser}" Width="19" Height="19"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Grid>
                            <TextBox x:Name="txtUsername" Style="{StaticResource StyFieldInput}" />
                            <TextBlock Style="{StaticResource StyFieldPlaceholder}"
                                       Text="{Binding [SignUp_TxtUsernamePlaceholder], Source={StaticResource Loc}}"
                                       Visibility="{Binding Text, ElementName=txtUsername,
                                                    Converter={StaticResource CnvEmptyTextToVisibility}}" />
                        </Grid>
                    </DockPanel>
                </Border>

                <TextBlock x:Name="lblPassword" Style="{StaticResource StyFieldLabel}" Margin="0,20,0,8"
                           Text="{Binding [SignUp_LblPassword], Source={StaticResource Loc}, Converter={StaticResource CnvUpperCase}}" />
                <Border Style="{StaticResource StyFieldShell}" Width="402" HorizontalAlignment="Left">
                    <DockPanel LastChildFill="True">
                        <Image Source="{StaticResource IcoLock}" Width="19" Height="19"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button x:Name="btnTogglePassword" DockPanel.Dock="Right"
                                Style="{StaticResource StyIconButton}"
                                VerticalAlignment="Center" Margin="12,0,0,0"
                                ToolTip="{Binding [Shared_TipTogglePassword], Source={StaticResource Loc}}"
                                Click="OnTogglePasswordClick">
                            <Image Source="{StaticResource IcoEye}" Width="19" Height="19" />
                        </Button>
                        <PasswordBox x:Name="pwdPassword" Style="{StaticResource StyFieldPassword}" MaxLength="64" />
                    </DockPanel>
                </Border>

                <TextBlock x:Name="lblConfirmPassword" Style="{StaticResource StyFieldLabel}" Margin="0,20,0,8"
                           Text="{Binding [SignUp_LblConfirmPassword], Source={StaticResource Loc},
                                  Converter={StaticResource CnvUpperCase}}" />
                <Border Style="{StaticResource StyFieldShell}" Width="402" HorizontalAlignment="Left">
                    <DockPanel LastChildFill="True">
                        <Image Source="{StaticResource IcoLock}" Width="19" Height="19"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button x:Name="btnToggleConfirmPassword" DockPanel.Dock="Right"
                                Style="{StaticResource StyIconButton}"
                                VerticalAlignment="Center" Margin="12,0,0,0"
                                ToolTip="{Binding [Shared_TipTogglePassword], Source={StaticResource Loc}}"
                                Click="OnTogglePasswordClick">
                            <Image Source="{StaticResource IcoEye}" Width="19" Height="19" />
                        </Button>
                        <PasswordBox x:Name="pwdConfirmPassword" Style="{StaticResource StyFieldPassword}" MaxLength="64" />
                    </DockPanel>
                </Border>

                <TextBlock x:Name="lblErrorMessage" Style="{StaticResource StyCardError}"
                           Width="402" HorizontalAlignment="Left" Margin="0,12,0,0" />
                <TextBlock x:Name="lblGuestSessionNotKept" Style="{StaticResource StyCardNotice}"
                           Width="402" HorizontalAlignment="Left" Margin="0,12,0,0"
                           Text="{Binding [SignUp_GuestSessionNotKept], Source={StaticResource Loc}}" />
                <TextBlock x:Name="lblCreatingAccount" Style="{StaticResource StyCardNotice}"
                           Width="402" HorizontalAlignment="Left" Margin="0,12,0,0"
                           Text="{Binding [SignUp_LblCreatingAccount], Source={StaticResource Loc}}" />

                <StackPanel Margin="0,12,0,0">
                    <TextBlock x:Name="lblReqMinLength" Style="{StaticResource StyCardNotice}"
                               Visibility="Visible" Width="402" HorizontalAlignment="Left"
                               Text="{Binding [SignUp_LblReqMinLength], Source={StaticResource Loc}}" />
                    <TextBlock x:Name="lblReqLetter" Style="{StaticResource StyCardNotice}"
                               Visibility="Visible" Width="402" HorizontalAlignment="Left"
                               Text="{Binding [SignUp_LblReqLetter], Source={StaticResource Loc}}" />
                    <TextBlock x:Name="lblReqNumber" Style="{StaticResource StyCardNotice}"
                               Visibility="Visible" Width="402" HorizontalAlignment="Left"
                               Text="{Binding [SignUp_LblReqNumber], Source={StaticResource Loc}}" />
                </StackPanel>

                <Button x:Name="btnCreateAccount" Style="{StaticResource StyCardPrimaryButton}"
                        Width="402" HorizontalAlignment="Left" Margin="0,20,0,0"
                        Content="{Binding [Shared_BtnCreateAccount], Source={StaticResource Loc}, Converter={StaticResource CnvUpperCase}}"
                        Click="OnCreateAccountClick" />

                <Button x:Name="btnCancel" Style="{StaticResource StyCardTextButton}"
                        Width="402" HorizontalAlignment="Left" Margin="0,20,0,0"
                        Content="{Binding [Shared_BtnCancel], Source={StaticResource Loc}, Converter={StaticResource CnvUpperCase}}"
                        Click="OnCancelClick" />

            </StackPanel>
        </Border>
    </Grid>
</views:GuiWindowBase>
