<views:GuiWindowBase x:Class="GinRummy.Client.Views.GuiTwoStep"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GinRummy.Client.Views"
        Title="{Binding [TwoStep_LblTitle], Source={StaticResource Loc}}"
        Height="520" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BrsBackground}"
        FontFamily="{StaticResource FntPrimary}">
    <Grid>
        <Border Style="{StaticResource StyCard}" Width="400">
            <StackPanel>

                <TextBlock x:Name="lblTitle" Style="{StaticResource StyHeading}"
                           Text="{Binding [TwoStep_LblTitle], Source={StaticResource Loc}}" />
                <TextBlock x:Name="lblInstructions" Style="{StaticResource StySubtitle}" />

                <TextBlock x:Name="lblCode" Style="{StaticResource StyLabel}"
                           Text="{Binding [TwoStep_LblCode], Source={StaticResource Loc}}" />
                <TextBox x:Name="txtCode" Style="{StaticResource StyTextBox}" MaxLength="6" />

                <TextBlock x:Name="lblCodeExpiresIn" Style="{StaticResource StyHint}" Margin="0,12,0,0" />

                <Button x:Name="btnVerify" Style="{StaticResource StyPrimaryButton}"
                        Margin="0,20,0,0"
                        Content="{Binding [TwoStep_BtnVerify], Source={StaticResource Loc}}"
                        Click="OnVerifyClick" />

                <Button x:Name="btnResendCode" Style="{StaticResource StySecondaryButton}"
                        Margin="0,12,0,0"
                        Content="{Binding [Shared_BtnResendCode], Source={StaticResource Loc}}"
                        Click="OnResendCodeClick" />

                <Button x:Name="btnCancel" Style="{StaticResource StyLinkButton}"
                        Margin="0,14,0,0"
                        Content="{Binding [Shared_BtnCancel], Source={StaticResource Loc}}"
                        Click="OnCancelClick" />

            </StackPanel>
        </Border>
    </Grid>
</views:GuiWindowBase>
