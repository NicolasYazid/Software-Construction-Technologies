<views:GuiModalBase x:Class="GinRummy.Client.Views.GuiTwoStep"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GinRummy.Client.Views"
        xmlns:ctl="clr-namespace:GinRummy.Client.Controls"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Grid Width="938" Height="607" Background="{StaticResource BrsSurface}">

        <!-- The paint sits in a canvas, which never reports the size of the paint, so the panel stretches to the height of the screen. -->
        <Grid HorizontalAlignment="Right" Width="469" ClipToBounds="True">
            <Canvas>
                <ctl:PaintedBackground Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}"
                                        Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}"
                                        DeepColour="{StaticResource ClrArtworkDeep}"
                                        MidColour="{StaticResource ClrArtworkMid}"
                                        GlowColour="{StaticResource ClrArtworkGlow}" />
            </Canvas>
            <ctl:BrandMark MarkFontSize="46" MarkForeground="{StaticResource BrsMenuLight}"
                              Effect="{StaticResource EfxTextShadow}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top"
                    Width="380" Margin="40,161,0,0">

            <TextBlock x:Name="lblTitle" Style="{StaticResource StyPlainTitle}"
                       Text="{Binding [TwoStep_LblTitle], Source={StaticResource PrvLocalization}}" />
            <TextBlock x:Name="lblInstructions" Style="{StaticResource StyPlainBody}" Margin="0,14,0,0">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource CnvResourceText}">
                        <Binding Path="InstructionsKey" />
                        <Binding Path="CurrentCulture" Source="{StaticResource PrvLocalization}" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <TextBlock x:Name="lblCode" Style="{StaticResource StyPlainLabel}"
                       HorizontalAlignment="Center" Margin="0,32,0,0"
                       Text="{Binding [TwoStep_LblCode], Source={StaticResource PrvLocalization},
                              Converter={StaticResource CnvUpperCase}}" />

            <ctl:PixelBorder Style="{StaticResource StyPlainFieldShell}" Margin="0,8,0,0">
                <Grid>
                    <TextBox x:Name="txtCode" Style="{StaticResource StyPlainInput}" MaxLength="6"
                             TextAlignment="Center" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />
                    <!-- The hint steps aside on focus because the caret of the centred empty field stands in its middle. -->
                    <TextBlock TextAlignment="Center" HorizontalAlignment="Center"
                               Text="{Binding [VerifyEmail_TxtCodePlaceholder], Source={StaticResource PrvLocalization}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource StyPlainPlaceholder}">
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Visibility"
                                        Value="{Binding Text, ElementName=txtCode,
                                                Converter={StaticResource CnvEmptyTextToVisibility}}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=txtCode}" Value="True">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </ctl:PixelBorder>

            <TextBlock x:Name="lblCodeExpiresIn" Style="{StaticResource StyPlainLabel}"
                       HorizontalAlignment="Right" Margin="0,12,0,0">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource CnvLocalizedFormat}">
                        <Binding Path="[TwoStep_LblCodeExpiresIn]" Source="{StaticResource PrvLocalization}" />
                        <Binding Path="CodeCountdown.RemainingTime" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <TextBlock x:Name="lblErrorMessage" Style="{StaticResource StyPlainError}" Margin="0,10,0,0"
                       Visibility="{Binding HasErrorMessage, Converter={StaticResource CnvBooleanToVisibility}}">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource CnvResourceText}">
                        <Binding Path="ErrorMessageKey" />
                        <Binding Path="CurrentCulture" Source="{StaticResource PrvLocalization}" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <Button x:Name="btnVerify" Style="{StaticResource StyPlainPrimaryButton}"
                    Margin="0,20,0,0"
                    Content="{Binding [TwoStep_BtnVerify], Source={StaticResource PrvLocalization},
                              Converter={StaticResource CnvUpperCase}}"
                    Command="{Binding VerifyCommand}" />

            <Button x:Name="btnResendCode" Style="{StaticResource StyPlainTextButton}"
                    HorizontalAlignment="Right" Margin="0,12,0,0"
                    Content="{Binding [Shared_BtnResendCode], Source={StaticResource PrvLocalization},
                              Converter={StaticResource CnvUpperCase}}"
                    Command="{Binding ResendCodeCommand}" />

        </StackPanel>
    </Grid>
</views:GuiModalBase>
