<views:GuiModalBase x:Class="GinRummy.Client.Views.GuiNewPassword"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GinRummy.Client.Views"
        xmlns:ctl="clr-namespace:GinRummy.Client.Controls"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Grid Width="460" MinHeight="441" Background="{StaticResource BrsSurface}">
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top"
                    Width="380" Margin="40,50,40,50">

            <TextBlock x:Name="lblTitle" Style="{StaticResource StyPlainTitle}">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource CnvResourceText}">
                        <Binding Path="TitleKey" />
                        <Binding Path="CurrentCulture" Source="{StaticResource PrvLocalization}" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <TextBlock x:Name="lblInstructions" Style="{StaticResource StyPlainBody}" Margin="0,12,0,0"
                       Text="{Binding [NewPassword_LblInstructions], Source={StaticResource PrvLocalization}}" />

            <TextBlock x:Name="lblCurrentPassword" Style="{StaticResource StyPlainLabel}" Margin="0,28,0,8"
                       Visibility="{Binding IsChangeFromProfile, Converter={StaticResource CnvBooleanToVisibility}}"
                       Text="{Binding [NewPassword_LblCurrentPassword], Source={StaticResource PrvLocalization},
                              Converter={StaticResource CnvUpperCase}}" />
            <!-- The field follows the visibility of its label, so the flow decides both in a
                 single place. -->
            <ctl:PixelBorder Style="{StaticResource StyPlainFieldShell}" Width="380" HorizontalAlignment="Left"
                    Visibility="{Binding Visibility, ElementName=lblCurrentPassword}">
                <DockPanel LastChildFill="True">
                    <PasswordBox x:Name="pwdCurrentPassword" Style="{StaticResource StyPlainPassword}" MaxLength="64"
                                 ctl:PasswordBindingCommon.BoundPassword="{Binding CurrentPassword}" />
                </DockPanel>
            </ctl:PixelBorder>

            <TextBlock x:Name="lblNewPassword" Style="{StaticResource StyPlainLabel}" Margin="0,28,0,8"
                       Text="{Binding [NewPassword_LblNewPassword], Source={StaticResource PrvLocalization},
                              Converter={StaticResource CnvUpperCase}}" />
            <ctl:PixelBorder Style="{StaticResource StyPlainFieldShell}" Width="380" HorizontalAlignment="Left">
                <DockPanel LastChildFill="True">
                    <PasswordBox x:Name="pwdNewPassword" Style="{StaticResource StyPlainPassword}" MaxLength="64"
                                 ctl:PasswordBindingCommon.BoundPassword="{Binding NewPassword}" />
                </DockPanel>
            </ctl:PixelBorder>

            <TextBlock x:Name="lblConfirmPassword" Style="{StaticResource StyPlainLabel}" Margin="0,22,0,8"
                       Text="{Binding [NewPassword_LblConfirmPassword], Source={StaticResource PrvLocalization},
                              Converter={StaticResource CnvUpperCase}}" />
            <ctl:PixelBorder Style="{StaticResource StyPlainFieldShell}" Width="380" HorizontalAlignment="Left">
                <DockPanel LastChildFill="True">
                    <PasswordBox x:Name="pwdConfirmPassword" Style="{StaticResource StyPlainPassword}" MaxLength="64"
                                 ctl:PasswordBindingCommon.BoundPassword="{Binding ConfirmPassword}" />
                </DockPanel>
            </ctl:PixelBorder>

            <TextBlock x:Name="lblErrorMessage" Style="{StaticResource StyPlainError}" Margin="0,10,0,0"
                       Visibility="{Binding IsPasswordMismatchShown, Converter={StaticResource CnvBooleanToVisibility}}"
                       Text="{Binding [Error_ValPasswordMismatch], Source={StaticResource PrvLocalization}}" />

            <Button x:Name="btnUpdatePassword" Style="{StaticResource StyPlainPrimaryButton}"
                    Margin="0,20,0,0"
                    Content="{Binding [NewPassword_BtnUpdate], Source={StaticResource PrvLocalization},
                              Converter={StaticResource CnvUpperCase}}"
                    Command="{Binding UpdateCommand}" />

        </StackPanel>
    </Grid>
</views:GuiModalBase>
