<views:GuiWindowBase x:Class="GinRummy.Client.Views.GuiNewPassword"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GinRummy.Client.Views"
        Title="{Binding [NewPassword_LblTitle], Source={StaticResource Loc}}"
        Height="700" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BrsBackground}"
        FontFamily="{StaticResource FntPrimary}">
    <Grid>
        <Border Style="{StaticResource StyCard}" Width="400">
            <StackPanel>

                <TextBlock x:Name="lblTitle" Style="{StaticResource StyHeading}" />
                <TextBlock x:Name="lblInstructions" Style="{StaticResource StySubtitle}"
                           Text="{Binding [NewPassword_LblInstructions], Source={StaticResource Loc}}" />

                <TextBlock x:Name="lblCurrentPassword" Style="{StaticResource StyLabel}"
                           Text="{Binding [NewPassword_LblCurrentPassword], Source={StaticResource Loc}}" />
                <PasswordBox x:Name="pwdCurrentPassword" Style="{StaticResource StyPasswordBox}" />

                <TextBlock x:Name="lblNewPassword" Style="{StaticResource StyLabel}"
                           Text="{Binding [NewPassword_LblNewPassword], Source={StaticResource Loc}}" />
                <PasswordBox x:Name="pwdNewPassword" Style="{StaticResource StyPasswordBox}" />

                <TextBlock x:Name="lblConfirmPassword" Style="{StaticResource StyLabel}"
                           Text="{Binding [NewPassword_LblConfirmPassword], Source={StaticResource Loc}}" />
                <PasswordBox x:Name="pwdConfirmPassword" Style="{StaticResource StyPasswordBox}" />

                <StackPanel Margin="0,12,0,0">
                    <TextBlock x:Name="lblReqMinLength" Style="{StaticResource StyHint}"
                               Text="{Binding [SignUp_LblReqMinLength], Source={StaticResource Loc}}" />
                    <TextBlock x:Name="lblReqLetter" Style="{StaticResource StyHint}"
                               Text="{Binding [SignUp_LblReqLetter], Source={StaticResource Loc}}" />
                    <TextBlock x:Name="lblReqNumber" Style="{StaticResource StyHint}"
                               Text="{Binding [SignUp_LblReqNumber], Source={StaticResource Loc}}" />
                </StackPanel>

                <TextBlock x:Name="lblErrorMessage" Style="{StaticResource StyError}" />

                <Button x:Name="btnUpdate" Style="{StaticResource StyPrimaryButton}"
                        Margin="0,20,0,0"
                        Content="{Binding [NewPassword_BtnUpdate], Source={StaticResource Loc}}"
                        Click="OnUpdateClick" />

                <Button x:Name="btnCancel" Style="{StaticResource StyLinkButton}"
                        Margin="0,14,0,0"
                        Content="{Binding [Shared_BtnCancel], Source={StaticResource Loc}}"
                        Click="OnCancelClick" />

            </StackPanel>
        </Border>
    </Grid>
</views:GuiWindowBase>
