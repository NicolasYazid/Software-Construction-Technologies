<views:GuiModalBase x:Class="GinRummy.Client.Views.GuiProfilePanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GinRummy.Client.Views"
        xmlns:ctl="clr-namespace:GinRummy.Client.Controls"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <!-- The panel is shorter than the windows that open it so its four edges stay in sight. -->
    <ContentControl Width="480" Height="700" Style="{StaticResource StyLobbyDialog}" Padding="0">
        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,4,8">
                <StackPanel Margin="36,30,30,30">

                    <!-- The picture comes from the profile the lobby already read, so the panel does not ask the server for it again. -->
                    <Grid x:Name="grdAvatar" Width="112" Height="112" HorizontalAlignment="Center">
                        <Border Style="{StaticResource StyAvatarProfile}">
                            <Image Style="{StaticResource StyAvatarIconProfile}" />
                        </Border>
                        <Image x:Name="imgProfilePicture" Stretch="UniformToFill" Source="{Binding Picture}">
                            <Image.Clip>
                                <EllipseGeometry Center="56,56" RadiusX="56" RadiusY="56" />
                            </Image.Clip>
                        </Image>
                    </Grid>
                    <TextBlock x:Name="lblTitle" Style="{StaticResource StyPanelTitle}" HorizontalAlignment="Center"
                               Margin="0,16,0,0"
                               Text="{Binding [ProfilePanel_LblTitle], Source={StaticResource PrvLocalization},
                                      Converter={StaticResource CnvUpperCase}}" />

                    <Border Style="{StaticResource StySettingDivider}" />

                    <!-- Each section sits on its own glass card so its text reads clear over the paint. -->
                    <StackPanel x:Name="pnlAccountSettings"
                                Visibility="{Binding IsSignedIn, Converter={StaticResource CnvBooleanToVisibility}}">
                        <ctl:PixelBorder Style="{StaticResource StySettingCard}">
                            <StackPanel>
                                <TextBlock x:Name="lblEmail" Style="{StaticResource StySettingSection}"
                                           Text="{Binding [ProfilePanel_LblEmail], Source={StaticResource PrvLocalization}}" />
                                <TextBlock x:Name="lblEmailAddress" Style="{StaticResource StySettingValue}" Text="{Binding Email}" />
                                <TextBlock x:Name="lblEmailChanged" Style="{StaticResource StyCardNotice}"
                                           Visibility="{Binding IsEmailChangedShown, Converter={StaticResource CnvBooleanToVisibility}}"
                                           TextAlignment="Center" Margin="0,8,0,0"
                                           Text="{Binding [ProfilePanel_EmailChanged], Source={StaticResource PrvLocalization}}" />
                                <Button x:Name="btnChangeEmail" Style="{StaticResource StyNoticeButton}"
                                        HorizontalAlignment="Center" Margin="0,12,0,0"
                                        Content="{Binding [ProfilePanel_BtnChangeEmail], Source={StaticResource PrvLocalization},
                                                  Converter={StaticResource CnvUpperCase}}"
                                        Command="{Binding ChangeEmailCommand}" />
                            </StackPanel>
                        </ctl:PixelBorder>

                        <ctl:PixelBorder Style="{StaticResource StySettingCard}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock x:Name="lblPassword" Style="{StaticResource StySettingSection}"
                                           Text="{Binding [ProfilePanel_LblPassword], Source={StaticResource PrvLocalization}}" />
                                <!-- The password never reaches the client, so the mask only says that one exists. -->
                                <PasswordBox x:Name="pwdPassword" Style="{StaticResource StyFieldPassword}"
                                             HorizontalAlignment="Center" Focusable="False" IsHitTestVisible="False" />
                                <TextBlock x:Name="lblPasswordChanged" Style="{StaticResource StyCardNotice}"
                                           Visibility="{Binding IsPasswordChangedShown, Converter={StaticResource CnvBooleanToVisibility}}"
                                           TextAlignment="Center" Margin="0,8,0,0"
                                           Text="{Binding [ProfilePanel_PasswordChanged], Source={StaticResource PrvLocalization}}" />
                                <Button x:Name="btnChangePassword" Style="{StaticResource StyNoticeButton}"
                                        HorizontalAlignment="Center" Margin="0,12,0,0"
                                        Content="{Binding [ProfilePanel_BtnChangePassword], Source={StaticResource PrvLocalization},
                                                  Converter={StaticResource CnvUpperCase}}"
                                        Click="OnChangePasswordClick" />
                            </StackPanel>
                        </ctl:PixelBorder>

                        <Border Style="{StaticResource StySettingDivider}" />

                        <ctl:PixelBorder Style="{StaticResource StySettingCard}">
                            <DockPanel LastChildFill="True">
                                <ToggleButton x:Name="tglTwoStep" DockPanel.Dock="Right" Style="{StaticResource StyToggleSwitch}"
                                              VerticalAlignment="Center" Margin="14,0,0,0"
                                              IsChecked="{Binding IsTwoStepEnabled}" Command="{Binding ToggleTwoStepCommand}" />
                                <StackPanel>
                                    <TextBlock x:Name="lblTwoStep" Style="{StaticResource StySettingTitle}"
                                               Text="{Binding [ProfilePanel_LblTwoStep], Source={StaticResource PrvLocalization}}" />
                                    <TextBlock x:Name="lblTwoStepHint" Style="{StaticResource StySettingHint}"
                                               Text="{Binding [ProfilePanel_LblTwoStepHint], Source={StaticResource PrvLocalization}}" />
                                </StackPanel>
                            </DockPanel>
                        </ctl:PixelBorder>
                        <TextBlock x:Name="lblTwoStepNotice" Style="{StaticResource StyCardNotice}" Margin="0,10,0,0"
                                   Visibility="{Binding HasTwoStepNotice, Converter={StaticResource CnvBooleanToVisibility}}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource CnvResourceText}">
                                <Binding Path="TwoStepNoticeKey" />
                                <Binding Path="CurrentCulture" Source="{StaticResource PrvLocalization}" />
                            </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock x:Name="lblTwoStepError" Style="{StaticResource StyCardError}" Margin="0,10,0,0"
                                   Visibility="{Binding HasTwoStepError, Converter={StaticResource CnvBooleanToVisibility}}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource CnvResourceText}">
                                <Binding Path="TwoStepErrorKey" />
                                <Binding Path="CurrentCulture" Source="{StaticResource PrvLocalization}" />
                            </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>

                        <Border Style="{StaticResource StySettingDivider}" />

                        <ctl:PixelBorder Style="{StaticResource StySettingCard}">
                            <DockPanel LastChildFill="True">
                                <ToggleButton x:Name="tglChatFilter" DockPanel.Dock="Right" Style="{StaticResource StyToggleSwitch}"
                                              VerticalAlignment="Center" Margin="14,0,0,0" IsChecked="{Binding IsChatFilterEnabled}" />
                                <StackPanel>
                                    <TextBlock x:Name="lblChatFilter" Style="{StaticResource StySettingTitle}"
                                               Text="{Binding [ProfilePanel_LblChatFilter], Source={StaticResource PrvLocalization}}" />
                                    <TextBlock x:Name="lblChatFilterHint" Style="{StaticResource StySettingHint}"
                                               Text="{Binding [ProfilePanel_LblChatFilterHint], Source={StaticResource PrvLocalization}}" />
                                </StackPanel>
                            </DockPanel>
                        </ctl:PixelBorder>

                        <Border Style="{StaticResource StySettingDivider}" />
                    </StackPanel>

                    <!-- The selector shares the provider of the main menu, so the culture changes without closing anything (CU-20). -->
                    <ctl:PixelBorder Style="{StaticResource StySettingCard}">
                        <StackPanel>
                            <TextBlock x:Name="lblLanguage" Style="{StaticResource StySettingSection}"
                                       Text="{Binding [ProfilePanel_LblLanguage], Source={StaticResource PrvLocalization}}" />
                            <ComboBox x:Name="cmbLanguage" Style="{StaticResource StyMenuLanguageBox}" Width="200"
                                      HorizontalAlignment="Center" Tag="{StaticResource IcoGlobe}"
                                      ItemsSource="{Binding AvailableCultures, Source={StaticResource PrvLocalization}}"
                                      SelectedItem="{Binding SelectedCulture, Source={StaticResource PrvLocalization}, Mode=TwoWay}"
                                      SelectionChanged="OnLanguageSelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ShortName, Converter={StaticResource CnvUpperCase}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </ctl:PixelBorder>

                    <StackPanel Visibility="{Binding Visibility, ElementName=pnlAccountSettings}">
                        <Border Style="{StaticResource StySettingDivider}" />

                        <Button x:Name="btnLogOut" Style="{StaticResource StyCardOutlineButton}"
                                Background="{StaticResource BrsMenuWarn}"
                                Content="{Binding [Shared_BtnLogOut], Source={StaticResource PrvLocalization},
                                          Converter={StaticResource CnvUpperCase}}"
                                Click="OnLogOutClick" />
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- The veil of the change of email (CU-07) follows the visibility of its title, which the view model switches. -->
            <Grid Background="{StaticResource BrsOverlay}"
                  Visibility="{Binding Visibility, ElementName=lblChangeEmailTitle}">
                <ctl:PixelBorder Style="{StaticResource StyLobbyDialogCard}" Margin="26,0,26,0"
                                    VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock x:Name="lblChangeEmailTitle" Style="{StaticResource StyPanelTitle}"
                                   Visibility="{Binding IsChangeEmailOpen, Converter={StaticResource CnvBooleanToVisibility}}"
                                   Text="{Binding [ProfilePanel_LblChangeEmailTitle], Source={StaticResource PrvLocalization},
                                          Converter={StaticResource CnvUpperCase}}" />
                        <TextBlock x:Name="lblNewEmail" Style="{StaticResource StyFieldLabel}" Margin="0,20,0,8"
                                   Text="{Binding [ProfilePanel_LblNewEmail], Source={StaticResource PrvLocalization}}" />
                        <!-- The database limits an email address to two hundred and fifty-four characters. -->
                        <ctl:PixelBorder Style="{StaticResource StyLobbyFieldShell}">
                            <Grid>
                                <TextBox x:Name="txtNewEmail" Style="{StaticResource StyFieldInput}" MaxLength="254"
                                         Text="{Binding NewEmail, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource StyFieldPlaceholder}"
                                           Text="{Binding [ProfilePanel_TxtNewEmailPlaceholder], Source={StaticResource PrvLocalization}}"
                                           Visibility="{Binding Text, ElementName=txtNewEmail,
                                                        Converter={StaticResource CnvEmptyTextToVisibility}}" />
                            </Grid>
                        </ctl:PixelBorder>
                        <TextBlock x:Name="lblErrorMessage" Style="{StaticResource StyCardError}" Margin="0,12,0,0"
                                   Visibility="{Binding HasEmailError, Converter={StaticResource CnvBooleanToVisibility}}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource CnvResourceText}">
                                    <Binding Path="EmailErrorKey" />
                                    <Binding Path="CurrentCulture" Source="{StaticResource PrvLocalization}" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <UniformGrid Columns="2" Margin="0,24,0,0">
                            <Button x:Name="btnCancel" Style="{StaticResource StyCardOutlineButton}" Margin="0,0,8,0"
                                    Content="{Binding [Shared_BtnCancel], Source={StaticResource PrvLocalization},
                                              Converter={StaticResource CnvUpperCase}}"
                                    Command="{Binding CancelEmailCommand}" />
                            <Button x:Name="btnSave" Style="{StaticResource StyCardPrimaryButton}" Margin="8,0,0,0"
                                    Content="{Binding [Shared_BtnSave], Source={StaticResource PrvLocalization},
                                              Converter={StaticResource CnvUpperCase}}"
                                    Command="{Binding SaveEmailCommand}" />
                        </UniformGrid>
                    </StackPanel>
                </ctl:PixelBorder>
            </Grid>
        </Grid>
    </ContentControl>
</views:GuiModalBase>
