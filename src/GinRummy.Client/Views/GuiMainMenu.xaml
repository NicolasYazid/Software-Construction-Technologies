<views:GuiWindowBase x:Class="GinRummy.Client.Views.GuiMainMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GinRummy.Client.Views"
        xmlns:ctl="clr-namespace:GinRummy.Client.Controls"
        Title="{Binding [Shared_AppTitle], Source={StaticResource Loc}}"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Grid Width="1460" Height="775" Background="{StaticResource BrsMenuRoot}">

        <!-- Same paint as the side panel of the other screens, with the greens of the menu.
             It reaches less far into the field than the panel does, so the spiral comes out
             larger than the window and only its centre is seen, which is what gives the menu
             a background and not a picture. The resolution is the one that keeps the blocks
             measuring the same as on the panel: both come out at about three pixels of screen.
             The paint covers the whole window, so the background of the grid is only seen
             while the first frame is being drawn. -->
        <ctl:CtlPaintBackground x:Name="ctlPaintBackground"
                                BlockResolution="250" PatternScale="1.45"
                                DeepColour="{StaticResource ClrMenuLiquidDeep}"
                                MidColour="{StaticResource ClrMenuLiquidMid}"
                                GlowColour="{StaticResource ClrMenuLiquidGlow}" />

        <Grid Margin="32,36,32,36">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- Ocupa las dos filas para centrarse en la ventana entera y no en el hueco que
                 deja la barra encima de ella, que es lo que lo subia. Los margenes de arriba
                 y de abajo son iguales, asi que el centro de las dos filas es el de la
                 ventana. A este tamano no alcanza la barra; el ancho util es el otro limite,
                 porque por encima de unos 190 toca los margenes laterales. -->
            <ctl:CtlBrandMark x:Name="imgBrand" Grid.Row="0" Grid.RowSpan="2" MarkFontSize="175"
                              MarkForeground="{StaticResource BrsMenuLight}"
                              Effect="{StaticResource EfxTextShadow}"
                              Margin="0,0,0,80"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ctl:CtlPixelSurface Grid.Column="0" Style="{StaticResource StyMenuChip}"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" Width="165">
                    <StackPanel>
                        <TextBlock x:Name="lblProfile" Style="{StaticResource StyMenuChipCaption}"
                                   Text="{Binding [LobbyChat_BtnProfile], Source={StaticResource Loc}, Converter={StaticResource CnvUpperCase}}" />
                        <ctl:CtlPixelSurface Style="{StaticResource StyMenuChipInset}" Height="44" Margin="0,8,0,0">
                            <Image Source="{StaticResource IcoUserLight}" Width="18" Height="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </ctl:CtlPixelSurface>
                    </StackPanel>
                </ctl:CtlPixelSurface>

                <ctl:CtlPixelSurface Grid.Column="1" Style="{StaticResource StyMenuBar}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Grid.IsSharedSizeScope="True">
                        <Grid HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuTopButton" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuTopButton" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuTopButton" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="btnCreateAccount"
                                    Background="{StaticResource BrsMenuAction}"
                                    Style="{StaticResource StyMenuButton}" Margin="6,0,6,0"
                                    Content="{Binding [Shared_BtnCreateAccount], Source={StaticResource Loc}, Converter={StaticResource CnvUpperCase}}"
                                    Click="OnCreateAccountClick" />
                            <Button Grid.Column="1" x:Name="btnLogIn"
                                    Background="{StaticResource BrsMenuAccent}"
                                    Style="{StaticResource StyMenuPrimaryButton}" Margin="6,0,6,0"
                                    Content="{Binding [Shared_BtnLogIn], Source={StaticResource Loc}, Converter={StaticResource CnvUpperCase}}"
                                    Click="OnLogInClick" />
                            <Button Grid.Column="2" x:Name="btnPlayAsGuest"
                                    Background="{StaticResource BrsMenuEarth}"
                                    Style="{StaticResource StyMenuButton}" Margin="6,0,6,0"
                                    Content="{Binding [MainMenu_BtnPlayAsGuest], Source={StaticResource Loc}, Converter={StaticResource CnvUpperCase}}"
                                    Click="OnPlayAsGuestClick" />
                        </Grid>
                        <Grid HorizontalAlignment="Center" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuBottomButton" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuBottomButton" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="btnHowToPlay"
                                    Background="{StaticResource BrsMenuNeutral}"
                                    Style="{StaticResource StyMenuSmallButton}" Margin="6,0,6,0"
                                    Content="{Binding [Shared_BtnHowToPlay], Source={StaticResource Loc}, Converter={StaticResource CnvUpperCase}}"
                                    Click="OnHowToPlayClick" />
                            <Button Grid.Column="1" x:Name="btnExit"
                                    Background="{StaticResource BrsMenuWarn}"
                                    Style="{StaticResource StyMenuSmallAltButton}" Margin="6,0,6,0"
                                    Content="{Binding [MainMenu_BtnExit], Source={StaticResource Loc}, Converter={StaticResource CnvUpperCase}}"
                                    Click="OnExitClick" />
                        </Grid>
                    </StackPanel>
                </ctl:CtlPixelSurface>

                <ctl:CtlPixelSurface Grid.Column="2" Style="{StaticResource StyMenuChip}"
                                     HorizontalAlignment="Right" VerticalAlignment="Center" Width="165">
                    <StackPanel>
                        <TextBlock x:Name="lblLanguage" Style="{StaticResource StyMenuChipCaption}"
                                   Text="{Binding [MainMenu_LblLanguage], Source={StaticResource Loc}, Converter={StaticResource CnvUpperCase}}" />
                        <ctl:CtlPixelSurface Style="{StaticResource StyMenuChipInset}" Height="44" Margin="0,8,0,0">
                            <DockPanel LastChildFill="True" Margin="6,6,6,6">
                                <Image Source="{StaticResource IcoGlobe}" Width="17" Height="17"
                                       VerticalAlignment="Center" Margin="0,0,5,0" />
                                <ComboBox x:Name="cmbLanguage"
                                          Style="{StaticResource StyMenuLanguageBox}"
                                          VerticalAlignment="Stretch"
                                          ItemsSource="{Binding AvailableCultures, Source={StaticResource Loc}}"
                                          SelectedItem="{Binding SelectedCulture, Source={StaticResource Loc}, Mode=TwoWay}"
                                          IsEditable="False">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ShortName, Converter={StaticResource CnvUpperCase}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DockPanel>
                        </ctl:CtlPixelSurface>
                    </StackPanel>
                </ctl:CtlPixelSurface>

            </Grid>

        </Grid>
    </Grid>
</views:GuiWindowBase>
