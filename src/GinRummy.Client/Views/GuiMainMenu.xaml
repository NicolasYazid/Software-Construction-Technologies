<views:GuiWindowBase x:Class="GinRummy.Client.Views.GuiMainMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GinRummy.Client.Views"
        Title="{Binding [Shared_AppTitle], Source={StaticResource Loc}}"
        Height="720" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BrsBackground}"
        FontFamily="{StaticResource FntPrimary}">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="360">

            <TextBlock x:Name="lblAppTitle" Style="{StaticResource StyBrand}"
                       Text="{Binding [Shared_AppTitle], Source={StaticResource Loc}}" />

            <TextBlock x:Name="lblTagline" Style="{StaticResource StyOnDark}"
                       Margin="0,6,0,36"
                       Text="{Binding [MainMenu_LblTagline], Source={StaticResource Loc}}" />

            <Button x:Name="btnLogIn" Style="{StaticResource StyPrimaryButton}"
                    Content="{Binding [Shared_BtnLogIn], Source={StaticResource Loc}}"
                    Click="OnLogInClick" />

            <Button x:Name="btnCreateAccount" Style="{StaticResource StySecondaryButton}"
                    Margin="0,12,0,0"
                    Foreground="{StaticResource BrsTextOnDark}"
                    Content="{Binding [Shared_BtnCreateAccount], Source={StaticResource Loc}}"
                    Click="OnCreateAccountClick" />

            <Button x:Name="btnPlayAsGuest" Style="{StaticResource StySecondaryButton}"
                    Margin="0,12,0,0"
                    Foreground="{StaticResource BrsTextOnDark}"
                    Content="{Binding [MainMenu_BtnPlayAsGuest], Source={StaticResource Loc}}"
                    Click="OnPlayAsGuestClick" />

            <Button x:Name="btnHowToPlay" Style="{StaticResource StyLinkButtonOnDark}"
                    Margin="0,24,0,0"
                    Content="{Binding [Shared_BtnHowToPlay], Source={StaticResource Loc}}"
                    Click="OnHowToPlayClick" />

            <Button x:Name="btnExit" Style="{StaticResource StyLinkButtonOnDark}"
                    Margin="0,10,0,0"
                    Content="{Binding [MainMenu_BtnExit], Source={StaticResource Loc}}"
                    Click="OnExitClick" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,36,0,0">
                <TextBlock x:Name="lblLanguage" Style="{StaticResource StyOnDark}"
                           VerticalAlignment="Center" Margin="0,0,10,0"
                           Text="{Binding [MainMenu_LblLanguage], Source={StaticResource Loc}}" />
                <ComboBox x:Name="cmbLanguage" Style="{StaticResource StyComboBox}"
                          ItemsSource="{Binding AvailableCultures, Source={StaticResource Loc}}"
                          SelectedItem="{Binding SelectedCulture, Source={StaticResource Loc}, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName" />
            </StackPanel>

            <TextBlock x:Name="lblCultureSample" Style="{StaticResource StyOnDark}"
                       Margin="0,14,0,0" Opacity="0.7" />

        </StackPanel>
    </Grid>
</views:GuiWindowBase>
