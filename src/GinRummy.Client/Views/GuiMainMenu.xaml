<views:GuiWindowBase x:Class="GinRummy.Client.Views.GuiMainMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GinRummy.Client.Views"
        xmlns:ctl="clr-namespace:GinRummy.Client.Controls"
        Title="{Binding [Shared_AppTitle], Source={StaticResource PrvLocalization}}"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Grid Width="1460" Height="775" Background="{StaticResource BrsMenuRoot}">

        <!-- The paint reaches less far into the field than on the panel, so only the centre of the spiral shows as a background.
             The resolution keeps the blocks the same size as on the panel. -->
        <ctl:PaintedBackground BlockResolution="250" PatternScale="1.45"
                                DeepColour="{StaticResource ClrMenuLiquidDeep}"
                                MidColour="{StaticResource ClrMenuLiquidMid}"
                                GlowColour="{StaticResource ClrMenuLiquidGlow}" />

        <Grid Margin="32,36,32,36">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- It spans both rows so it is centred on the whole window and not on the gap the bar leaves above it. -->
            <ctl:BrandMark Grid.Row="0" Grid.RowSpan="2" MarkFontSize="175"
                              MarkForeground="{StaticResource BrsMenuLight}"
                              Effect="{StaticResource EfxTextShadow}"
                              Margin="0,0,0,80"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ctl:PixelSurface Grid.Column="0" Style="{StaticResource StyMenuChip}"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" Width="165">
                    <StackPanel>
                        <TextBlock x:Name="lblSettings" Style="{StaticResource StyMenuChipCaption}"
                                   Text="{Binding [MainMenu_LblSettings], Source={StaticResource PrvLocalization},
                                          Converter={StaticResource CnvUpperCase}}" />
                        <!-- Settings belong to an account and nobody is signed in on the menu, so the button stays unavailable here. -->
                        <Button x:Name="btnSettings" Style="{StaticResource StyMenuChipButton}" Margin="0,8,0,0"
                                IsEnabled="False"
                                Click="OnSettingsClick">
                            <Image Source="{StaticResource IcoGear}" Width="22" Height="22" />
                        </Button>
                    </StackPanel>
                </ctl:PixelSurface>

                <ctl:PixelSurface Grid.Column="1" Style="{StaticResource StyMenuBar}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Grid.IsSharedSizeScope="True">
                        <Grid HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuTopButton" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuTopButton" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuTopButton" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="btnCreateAccount"
                                    Background="{StaticResource BrsMenuAction}"
                                    Style="{StaticResource StyMenuButton}" Margin="6,0,6,0"
                                    Content="{Binding [Shared_BtnCreateAccount], Source={StaticResource PrvLocalization},
                                              Converter={StaticResource CnvUpperCase}}"
                                    Click="OnCreateAccountClick" />
                            <Button Grid.Column="1" x:Name="btnLogIn"
                                    Background="{StaticResource BrsMenuAccent}"
                                    Style="{StaticResource StyMenuPrimaryButton}" Margin="6,0,6,0"
                                    Content="{Binding [Shared_BtnLogIn], Source={StaticResource PrvLocalization},
                                              Converter={StaticResource CnvUpperCase}}"
                                    Click="OnLogInClick" />
                            <Button Grid.Column="2" x:Name="btnPlayAsGuest"
                                    Background="{StaticResource BrsMenuEarth}"
                                    Style="{StaticResource StyMenuButton}" Margin="6,0,6,0"
                                    Content="{Binding [MainMenu_BtnPlayAsGuest], Source={StaticResource PrvLocalization},
                                              Converter={StaticResource CnvUpperCase}}"
                                    Click="OnPlayAsGuestClick" />
                        </Grid>
                        <Grid HorizontalAlignment="Center" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuBottomButton" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuBottomButton" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="btnHowToPlay"
                                    Background="{StaticResource BrsMenuNeutral}"
                                    Style="{StaticResource StyMenuSmallButton}" Margin="6,0,6,0"
                                    Content="{Binding [Shared_BtnHowToPlay], Source={StaticResource PrvLocalization},
                                              Converter={StaticResource CnvUpperCase}}"
                                    Click="OnHowToPlayClick" />
                            <Button Grid.Column="1" x:Name="btnExit"
                                    Background="{StaticResource BrsMenuWarn}"
                                    Style="{StaticResource StyMenuSmallAltButton}" Margin="6,0,6,0"
                                    Content="{Binding [MainMenu_BtnExit], Source={StaticResource PrvLocalization},
                                              Converter={StaticResource CnvUpperCase}}"
                                    Click="OnExitClick" />
                        </Grid>
                    </StackPanel>
                </ctl:PixelSurface>

                <ctl:PixelSurface Grid.Column="2" Style="{StaticResource StyMenuChip}"
                                     HorizontalAlignment="Right" VerticalAlignment="Center" Width="165">
                    <StackPanel>
                        <TextBlock x:Name="lblLanguage" Style="{StaticResource StyMenuChipCaption}"
                                   Text="{Binding [MainMenu_LblLanguage], Source={StaticResource PrvLocalization},
                                          Converter={StaticResource CnvUpperCase}}" />
                        <ComboBox x:Name="cmbLanguage" Style="{StaticResource StyMenuLanguageBox}" Margin="0,8,0,0"
                                  Tag="{StaticResource IcoGlobe}"
                                  ItemsSource="{Binding AvailableCultures, Source={StaticResource PrvLocalization}}"
                                  SelectedItem="{Binding SelectedCulture, Source={StaticResource PrvLocalization}, Mode=TwoWay}"
                                  IsEditable="False">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ShortName, Converter={StaticResource CnvUpperCase}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </ctl:PixelSurface>

            </Grid>

        </Grid>
    </Grid>
</views:GuiWindowBase>
