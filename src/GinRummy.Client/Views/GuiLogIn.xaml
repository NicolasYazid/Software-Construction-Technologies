<views:GuiWindowBase x:Class="GinRummy.Client.Views.GuiLogIn"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GinRummy.Client.Views"
        xmlns:ctl="clr-namespace:GinRummy.Client.Controls"
        Title="{Binding [LogIn_LblTitle], Source={StaticResource Loc}}"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <!-- The height is not stated: the window declares SizeToContent, so letting the grid grow
         with the card is what keeps the last button inside it whatever the size of the text. -->
    <Grid Width="938" Background="{StaticResource BrsPageBackground}">

        <!-- The panel stretches to the height of the card instead of being measured on its own.
             The paint sits inside a canvas, which never reports the size of its children: the
             surface of the paint reports the size of its own bitmap, and left free that measure
             was what stretched the window far past the content. -->
        <Grid HorizontalAlignment="Right" Width="465" ClipToBounds="True">
            <Canvas>
                <ctl:CtlPaintBackground Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}"
                                        Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}"
                                        DeepColour="{StaticResource ClrArtworkDeep}"
                                        MidColour="{StaticResource ClrArtworkMid}"
                                        GlowColour="{StaticResource ClrArtworkGlow}" />
            </Canvas>
            <ctl:CtlBrandMark MarkFontSize="46" MarkForeground="{StaticResource BrsMenuLight}"
                              Effect="{StaticResource EfxTextShadow}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <Border Background="{StaticResource BrsSurface}" ctl:PixelShapeCommon.CornerSteps="5"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Width="471" Margin="2,0,0,0" Padding="34,20,34,30">
            <StackPanel>

                <TextBlock x:Name="lblTitle" Style="{StaticResource StyCardTitle}"
                           Text="{Binding [LogIn_LblTitle], Source={StaticResource Loc}, Converter={StaticResource CnvUpperCase}}" />
                <TextBlock x:Name="lblSubtitle" Style="{StaticResource StyCardSubtitle}"
                           Width="402" HorizontalAlignment="Left" Margin="0,20,0,0"
                           Text="{Binding [LogIn_LblSubtitle], Source={StaticResource Loc}}" />

                <TextBlock x:Name="lblEmail" Style="{StaticResource StyFieldLabel}" Margin="0,20,0,8"
                           Text="{Binding [LogIn_LblEmail], Source={StaticResource Loc}, Converter={StaticResource CnvUpperCase}}" />
                <Border Style="{StaticResource StyFieldShell}" Width="402" HorizontalAlignment="Left">
                    <DockPanel LastChildFill="True">
                        <Image Source="{StaticResource IcoMail}" Width="19" Height="19"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Grid>
                            <TextBox x:Name="txtEmail" Style="{StaticResource StyFieldInput}" />
                            <TextBlock Style="{StaticResource StyFieldPlaceholder}"
                                       Text="{Binding [LogIn_TxtEmailPlaceholder], Source={StaticResource Loc}}"
                                       Visibility="{Binding Text, ElementName=txtEmail,
                                                    Converter={StaticResource CnvEmptyTextToVisibility}}" />
                        </Grid>
                    </DockPanel>
                </Border>

                <TextBlock x:Name="lblPassword" Style="{StaticResource StyFieldLabel}" Margin="0,20,0,8"
                           Text="{Binding [LogIn_LblPassword], Source={StaticResource Loc}, Converter={StaticResource CnvUpperCase}}" />
                <Border Style="{StaticResource StyFieldShell}" Width="402" HorizontalAlignment="Left">
                    <DockPanel LastChildFill="True">
                        <Image Source="{StaticResource IcoLock}" Width="19" Height="19"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button x:Name="btnTogglePassword" DockPanel.Dock="Right"
                                Style="{StaticResource StyIconButton}"
                                VerticalAlignment="Center" Margin="12,0,0,0"
                                ToolTip="{Binding [Shared_TipTogglePassword], Source={StaticResource Loc}}"
                                Click="OnTogglePasswordClick">
                            <Image Source="{StaticResource IcoEye}" Width="19" Height="19" />
                        </Button>
                        <Grid>
                            <PasswordBox x:Name="pwdPassword" Style="{StaticResource StyFieldPassword}" MaxLength="64" />
                            <TextBox x:Name="txtPasswordShown" Style="{StaticResource StyFieldInput}" MaxLength="64"
                                     Visibility="Collapsed" />
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- The two go one above the other and not side by side: together they do not
                     fit in the width of the field, and in Spanish they are longer still, so
                     sharing a row cut the link. -->
                <StackPanel Width="402" HorizontalAlignment="Left" Margin="0,20,0,0">
                    <CheckBox x:Name="chkKeepSignedIn" Style="{StaticResource StyKeepSignedIn}"
                              HorizontalAlignment="Left"
                              Content="{Binding [Shared_ChkKeepSignedIn], Source={StaticResource Loc}}" />
                    <Button x:Name="lnkForgotPassword" Style="{StaticResource StyInlineTextButton}"
                            Margin="0,10,0,0"
                            Content="{Binding [LogIn_LnkForgotPassword], Source={StaticResource Loc}}"
                            Click="OnForgotPasswordClick" />
                </StackPanel>

                <TextBlock x:Name="lblErrorMessage" Style="{StaticResource StyCardError}"
                           Width="402" HorizontalAlignment="Left" Margin="0,12,0,0" />
                <TextBlock x:Name="lblSessionClosedElsewhere" Style="{StaticResource StyCardNotice}"
                           Width="402" HorizontalAlignment="Left" Margin="0,12,0,0"
                           Text="{Binding [LogIn_SessionClosedElsewhere], Source={StaticResource Loc}}" />

                <Button x:Name="btnLogIn" Style="{StaticResource StyCardPrimaryButton}"
                        Width="402" HorizontalAlignment="Left" Margin="0,20,0,0"
                        Content="{Binding [Shared_BtnLogIn], Source={StaticResource Loc}, Converter={StaticResource CnvUpperCase}}"
                        Click="OnLogInClick" />

                <Grid Width="402" HorizontalAlignment="Left" Margin="0,20,0,0" Height="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource StyDividerLine}" />
                    <TextBlock x:Name="lblOr" Grid.Column="1" Style="{StaticResource StyDividerLabel}"
                               Text="{Binding [Shared_LblOr], Source={StaticResource Loc}, Converter={StaticResource CnvUpperCase}}" />
                    <Border Grid.Column="2" Style="{StaticResource StyDividerLine}" />
                </Grid>

                <Button x:Name="btnCreateAccount" Style="{StaticResource StyCardOutlineButton}"
                        Width="402" HorizontalAlignment="Left" Margin="0,20,0,0"
                        Content="{Binding [Shared_BtnCreateAccount], Source={StaticResource Loc}, Converter={StaticResource CnvUpperCase}}"
                        Click="OnCreateAccountClick" />

            </StackPanel>
        </Border>
    </Grid>
</views:GuiWindowBase>
