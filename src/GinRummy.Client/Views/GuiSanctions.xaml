<views:GuiModalBase x:Class="GinRummy.Client.Views.GuiSanctions"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GinRummy.Client.Views"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        HasCloseButton="False">
    <Grid Width="780" Background="{StaticResource BrsPageBackground}">
        <Border Style="{StaticResource StyDialogCard}" Padding="0">
            <StackPanel>

                <DockPanel Margin="32,22,22,18">
                    <Button DockPanel.Dock="Right" Style="{StaticResource StyDialogCloseButton}" Click="OnCloseClick">
                        <Image Source="{StaticResource IcoClose}" Width="24" Height="24" />
                    </Button>
                    <TextBlock x:Name="lblTitle" Style="{StaticResource StyPanelTitle}"
                               Text="{Binding [Notifications_LblTitle], Source={StaticResource Loc},
                                      Converter={StaticResource CnvUpperCase}}" />
                </DockPanel>

                <TabControl Style="{StaticResource StyPanelTabs}" SelectionChanged="OnTabSelectionChanged">
                    <TabItem x:Name="tabFriendRequests"
                             Header="{Binding [Notifications_TabFriendRequests], Source={StaticResource Loc},
                                      Converter={StaticResource CnvUpperCase}}" />
                    <TabItem x:Name="tabSanctions" IsSelected="True"
                             Header="{Binding [Notifications_TabSanctions], Source={StaticResource Loc},
                                      Converter={StaticResource CnvUpperCase}}" />
                </TabControl>

                <ScrollViewer Height="420" VerticalScrollBarVisibility="Auto" Margin="32,22,22,24">
                    <StackPanel Margin="0,0,10,0">
                        <ItemsControl x:Name="lstSanctions">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StySanctionCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock x:Name="lblActive" Style="{StaticResource StySanctionBadge}"
                                                               Text="{Binding [Sanctions_LblActive],
                                                                      Source={StaticResource Loc}}" />
                                                    <TextBlock x:Name="lblServed"
                                                               Style="{StaticResource StySanctionBadgeServed}"
                                                               Text="{Binding [Sanctions_LblServed],
                                                                      Source={StaticResource Loc}}" />
                                                </Grid>
                                                <TextBlock x:Name="lblReasonBan" Style="{StaticResource StySanctionReason}"
                                                           Text="{Binding ReasonName}" />
                                            </StackPanel>
                                            <Grid Grid.Column="1" Margin="18,0,0,0">
                                                <TextBlock x:Name="lblTimeRemaining" Style="{StaticResource StySanctionDetail}">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource CnvLocalizedFormat}">
                                                            <Binding Path="[Sanctions_LblTimeRemaining]"
                                                                     Source="{StaticResource Loc}" />
                                                            <Binding Path="RemainingTime" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock x:Name="lblServedAt" Style="{StaticResource StySanctionDetail}">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource CnvLocalizedFormat}"
                                                                      ConverterParameter="d">
                                                            <Binding Path="[Sanctions_LblServedAt]"
                                                                     Source="{StaticResource Loc}" />
                                                            <Binding Path="ServedAt" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter TargetName="lblActive" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="lblTimeRemaining" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                            <Setter TargetName="lblServed" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="lblServedAt" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="lblEmptyState" Style="{StaticResource StyPanelEmpty}"
                                   Visibility="Collapsed"
                                   Text="{Binding [Sanctions_EmptyState], Source={StaticResource Loc}}" />
                    </StackPanel>
                </ScrollViewer>

            </StackPanel>
        </Border>
    </Grid>
</views:GuiModalBase>
