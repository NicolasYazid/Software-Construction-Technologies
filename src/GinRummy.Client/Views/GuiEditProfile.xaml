<views:GuiModalBase x:Class="GinRummy.Client.Views.GuiEditProfile"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GinRummy.Client.Views"
        xmlns:ctl="clr-namespace:GinRummy.Client.Controls"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        HasCloseButton="False">
    <!-- The editor is drawn like the settings: a dialog of the room, shorter than the windows
         that open it so its four edges stay in sight; what does not fit scrolls inside it. -->
    <ContentControl Width="500" Height="700" Style="{StaticResource StyLobbyDialog}" Padding="0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,4,8">
            <StackPanel Margin="40,30,34,32">

                <TextBlock x:Name="lblTitle" Style="{StaticResource StyPanelTitle}" HorizontalAlignment="Center"
                           Text="{Binding [EditProfile_LblTitle], Source={StaticResource Loc},
                                  Converter={StaticResource CnvUpperCase}}" />

                <Grid Width="112" Height="112" Margin="0,24,0,0">
                    <Border Style="{StaticResource StyAvatarProfile}">
                        <Image Style="{StaticResource StyAvatarIconProfile}" />
                    </Border>
                    <Image x:Name="imgProfilePicture" Stretch="UniformToFill">
                        <Image.Clip>
                            <EllipseGeometry Center="56,56" RadiusX="56" RadiusY="56" />
                        </Image.Clip>
                    </Image>
                </Grid>
                <Button x:Name="btnChangePhoto" Style="{StaticResource StyCenteredTextButton}" Margin="0,14,0,0"
                        Content="{Binding [EditProfile_BtnChangePhoto], Source={StaticResource Loc}}"
                        Click="OnChangePhotoClick" />
                <Button x:Name="btnRemovePhoto" Style="{StaticResource StyCenteredTextButton}" Margin="0,6,0,0"
                        Content="{Binding [EditProfile_BtnRemovePhoto], Source={StaticResource Loc}}"
                        Click="OnRemovePhotoClick" />
                <TextBlock x:Name="lblImageRequirements" Style="{StaticResource StySettingHint}"
                           TextAlignment="Center" Margin="0,8,0,0" />

                <TextBlock x:Name="lblUsername" Style="{StaticResource StyFieldLabel}" Margin="0,24,0,8"
                           Text="{Binding [EditProfile_LblUsername], Source={StaticResource Loc}}" />
                <!-- The database limits the name to twenty characters. -->
                <ctl:PixelBorder Style="{StaticResource StyGlassFieldShell}">
                    <TextBox x:Name="txtUsername" Style="{StaticResource StyFieldInput}" MaxLength="20" />
                </ctl:PixelBorder>

                <TextBlock x:Name="lblBio" Style="{StaticResource StyFieldLabel}" Margin="0,20,0,8"
                           Text="{Binding [EditProfile_LblBio], Source={StaticResource Loc}}" />
                <ctl:PixelBorder Style="{StaticResource StyGlassFieldArea}">
                    <TextBox x:Name="txtBio" Style="{StaticResource StyFieldAreaInput}"
                             TextChanged="OnBioTextChanged" />
                </ctl:PixelBorder>
                <TextBlock x:Name="lblBioCounter" Style="{StaticResource StySettingHint}" />

                <TextBlock x:Name="lblSocialLinks" Style="{StaticResource StyFieldLabel}" Margin="0,22,0,10"
                           Text="{Binding [EditProfile_LblSocialLinks], Source={StaticResource Loc},
                                  Converter={StaticResource CnvUpperCase}}" />
                <ItemsControl x:Name="lstSocialLinks">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ctl:PixelBorder Style="{StaticResource StySocialLinkRow}">
                                <DockPanel LastChildFill="True">
                                    <Button x:Name="btnUnlink" DockPanel.Dock="Right" Style="{StaticResource StyRowTextButton}"
                                            Content="{Binding [EditProfile_BtnUnlink], Source={StaticResource Loc},
                                                      Converter={StaticResource CnvUpperCase}}"
                                            Click="OnUnlinkClick" />
                                    <TextBlock Style="{StaticResource StySocialPlatform}" Text="{Binding PlatformName}" />
                                    <TextBlock Style="{StaticResource StySocialUrl}" Text="{Binding Url}" />
                                </DockPanel>
                            </ctl:PixelBorder>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- The form of a new link follows the visibility of its first label, which the
                     code switches when the player asks to add a link (CU-31). -->
                <StackPanel Visibility="{Binding Visibility, ElementName=lblPlatform}">
                    <TextBlock x:Name="lblPlatform" Style="{StaticResource StyFieldLabel}" Margin="0,6,0,8"
                               Visibility="Collapsed"
                               Text="{Binding [EditProfile_LblPlatform], Source={StaticResource Loc}}" />
                    <ComboBox x:Name="cmbPlatform" Style="{StaticResource StyMenuLanguageBox}" Width="220"
                              HorizontalAlignment="Left">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock x:Name="lblSocialUrl" Style="{StaticResource StyFieldLabel}" Margin="0,16,0,8"
                               Text="{Binding [EditProfile_LblSocialUrl], Source={StaticResource Loc}}" />
                    <!-- The database limits the address to two hundred and fifty-five characters. -->
                    <ctl:PixelBorder Style="{StaticResource StyGlassFieldShell}">
                        <Grid>
                            <TextBox x:Name="txtSocialUrl" Style="{StaticResource StyFieldInput}" MaxLength="255" />
                            <TextBlock x:Name="lblFieldSocialLink" Style="{StaticResource StyFieldPlaceholder}"
                                       Text="{Binding [EditProfile_FieldSocialLink], Source={StaticResource Loc}}"
                                       Visibility="{Binding Text, ElementName=txtSocialUrl,
                                                    Converter={StaticResource CnvEmptyTextToVisibility}}" />
                        </Grid>
                    </ctl:PixelBorder>
                </StackPanel>

                <Button x:Name="btnAddSocialLink" Style="{StaticResource StyCardOutlineButton}" Margin="0,12,0,0"
                        Content="{Binding [EditProfile_BtnAddSocialLink], Source={StaticResource Loc},
                                  Converter={StaticResource CnvUpperCase}}"
                        Click="OnAddSocialLinkClick" />

                <TextBlock x:Name="lblErrorMessage" Style="{StaticResource StyCardError}" Margin="0,16,0,0" />
                <TextBlock x:Name="lblUsernameChanged" Style="{StaticResource StyCardNotice}" Margin="0,16,0,0"
                           Text="{Binding [EditProfile_UsernameChanged], Source={StaticResource Loc}}" />

                <Button x:Name="btnSave" Style="{StaticResource StyCardPrimaryButton}" Margin="0,24,0,0"
                        Content="{Binding [Shared_BtnSave], Source={StaticResource Loc},
                                  Converter={StaticResource CnvUpperCase}}"
                        Click="OnSaveClick" />
                <Button x:Name="btnCancel" Style="{StaticResource StyCardOutlineButton}" Margin="0,14,0,0"
                        Content="{Binding [Shared_BtnCancel], Source={StaticResource Loc},
                                  Converter={StaticResource CnvUpperCase}}"
                        Click="OnCancelClick" />

            </StackPanel>
        </ScrollViewer>
    </ContentControl>
</views:GuiModalBase>
