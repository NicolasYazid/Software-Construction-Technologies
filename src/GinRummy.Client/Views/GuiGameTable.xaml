<views:GuiWindowBase x:Class="GinRummy.Client.Views.GuiGameTable"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GinRummy.Client.Views"
        Title="{Binding [Shared_AppTitle], Source={StaticResource Loc}}"
        SizeToContent="WidthAndHeight"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Styles/GameTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- The table has the size of the lobby, since it takes its place when a match starts and
         gives it back when the match ends. -->
    <Grid Width="1360" Height="780" Background="{StaticResource BrsPageBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- Chat of the match -->
        <Border Style="{StaticResource StyLobbyPanel}" Margin="12,12,6,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="lblChat" Style="{StaticResource StyGroupHeader}" Margin="20,18,20,10"
                           Text="{Binding [GameTable_LblChat], Source={StaticResource Loc},
                                  Converter={StaticResource CnvUpperCase}}" />

                <ListBox x:Name="lstMessages" Grid.Row="1" Style="{StaticResource StyChatList}"
                         ItemTemplate="{StaticResource TplMatchChatMessage}" />

                <Border Grid.Row="2" Style="{StaticResource StyChatComposer}" Padding="14,14,14,16">
                    <Border Style="{StaticResource StyPanelSearchShell}">
                        <DockPanel LastChildFill="True">
                            <!-- The dictionary gives the button of this chat no tooltip of its own, so it
                                 borrows the one of the chat of the lobby, which does the same. -->
                            <Button x:Name="btnSend" DockPanel.Dock="Right" Style="{StaticResource StyIconButton}"
                                    Width="28" Height="28" Margin="8,0,0,0" VerticalAlignment="Center"
                                    ToolTip="{Binding [LobbyChat_TipSend], Source={StaticResource Loc}}"
                                    Click="OnSendClick">
                                <Image Source="{StaticResource IcoSend}" Width="22" Height="22" />
                            </Button>
                            <Grid>
                                <TextBox x:Name="txtMessage" Style="{StaticResource StyPanelSearchInput}"
                                         KeyDown="OnMessageKeyDown" />
                                <TextBlock Style="{StaticResource StyPanelSearchPlaceholder}"
                                           Text="{Binding [GameTable_TxtMessagePlaceholder], Source={StaticResource Loc}}"
                                           Visibility="{Binding Text, ElementName=txtMessage,
                                                        Converter={StaticResource CnvEmptyTextToVisibility}}" />
                            </Grid>
                        </DockPanel>
                    </Border>
                </Border>
            </Grid>
        </Border>

        <!-- Table -->
        <Grid Grid.Column="1" Margin="12,18,12,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- The name of the opponent is data and keeps the case the player gave it. -->
            <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                <TextBlock Style="{StaticResource StyTableCaption}" Text="{Binding OpponentName}" />
                <Border Style="{StaticResource StyTablePill}">
                    <TextBlock x:Name="lblCardCount" Style="{StaticResource StyTablePillText}" />
                </Border>
            </StackPanel>

            <ItemsControl x:Name="lstOpponentCards" Grid.Row="1" HorizontalAlignment="Center" Margin="0,16,0,0"
                          ItemTemplate="{StaticResource TplCardBack}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <Grid Grid.Row="2" Height="210" Margin="0,18,0,0">
                <Rectangle Style="{StaticResource StyTableSurface}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <Border Style="{StaticResource StyCardBackLarge}" />
                        <TextBlock x:Name="lblStock" Style="{StaticResource StyTableNote}" Margin="0,10,0,0" />
                    </StackPanel>
                    <StackPanel Margin="32,0,0,0">
                        <Grid>
                            <Rectangle Style="{StaticResource StyCardSlot}" />
                            <ItemsControl x:Name="lstDiscard" ItemTemplate="{StaticResource TplCardFaceLarge}" />
                        </Grid>
                        <TextBlock x:Name="lblDiscard" Style="{StaticResource StyTableNote}" Margin="0,10,0,0"
                                   Text="{Binding [GameTable_LblDiscard], Source={StaticResource Loc},
                                          Converter={StaticResource CnvUpperCase}}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <DockPanel Grid.Row="3" Margin="8,16,8,0" LastChildFill="False">
                <TextBlock x:Name="lblYourHand" DockPanel.Dock="Left" Style="{StaticResource StyTableCaption}"
                           Text="{Binding [GameTable_LblYourHand], Source={StaticResource Loc},
                                  Converter={StaticResource CnvUpperCase}}" />
                <Border DockPanel.Dock="Left" Style="{StaticResource StyTablePill}">
                    <TextBlock x:Name="lblYourCardCount" Style="{StaticResource StyTablePillText}" />
                </Border>
                <TextBlock x:Name="lblDeadwoodInline" DockPanel.Dock="Right" Style="{StaticResource StyTableNote}" />
            </DockPanel>

            <ListBox x:Name="lstHand" Grid.Row="4" Style="{StaticResource StyHandList}" HorizontalAlignment="Center"
                     ItemTemplate="{StaticResource TplCardFace}"
                     PreviewMouseLeftButtonDown="OnHandPreviewMouseLeftButtonDown"
                     PreviewMouseMove="OnHandPreviewMouseMove"
                     Drop="OnHandDrop" />

            <TextBlock x:Name="lblHandHint" Grid.Row="5" Style="{StaticResource StyTableNote}" Margin="0,10,0,0"
                       Text="{Binding [GameTable_LblHandHint], Source={StaticResource Loc},
                              Converter={StaticResource CnvUpperCase}}" />

            <StackPanel Grid.Row="6" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock x:Name="lblDeadwood" Style="{StaticResource StyDeadwoodLabel}"
                               Text="{Binding [GameTable_LblDeadwood], Source={StaticResource Loc},
                                      Converter={StaticResource CnvUpperCase}}" />
                    <TextBlock Style="{StaticResource StyDeadwoodValue}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource CnvCultureNumber}" ConverterParameter="N0">
                                <Binding Path="Deadwood" />
                                <Binding Path="CurrentCulture" Source="{StaticResource Loc}" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Button x:Name="btnTake" Style="{StaticResource StyLobbyActionButton}" Margin="0,0,16,0"
                            Content="{Binding [GameTable_BtnTake], Source={StaticResource Loc},
                                      Converter={StaticResource CnvUpperCase}}"
                            Click="OnTakeClick" />
                    <Button x:Name="btnPass" Style="{StaticResource StyLobbySecondaryButton}"
                            Content="{Binding [GameTable_BtnPass], Source={StaticResource Loc},
                                      Converter={StaticResource CnvUpperCase}}"
                            Click="OnPassClick" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Score, log and actions of the match -->
        <Border Grid.Column="2" Style="{StaticResource StyLobbyPanel}" Margin="6,12,12,12">
            <DockPanel Margin="18,4,18,18" LastChildFill="True">
                <StackPanel DockPanel.Dock="Bottom">
                    <Button x:Name="btnHowToPlay" Style="{StaticResource StyLobbySecondaryButton}"
                            Content="{Binding [Shared_BtnHowToPlay], Source={StaticResource Loc},
                                      Converter={StaticResource CnvUpperCase}}"
                            Click="OnHowToPlayClick" />
                    <Button x:Name="btnForfeit" Style="{StaticResource StyForfeitButton}" Margin="0,12,0,0"
                            Content="{Binding [GameTable_BtnForfeit], Source={StaticResource Loc},
                                      Converter={StaticResource CnvUpperCase}}"
                            Click="OnForfeitClick" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <TextBlock x:Name="lblMatch" Style="{StaticResource StyGroupHeader}"
                               Text="{Binding [GameTable_LblMatch], Source={StaticResource Loc},
                                      Converter={StaticResource CnvUpperCase}}" />
                    <Border Style="{StaticResource StyGroupRule}" />
                    <DockPanel Style="{StaticResource StyMatchStatRow}">
                        <TextBlock x:Name="lblPlayerScoreValue" Style="{StaticResource StyMatchStatValue}" />
                        <TextBlock x:Name="lblYou" Style="{StaticResource StyMatchStatLabel}"
                                   Text="{Binding [GameTable_LblYou], Source={StaticResource Loc}}" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource StyMatchStatRow}">
                        <TextBlock x:Name="lblOpponentScoreValue" Style="{StaticResource StyMatchStatValue}" />
                        <TextBlock Style="{StaticResource StyMatchStatLabel}" Text="{Binding OpponentName}" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource StyMatchStatRow}">
                        <TextBlock x:Name="lblTargetValue" Style="{StaticResource StyMatchStatValue}" />
                        <TextBlock x:Name="lblTarget" Style="{StaticResource StyMatchStatLabel}"
                                   Text="{Binding [GameTable_LblTarget], Source={StaticResource Loc}}" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource StyMatchStatRow}">
                        <TextBlock x:Name="lblCardsInStockValue" Style="{StaticResource StyMatchStatValue}" />
                        <TextBlock x:Name="lblCardsInStock" Style="{StaticResource StyMatchStatLabel}"
                                   Text="{Binding [GameTable_LblCardsInStock], Source={StaticResource Loc}}" />
                    </DockPanel>

                    <TextBlock x:Name="lblMatchLog" Style="{StaticResource StyGroupHeader}"
                               Text="{Binding [GameTable_LblMatchLog], Source={StaticResource Loc},
                                      Converter={StaticResource CnvUpperCase}}" />
                    <Border Style="{StaticResource StyGroupRule}" />
                </StackPanel>

                <ListBox x:Name="lstMatchLog" Style="{StaticResource StyChatList}" Margin="0,4,0,12"
                         ItemTemplate="{StaticResource TplMatchLogEntry}" />
            </DockPanel>
        </Border>
    </Grid>
</views:GuiWindowBase>
