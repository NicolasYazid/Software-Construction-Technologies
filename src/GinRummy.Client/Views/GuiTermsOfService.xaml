<views:GuiModalBase x:Class="GinRummy.Client.Views.GuiTermsOfService"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GinRummy.Client.Views"
        xmlns:ctl="clr-namespace:GinRummy.Client.Controls"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        HasCloseButton="False">
    <Grid Width="938" Height="635" Background="{StaticResource BrsPageBackground}">
        <Border Background="{StaticResource BrsSurface}" ctl:PixelShapeCommon.CornerSteps="5" Padding="60,52,60,52">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="lblTitle" Grid.Row="0" Style="{StaticResource StyCardTitle}"
                           Text="{Binding [TermsOfService_LblTitle], Source={StaticResource Loc}}" />

                <!-- The body scrolls on its own because the final text of the terms is still
                     pending and will be longer than the draft, while the button has to stay
                     where the prototype puts it. -->
                <ScrollViewer Grid.Row="1" Margin="0,24,0,24" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="lblBody" Style="{StaticResource StyCardSubtitle}" MaxWidth="700"
                               HorizontalAlignment="Left"
                               Text="{Binding [TermsOfService_LblBody], Source={StaticResource Loc}}" />
                </ScrollViewer>

                <Button x:Name="btnClose" Grid.Row="2" Style="{StaticResource StyDialogSecondaryButton}"
                        Width="200" HorizontalAlignment="Left"
                        Content="{Binding [Shared_BtnClose], Source={StaticResource Loc},
                                  Converter={StaticResource CnvUpperCase}}"
                        Click="OnCloseClick" />
            </Grid>
        </Border>
    </Grid>
</views:GuiModalBase>
