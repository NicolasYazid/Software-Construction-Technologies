<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings configSource="ConnectionStrings.config" />
  <entityFramework>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>
  <system.serviceModel>
    <!-- Every value is written down on purpose instead of relying on the WCF defaults. -->
    <bindings>
      <netTcpBinding>
        <!-- Binding of the request-reply services. The security keeps the netTcpBinding default
             (transport, Windows credentials, encrypted and signed) until the team decides R-07. -->
        <binding name="RequestReplyTcp"
                 openTimeout="00:00:15"
                 closeTimeout="00:00:15"
                 sendTimeout="00:00:30"
                 receiveTimeout="00:10:00"
                 maxReceivedMessageSize="65536"
                 maxConnections="10"
                 listenBacklog="10">
          <readerQuotas maxStringContentLength="8192" maxArrayLength="16384" />
          <security mode="Transport">
            <transport clientCredentialType="Windows" protectionLevel="EncryptAndSign" />
          </security>
        </binding>
      </netTcpBinding>
    </bindings>
    <behaviors>
      <serviceBehaviors>
        <!-- Each service has its own host, so these limits apply to each service separately. -->
        <behavior name="IsolatedService">
          <serviceThrottling maxConcurrentCalls="20" maxConcurrentSessions="10" maxConcurrentInstances="10" />
          <serviceDebug includeExceptionDetailInFaults="false" />
          <serviceMetadata httpGetEnabled="true" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
    <services>
      <!-- One service element, and one port, per service. -->
      <service name="GinRummy.Services.Services.RankingsService" behaviorConfiguration="IsolatedService">
        <host>
          <baseAddresses>
            <add baseAddress="net.tcp://localhost:8000/RankingsService" />
            <add baseAddress="http://localhost:8001/RankingsService" />
          </baseAddresses>
        </host>
        <endpoint address=""
                  binding="netTcpBinding"
                  bindingConfiguration="RequestReplyTcp"
                  contract="GinRummy.Contracts.IRankingService" />
        <endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange" />
      </service>
    </services>
  </system.serviceModel>
</configuration>
