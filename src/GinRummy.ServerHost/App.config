<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <!-- The settings use file and not configSource, so the server still starts without SmtpSettings.config.
       Every email then ends as Failed while the services that do not send email keep working. -->
  <appSettings file="SmtpSettings.config" />
  <connectionStrings configSource="ConnectionStrings.config" />
  <entityFramework>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>
  <system.serviceModel>
    <!-- Every value is written down, so the limits of the server can be read here without looking up the WCF defaults. -->
    <bindings>
      <netTcpBinding>
        <!-- The request-reply services keep the default security of netTcpBinding (transport, Windows credentials,
             encrypted and signed), because the team has not chosen another one yet. -->
        <binding name="RequestReplyTcp"
                 openTimeout="00:00:15"
                 closeTimeout="00:00:15"
                 sendTimeout="00:00:30"
                 receiveTimeout="00:10:00"
                 maxReceivedMessageSize="65536"
                 maxConnections="20"
                 listenBacklog="20">
          <readerQuotas maxStringContentLength="8192" maxArrayLength="16384" />
          <security mode="Transport">
            <transport clientCredentialType="Windows" protectionLevel="EncryptAndSign" />
          </security>
        </binding>
        <!-- The profile service has its own binding with room for a picture of up to 2 MB, so the other services
             still refuse large messages. Its connection limits match the other bindings because every service shares
             the listener of port 8000. -->
        <binding name="ProfileTcp"
                 openTimeout="00:00:15"
                 closeTimeout="00:00:15"
                 sendTimeout="00:00:30"
                 receiveTimeout="00:10:00"
                 maxReceivedMessageSize="2228224"
                 maxBufferSize="2228224"
                 maxConnections="20"
                 listenBacklog="20">
          <readerQuotas maxStringContentLength="8192" maxArrayLength="2097152" />
          <security mode="Transport">
            <transport clientCredentialType="Windows" protectionLevel="EncryptAndSign" />
          </security>
        </binding>
        <!-- Binding of the services with a callback (presence and chat), whose session stays open for as long as the player is connected.
             The reliable session faults the channel when the client stops answering, so the server notices a dropped player.
             The receive timeout counts only application messages and a player may not send any for a long time,
             so it is long; the inactivity timeout of the reliable session is what detects a dead client. -->
        <binding name="DuplexTcp"
                 openTimeout="00:00:15"
                 closeTimeout="00:00:15"
                 sendTimeout="00:00:30"
                 receiveTimeout="1.00:00:00"
                 maxReceivedMessageSize="65536"
                 maxConnections="20"
                 listenBacklog="20">
          <readerQuotas maxStringContentLength="8192" maxArrayLength="16384" />
          <reliableSession enabled="true" ordered="true" inactivityTimeout="00:01:00" />
          <security mode="Transport">
            <transport clientCredentialType="Windows" protectionLevel="EncryptAndSign" />
          </security>
        </binding>
      </netTcpBinding>
    </bindings>
    <behaviors>
      <serviceBehaviors>
        <!-- Each service has its own host, so these limits apply to each service separately. -->
        <behavior name="IsolatedService">
          <serviceThrottling maxConcurrentCalls="20" maxConcurrentSessions="10" maxConcurrentInstances="10" />
          <serviceDebug includeExceptionDetailInFaults="false" />
          <serviceMetadata />
        </behavior>
        <!-- The services with a callback keep one session per connected player, so they allow more sessions than the others. -->
        <behavior name="DuplexService">
          <serviceThrottling maxConcurrentCalls="20" maxConcurrentSessions="20" maxConcurrentInstances="20" />
          <serviceDebug includeExceptionDetailInFaults="false" />
          <serviceMetadata />
        </behavior>
      </serviceBehaviors>
    </behaviors>
    <services>
      <!-- One service element per service. Every service listens on port 8000 and every metadata endpoint on port 8001;
           the path after the port tells them apart. -->
      <service name="GinRummy.Services.Services.SocialCommunication.ChatMessageService" behaviorConfiguration="DuplexService">
        <endpoint name="ChatMessageService"
                  address="net.tcp://localhost:8000/ChatMessageService"
                  binding="netTcpBinding"
                  bindingConfiguration="DuplexTcp"
                  contract="GinRummy.Contracts.Services.SocialCommunication.IChatMessageService" />
        <endpoint address="net.tcp://localhost:8001/ChatMessageService/mex"
                  binding="mexTcpBinding"
                  contract="IMetadataExchange" />
      </service>
      <service name="GinRummy.Services.Services.DirectDuel.DirectDuelService" behaviorConfiguration="DuplexService">
        <endpoint name="DirectDuelService"
                  address="net.tcp://localhost:8000/DirectDuelService"
                  binding="netTcpBinding"
                  bindingConfiguration="DuplexTcp"
                  contract="GinRummy.Contracts.Services.DirectDuel.IDirectDuelService" />
        <endpoint address="net.tcp://localhost:8001/DirectDuelService/mex"
                  binding="mexTcpBinding"
                  contract="IMetadataExchange" />
      </service>
      <service name="GinRummy.Services.Services.Gameplay.GameService" behaviorConfiguration="DuplexService">
        <endpoint name="GameService"
                  address="net.tcp://localhost:8000/GameService"
                  binding="netTcpBinding"
                  bindingConfiguration="DuplexTcp"
                  contract="GinRummy.Contracts.Services.Gameplay.IGameService" />
        <endpoint address="net.tcp://localhost:8001/GameService/mex"
                  binding="mexTcpBinding"
                  contract="IMetadataExchange" />
      </service>
      <service name="GinRummy.Services.Services.PlayerCareer.LeaderboardService" behaviorConfiguration="IsolatedService">
        <endpoint name="LeaderboardService"
                  address="net.tcp://localhost:8000/LeaderboardService"
                  binding="netTcpBinding"
                  bindingConfiguration="RequestReplyTcp"
                  contract="GinRummy.Contracts.Services.PlayerCareer.ILeaderboardService" />
        <!-- The metadata travels over TCP because HTTP is forbidden for the game (R-11). The metadata endpoints use
             their own port because their binding has no security and cannot share the listener of the services. -->
        <endpoint address="net.tcp://localhost:8001/LeaderboardService/mex"
                  binding="mexTcpBinding"
                  contract="IMetadataExchange" />
      </service>
      <service name="GinRummy.Services.Services.Authentication.LogInService" behaviorConfiguration="IsolatedService">
        <endpoint name="LogInService"
                  address="net.tcp://localhost:8000/LogInService"
                  binding="netTcpBinding"
                  bindingConfiguration="RequestReplyTcp"
                  contract="GinRummy.Contracts.Services.Authentication.ILogInService" />
        <endpoint address="net.tcp://localhost:8001/LogInService/mex"
                  binding="mexTcpBinding"
                  contract="IMetadataExchange" />
      </service>
      <service name="GinRummy.Services.Services.PlayerPresence.PlayerPresenceService" behaviorConfiguration="DuplexService">
        <endpoint name="PlayerPresenceService"
                  address="net.tcp://localhost:8000/PlayerPresenceService"
                  binding="netTcpBinding"
                  bindingConfiguration="DuplexTcp"
                  contract="GinRummy.Contracts.Services.PlayerPresence.IPlayerPresenceService" />
        <endpoint address="net.tcp://localhost:8001/PlayerPresenceService/mex"
                  binding="mexTcpBinding"
                  contract="IMetadataExchange" />
      </service>
      <service name="GinRummy.Services.Services.Authentication.SignUpService" behaviorConfiguration="IsolatedService">
        <endpoint name="SignUpService"
                  address="net.tcp://localhost:8000/SignUpService"
                  binding="netTcpBinding"
                  bindingConfiguration="RequestReplyTcp"
                  contract="GinRummy.Contracts.Services.Authentication.ISignUpService" />
        <endpoint address="net.tcp://localhost:8001/SignUpService/mex"
                  binding="mexTcpBinding"
                  contract="IMetadataExchange" />
      </service>
      <service name="GinRummy.Services.Services.PlayerCustomization.PlayerProfileService" behaviorConfiguration="IsolatedService">
        <endpoint name="PlayerProfileService"
                  address="net.tcp://localhost:8000/PlayerProfileService"
                  binding="netTcpBinding"
                  bindingConfiguration="ProfileTcp"
                  contract="GinRummy.Contracts.Services.PlayerCustomization.IPlayerProfileService" />
        <endpoint address="net.tcp://localhost:8001/PlayerProfileService/mex"
                  binding="mexTcpBinding"
                  contract="IMetadataExchange" />
      </service>
      <service name="GinRummy.Services.Services.AccountProtection.AccountSettingsService" behaviorConfiguration="IsolatedService">
        <endpoint name="AccountSettingsService"
                  address="net.tcp://localhost:8000/AccountSettingsService"
                  binding="netTcpBinding"
                  bindingConfiguration="RequestReplyTcp"
                  contract="GinRummy.Contracts.Services.AccountProtection.IAccountSettingsService" />
        <endpoint address="net.tcp://localhost:8001/AccountSettingsService/mex"
                  binding="mexTcpBinding"
                  contract="IMetadataExchange" />
      </service>
    </services>
  </system.serviceModel>
</configuration>
