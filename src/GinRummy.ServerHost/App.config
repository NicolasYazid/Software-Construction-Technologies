<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <!-- file instead of configSource: without SmtpSettings.config the server still starts, and every email ends as
       Failed while the services that do not send email keep working (QAS-12). -->
  <appSettings file="SmtpSettings.config" />
  <connectionStrings configSource="ConnectionStrings.config" />
  <entityFramework>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>
  <system.serviceModel>
    <!-- Every value is written down on purpose instead of relying on the WCF defaults. -->
    <bindings>
      <netTcpBinding>
        <!-- Binding of the request-reply services. The security keeps the netTcpBinding default
             (transport, Windows credentials, encrypted and signed) until the team decides R-07. -->
        <binding name="RequestReplyTcp"
                 openTimeout="00:00:15"
                 closeTimeout="00:00:15"
                 sendTimeout="00:00:30"
                 receiveTimeout="00:10:00"
                 maxReceivedMessageSize="65536"
                 maxConnections="10"
                 listenBacklog="10">
          <readerQuotas maxStringContentLength="8192" maxArrayLength="16384" />
          <security mode="Transport">
            <transport clientCredentialType="Windows" protectionLevel="EncryptAndSign" />
          </security>
        </binding>
        <!-- Binding of the presence service, whose session stays open for as long as the player is connected.
             The reliable session faults the channel when the client stops answering, so the server notices a dropped player.
             The receive timeout counts only application messages and the client sends just one (the subscription),
             so it is long; the inactivity timeout of the reliable session is what detects a dead client. -->
        <binding name="PresenceTcp"
                 openTimeout="00:00:15"
                 closeTimeout="00:00:15"
                 sendTimeout="00:00:30"
                 receiveTimeout="1.00:00:00"
                 maxReceivedMessageSize="65536"
                 maxConnections="20"
                 listenBacklog="20">
          <readerQuotas maxStringContentLength="8192" maxArrayLength="16384" />
          <reliableSession enabled="true" ordered="true" inactivityTimeout="00:01:00" />
          <security mode="Transport">
            <transport clientCredentialType="Windows" protectionLevel="EncryptAndSign" />
          </security>
        </binding>
      </netTcpBinding>
    </bindings>
    <behaviors>
      <serviceBehaviors>
        <!-- Each service has its own host, so these limits apply to each service separately. -->
        <behavior name="IsolatedService">
          <serviceThrottling maxConcurrentCalls="20" maxConcurrentSessions="10" maxConcurrentInstances="10" />
          <serviceDebug includeExceptionDetailInFaults="false" />
          <serviceMetadata />
        </behavior>
        <!-- The presence service keeps one session per connected player, so it allows more sessions than the others. -->
        <behavior name="PresenceService">
          <serviceThrottling maxConcurrentCalls="20" maxConcurrentSessions="20" maxConcurrentInstances="20" />
          <serviceDebug includeExceptionDetailInFaults="false" />
          <serviceMetadata />
        </behavior>
      </serviceBehaviors>
    </behaviors>
    <services>
      <!-- One service element, with its own ports, per service. -->
      <service name="GinRummy.Services.Services.LeaderboardService" behaviorConfiguration="IsolatedService">
        <endpoint name="LeaderboardService"
                  address="net.tcp://localhost:8000/LeaderboardService"
                  binding="netTcpBinding"
                  bindingConfiguration="RequestReplyTcp"
                  contract="GinRummy.Contracts.Services.ILeaderboardService" />
        <!-- The metadata travels over TCP because HTTP is forbidden for the game (R-11). It listens on its
             own port because its binding has no security and cannot share the listener of the service. -->
        <endpoint address="net.tcp://localhost:8001/LeaderboardService/mex"
                  binding="mexTcpBinding"
                  contract="IMetadataExchange" />
      </service>
      <service name="GinRummy.Services.Services.LogInService" behaviorConfiguration="IsolatedService">
        <endpoint name="LogInService"
                  address="net.tcp://localhost:8002/LogInService"
                  binding="netTcpBinding"
                  bindingConfiguration="RequestReplyTcp"
                  contract="GinRummy.Contracts.Services.ILogInService" />
        <endpoint address="net.tcp://localhost:8003/LogInService/mex"
                  binding="mexTcpBinding"
                  contract="IMetadataExchange" />
      </service>
      <service name="GinRummy.Services.Services.PlayerPresenceService" behaviorConfiguration="PresenceService">
        <endpoint name="PlayerPresenceService"
                  address="net.tcp://localhost:8004/PlayerPresenceService"
                  binding="netTcpBinding"
                  bindingConfiguration="PresenceTcp"
                  contract="GinRummy.Contracts.Services.IPlayerPresenceService" />
        <endpoint address="net.tcp://localhost:8005/PlayerPresenceService/mex"
                  binding="mexTcpBinding"
                  contract="IMetadataExchange" />
      </service>
      <service name="GinRummy.Services.Services.SignUpService" behaviorConfiguration="IsolatedService">
        <endpoint name="SignUpService"
                  address="net.tcp://localhost:8006/SignUpService"
                  binding="netTcpBinding"
                  bindingConfiguration="RequestReplyTcp"
                  contract="GinRummy.Contracts.Services.ISignUpService" />
        <endpoint address="net.tcp://localhost:8007/SignUpService/mex"
                  binding="mexTcpBinding"
                  contract="IMetadataExchange" />
      </service>
    </services>
  </system.serviceModel>
</configuration>
