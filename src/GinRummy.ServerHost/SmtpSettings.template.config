<?xml version="1.0" encoding="utf-8"?>
<!-- Copy this file as SmtpSettings.config in the same folder and fill in the sender account.
     SmtpSettings.config is listed in .gitignore because it holds the sender's password: never commit it. -->
<appSettings>
  <add key="SmtpHost" value="smtp.gmail.com" />
  <!-- SmtpClient only supports STARTTLS, so the port is 587 and not 465. -->
  <add key="SmtpPort" value="587" />
  <add key="SmtpSenderAddress" value="" />
  <add key="SmtpSenderName" value="Gin Rummy" />
  <!-- For Gmail, an app password of the sender account, not the password used to open the mailbox. -->
  <add key="SmtpSenderPassword" value="" />
  <!-- Below the 30 second sendTimeout of the RequestReplyTcp binding (QAS-12). -->
  <add key="SmtpTimeoutSeconds" value="15" />
</appSettings>