# Every text file keeps CRLF line endings in the working copy of each member, whatever their system.
# Git therefore never converts them on its own.
* text=auto eol=crlf
*.cs text eol=crlf
*.xaml text eol=crlf
*.config text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf
*.resx text eol=crlf
*.sql text eol=crlf

*.png binary
*.jpg binary
*.ico binary
*.ttf binary
